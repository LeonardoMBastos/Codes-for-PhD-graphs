set bgColor white

# ============================================================
# LIMPAR VISUALIZAÇÃO
# ============================================================

hide #1-4 atoms
hide #1-4 bonds
hide #1-4 cartoons
surface close #1-4

graphics silhouettes false


# ============================================================
# #1 = RECEPTOR BASE
# estilo fantasma, mas VISÍVEL
# ============================================================

show #1 cartoons
color #1 #C8C8C8 cartoons
transparency #1 45 target c

surface #1
surface style #1 solid
color #1 #D0D0D0 surfaces
transparency #1 65 target s


# ============================================================
# #2 = alpha1
# azul pastel
# ============================================================

show #2 cartoons
color #2 #C9D7F0 cartoons
transparency #2 0 target c


# ============================================================
# #3 = beta2
# verde pastel
# ============================================================

show #3 cartoons
color #3 #CFE3C2 cartoons
transparency #3 0 target c


# ============================================================
# #4 = gamma2
# lilás pastel
# ============================================================

show #4 cartoons
color #4 #D9D2F0 cartoons
transparency #4 0 target c


# ============================================================
# ILUMINAÇÃO
# ============================================================

lighting soft

# contorno muito discreto ajuda o receptor fantasma a aparecer
graphics silhouettes true
graphics silhouettes width 1
graphics silhouettes color #AFAFAF


# ============================================================
# ENQUADRAMENTO
# ============================================================

view all
zoom 1.15

turn y 15
turn x -8

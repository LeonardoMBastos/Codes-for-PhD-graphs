        # ==============================================================

        print(
            "\n[8/8] Registrando resultados"
        )


        results.append(

            {

                "compound":
                    original_name,

                "formula":
                    prepared_formula,

                "isomeric_SMILES":
                    prepared_smiles,

                "input_had_3D":
                    had_3d,

                "preoptimization":
                    preoptimization_method,

                "geometry":
                    geometry_source,

                "DFT_method":
                    METHOD,

                "basis_set":
                    BASIS,

                "charge":
                    CHARGE,

                "multiplicity":
                    SPIN + 1,

                "number_atoms":
                    mol_final.natm,

                "number_electrons":
                    mol_final.nelectron,

                "total_energy_Hartree":
                    total_energy,

                "HOMO_orbital":
                    homo_idx + 1,

                "LUMO_orbital":
                    lumo_idx + 1,

                "HOMO_Hartree":
                    homo_hartree,

                "LUMO_Hartree":
                    lumo_hartree,

                "HOMO_eV":
                    homo_ev,

                "LUMO_eV":
                    lumo_ev,

                "HOMO_LUMO_gap_Hartree":
                    gap_hartree,

                "HOMO_LUMO_gap_eV":
                    gap_ev

            }

        )


        preview_files.append(

            {

                "compound":
                    original_name,

                "sdf":
                    final_sdf,

                "homo":
                    homo_cube,

                "lumo":
                    lumo_cube

            }

        )


        print(
            f"\n✓ {original_name} concluído."
        )


    except Exception as exc:


        print("\n")

        print("!" * 72)

        print(

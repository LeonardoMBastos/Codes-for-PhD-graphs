def rdkit_to_pyscf_atoms(mol):

    """
    Extrai coordenadas do RDKit para PySCF.
    """

    conf = mol.GetConformer()

    atoms = []


    for atom in mol.GetAtoms():

        i = atom.GetIdx()

        p = conf.GetAtomPosition(i)


        atoms.append(

            (

                atom.GetSymbol(),

                (
                    float(p.x),
                    float(p.y),
                    float(p.z)
                )

            )

        )


    return atoms


# ----------------------------------------------------------------------


def save_rdkit_sdf(
    mol,
    path
):

    writer = Chem.SDWriter(
        str(path)
    )

    writer.write(
        mol
    )

    writer.close()


# ----------------------------------------------------------------------


def update_rdkit_coordinates(
    mol,
    pyscf_mol
):

    """
    Copia coordenadas DFT para uma cópia
    do RDKit, preservando conectividade,
    ordens de ligação e estereoquímica.
    """

    out = Chem.Mol(
        mol
    )


    coords = pyscf_mol.atom_coords(
        unit="Angstrom"
    )


    if out.GetNumAtoms() != len(coords):

        raise RuntimeError(
            "Número de átomos mudou durante o DFT."
        )


    if out.GetNumConformers() == 0:

        conf = Chem.Conformer(
            out.GetNumAtoms()
        )

        out.AddConformer(
            conf
        )


    conf = out.GetConformer()


    for i, xyz in enumerate(coords):

        conf.SetAtomPosition(

            i,

            Point3D(

                float(xyz[0]),

                float(xyz[1]),

                float(xyz[2])

            )

        )


    return out


# ----------------------------------------------------------------------


def write_xyz(
    mol,
    filename,
    comment
):

    coords = mol.atom_coords(
        unit="Angstrom"
    )


    with open(
        filename,
        "w"
    ) as f:


        f.write(
            f"{mol.natm}\n"
        )

        f.write(
            f"{comment}\n"
        )


        for i in range(
            mol.natm
        ):

            symbol = mol.atom_symbol(i)

            x, y, z = coords[i]


            f.write(

                f"{symbol:3s} "

                f"{x:16.8f} "

                f"{y:16.8f} "

                f"{z:16.8f}\n"

            )


# ----------------------------------------------------------------------


def build_rks(
    mol,
    chkfile=None
):

    mf = dft.RKS(
        mol
    )


    mf.xc = METHOD.lower()

    mf.grids.level = (
        DFT_GRID_LEVEL
    )

    mf.conv_tol = 1e-8

    mf.max_cycle = (
        SCF_MAX_CYCLES
    )


    if chkfile is not None:

        mf.chkfile = str(
            chkfile
        )


    return mf


# ----------------------------------------------------------------------


def run_scf_robust(
    mol,
    chkfile=None
):

    mf = build_rks(
        mol,
        chkfile
    )


    energy = mf.kernel()


    if not mf.converged:

        print(
            "\n      SCF convencional não convergiu."
        )

        print(
            "      Tentando Newton solver..."
        )


        mf = mf.newton()

        mf.max_cycle = (
            SCF_MAX_CYCLES
        )


        energy = mf.kernel()


    if not mf.converged:

        raise RuntimeError(
            "SCF não convergiu."
        )


    return mf, energy



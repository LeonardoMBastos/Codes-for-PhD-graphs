def sanitize_name(name):

    return re.sub(
        r"[^A-Za-z0-9_.-]",
        "_",
        name
    )


# ----------------------------------------------------------------------


def identify_expected_formula(name):

    name = name.lower()

    for key, formula in EXPECTED_FORMULAS.items():

        if key in name:

            return formula

    return None


# ----------------------------------------------------------------------


def load_sdf(file_path):

    """
    Lê a primeira molécula válida do SDF.
    """

    supplier = Chem.SDMolSupplier(
        str(file_path),
        removeHs=False,
        sanitize=True
    )

    valid = [
        mol
        for mol in supplier
        if mol is not None
    ]


    if len(valid) == 0:

        raise RuntimeError(
            f"Nenhuma molécula válida encontrada em {file_path.name}"
        )


    if len(valid) > 1:

        print(
            f"ATENÇÃO: {file_path.name} contém "
            f"{len(valid)} moléculas."
        )

        print(
            "Será utilizada apenas a primeira molécula."
        )


    return valid[0]


# ----------------------------------------------------------------------


def has_real_3d_coordinates(mol):

    """
    Verifica se há conformer e se as coordenadas
    parecem realmente tridimensionais.

    SDF 2D normalmente possui todos os Z ~= 0.
    """

    if mol.GetNumConformers() == 0:

        return False


    conf = mol.GetConformer()


    coords = []

    for i in range(
        mol.GetNumAtoms()
    ):

        p = conf.GetAtomPosition(i)

        coords.append(
            [
                p.x,
                p.y,
                p.z
            ]
        )


    coords = np.asarray(coords)


    if not np.all(
        np.isfinite(coords)
    ):

        return False


    # estrutura totalmente plana:
    # provavelmente SDF 2D
    z_range = np.ptp(
        coords[:, 2]
    )


    if z_range < 1e-3:

        return False


    return True


# ----------------------------------------------------------------------


def prepare_rdkit_molecule(mol):

    """
    1. Sanitiza
    2. Adiciona H explícitos
    3. Mantém coordenadas 3D existentes quando disponíveis
    4. Gera conformação 3D se necessário
    5. MMFF94
    """

    Chem.SanitizeMol(
        mol
    )


    had_3d = has_real_3d_coordinates(
        mol
    )


    # adicionar H preservando coordenadas existentes
    molH = Chem.AddHs(
        mol,
        addCoords=True
    )


    if not had_3d:

        print(
            "      SDF sem geometria 3D válida."
        )

        print(
            "      Gerando conformação 3D com ETKDGv3..."
        )


        # remover conformers 2D antes do embedding
        molH.RemoveAllConformers()


        params = (
            AllChem.ETKDGv3()
        )

        params.randomSeed = 2026

        params.useRandomCoords = False


        status = AllChem.EmbedMolecule(
            molH,
            params
        )


        if status != 0:

            print(
                "      ETKDG convencional falhou."
            )

            print(
                "      Tentando com coordenadas aleatórias..."
            )


            params.useRandomCoords = True


            status = AllChem.EmbedMolecule(
                molH,
                params
            )


        if status != 0:

            raise RuntimeError(
                "Não foi possível gerar uma "
                "conformação 3D."
            )

    else:

        print(
            "      Coordenadas 3D encontradas no SDF."
        )

        print(
            "      Geometria original será usada "
            "como ponto de partida."
        )


    # ----------------------------------------------------------
    # MMFF94
    # ----------------------------------------------------------

    if AllChem.MMFFHasAllMoleculeParams(
        molH
    ):

        print(
            "      Realizando minimização MMFF94..."
        )


        properties = (
            AllChem.MMFFGetMoleculeProperties(
                molH,
                mmffVariant="MMFF94"
            )
        )


        result = (
            AllChem.MMFFOptimizeMolecule(
                molH,
                mmffVariant="MMFF94",
                maxIters=MMFF_MAX_ITERS
            )
        )


        if result == 0:

            print(
                "      ✓ MMFF94 convergiu."
            )

        elif result == 1:

            print(
                "      ATENÇÃO: MMFF94 atingiu "
                "o número máximo de iterações."
            )

        else:

            print(
                "      ATENÇÃO: status MMFF94:",
                result
            )


        preoptimization = "MMFF94"


    else:

        print(
            "      MMFF94 não possui parâmetros "
            "para todos os átomos."
        )

        print(
            "      Utilizando UFF..."
        )


        result = AllChem.UFFOptimizeMolecule(
            molH,
            maxIters=MMFF_MAX_ITERS
        )


        preoptimization = "UFF"


    return (
        molH,
        had_3d,
        preoptimization
    )



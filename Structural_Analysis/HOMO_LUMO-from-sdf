        )


        print(
            f"      Isomeric SMILES: "
            f"{smiles_original}"
        )


        # ==============================================================
        # 8.2 ADICIONAR H + 3D + MMFF94
        # ==============================================================

        print(
            "\n[2/8] Preparação estrutural"
        )


        (
            molH,
            had_3d,
            preoptimization_method

        ) = prepare_rdkit_molecule(
            mol_original
        )


        prepared_formula = (
            rdMolDescriptors.CalcMolFormula(
                molH
            )
        )


        prepared_smiles = (
            Chem.MolToSmiles(
                Chem.RemoveHs(molH),
                isomericSmiles=True
            )
        )


        print(
            f"\n      Fórmula após adição de H: "
            f"{prepared_formula}"
        )


        print(
            f"      SMILES preparado: "
            f"{prepared_smiles}"
        )


        # ==============================================================
        # 8.3 VALIDAÇÃO LIN / NER
        # ==============================================================

        print(
            "\n[3/8] Validação química"
        )


        expected_formula = (
            identify_expected_formula(
                original_name
            )
        )


        if expected_formula is not None:


            print(
                f"      Fórmula esperada: "
                f"{expected_formula}"
            )


            if prepared_formula != expected_formula:

                raise RuntimeError(

                    f"\nERRO DE VALIDAÇÃO:\n"
                    f"Molécula: {original_name}\n"
                    f"Esperado: {expected_formula}\n"
                    f"Detectado: {prepared_formula}\n\n"
                    f"O cálculo DFT foi bloqueado."

                )


            print(
                "      ✓ Fórmula molecular validada."
            )


        else:

            print(
                "      Nome não reconhecido automaticamente "
                "como LIN ou NER."
            )

            print(
                "      Prosseguindo sem validação específica "
                "de fórmula."
            )


        # salvar estrutura preparada
        prepared_sdf = (

            compound_dir /

            f"{compound}_MMFF94.sdf"

        )


        save_rdkit_sdf(
            molH,
            prepared_sdf
        )


        # ==============================================================
        # 8.4 RDKit -> PySCF
        # ==============================================================

        print(
            "\n[4/8] Preparando cálculo quântico"
        )


        atoms = rdkit_to_pyscf_atoms(
            molH
        )


        mol = gto.M(

            atom=atoms,

            basis=BASIS,

            charge=CHARGE,

            spin=SPIN,

            unit="Angstrom",

            verbose=3

        )


        print(
            f"\n      Átomos: "
            f"{mol.natm}"
        )


        print(
            f"      Elétrons: "
            f"{mol.nelectron}"
        )


        print(
            f"      Carga: "
            f"{CHARGE}"
        )


        print(
            f"      Multiplicidade: "
            f"{SPIN + 1}"
        )


        # elétrons pares para singlet
        if (
            mol.nelectron % 2 != 0
            and
            SPIN == 0
        ):

            raise RuntimeError(

                f"{compound}: "
                f"{mol.nelectron} elétrons encontrados "
                "para SPIN = 0."

            )


        if expected_formula is not None:


            expected_e = (
                EXPECTED_ELECTRONS[
                    expected_formula
                ]
            )


            print(
                f"      Elétrons esperados: "
                f"{expected_e}"
            )


            if mol.nelectron != expected_e:

                raise RuntimeError(

                    f"{compound}: número de elétrons "
                    f"incorreto.\n"
                    f"Esperado: {expected_e}\n"
                    f"Detectado: {mol.nelectron}"

                )


            print(
                "      ✓ Número de elétrons validado."
            )


        # ==============================================================
        # 8.5 DFT GEOMETRY OPTIMIZATION
        # ==============================================================

        if RUN_DFT_GEOM_OPT:


            print(
                "\n[5/8] Otimização geométrica DFT"
            )


            print(
                f"      {METHOD}/{BASIS}"
            )


            print(
                "      Esta é normalmente a etapa "
                "mais demorada."
            )


            mf_opt = build_rks(
                mol
            )


            optimized_mol = optimize(

                mf_opt,

                maxsteps=GEOM_MAX_STEPS

            )


            mol_final = optimized_mol


            geometry_source = (

                f"{preoptimization_method} + "
                f"{METHOD}/{BASIS} "
                "geometry optimization"

            )


            print(
                "\n      ✓ Otimização DFT concluída."
            )


        else:


            print(
                "\n[5/8] Otimização DFT desativada."
            )


            mol_final = mol


            geometry_source = (
                preoptimization_method
            )


        # ==============================================================
        # SALVAR ESTRUTURA FINAL
        # ==============================================================

        final_xyz = (

            compound_dir /

            f"{compound}_DFTopt.xyz"

        )


        write_xyz(

            mol_final,

            final_xyz,

            geometry_source

        )


        final_rdkit = (
            update_rdkit_coordinates(
                molH,
                mol_final
            )
        )


        final_sdf = (

            compound_dir /

            f"{compound}_DFTopt.sdf"

        )


        save_rdkit_sdf(

            final_rdkit,

            final_sdf

        )


        # ==============================================================
        # 8.6 SINGLE POINT
        # ==============================================================

        print(
            "\n[6/8] Single-point DFT final"
        )


        print(
            f"      {METHOD}/{BASIS}"
        )


        chkfile = (

            compound_dir /

            f"{compound}.chk"

        )


        (
            mf_final,
            total_energy

        ) = run_scf_robust(

            mol_final,

            chkfile=chkfile

        )


        # ==============================================================
        # HOMO / LUMO
        # ==============================================================

        occupations = np.asarray(
            mf_final.mo_occ
        )


        energies = np.asarray(
            mf_final.mo_energy
        )


        occupied = np.where(
            occupations > 0
        )[0]


        virtual = np.where(
            occupations == 0
        )[0]


        homo_idx = occupied[-1]


        virtual_after_homo = virtual[
            virtual > homo_idx
        ]


        if len(
            virtual_after_homo
        ) == 0:

            raise RuntimeError(
                "LUMO não encontrado."
            )


        lumo_idx = (
            virtual_after_homo[0]
        )


        homo_hartree = float(
            energies[homo_idx]
        )


        lumo_hartree = float(
            energies[lumo_idx]
        )


        homo_ev = (
            homo_hartree *
            HARTREE_TO_EV
        )


        lumo_ev = (
            lumo_hartree *
            HARTREE_TO_EV
        )


        gap_hartree = (
            lumo_hartree -
            homo_hartree
        )


        gap_ev = (
            gap_hartree *
            HARTREE_TO_EV
        )


        print("\n")

        print("-" * 58)


        print(
            f"HOMO orbital #: "
            f"{homo_idx + 1}"
        )


        print(
            f"LUMO orbital #: "
            f"{lumo_idx + 1}"
        )


        print(
            f"HOMO = "
            f"{homo_hartree:.8f} Hartree "
            f"= {homo_ev:.4f} eV"
        )


        print(
            f"LUMO = "
            f"{lumo_hartree:.8f} Hartree "
            f"= {lumo_ev:.4f} eV"
        )


        print(
            f"HOMO-LUMO gap = "
            f"{gap_ev:.4f} eV"
        )


        print("-" * 58)


        # ==============================================================
        # 8.7 CUBES
        # ==============================================================

        print(
            "\n[7/8] Gerando arquivos CUBE"
        )


        homo_cube = (

            compound_dir /

            f"{compound}_HOMO.cube"

        )


        lumo_cube = (

            compound_dir /

            f"{compound}_LUMO.cube"

        )


        cubegen.orbital(

            mol_final,

            str(homo_cube),

            mf_final.mo_coeff[
                :,
                homo_idx
            ],

            nx=CUBE_GRID,

            ny=CUBE_GRID,

            nz=CUBE_GRID

        )


        cubegen.orbital(

            mol_final,

            str(lumo_cube),

            mf_final.mo_coeff[
                :,
                lumo_idx
            ],

            nx=CUBE_GRID,

            ny=CUBE_GRID,

            nz=CUBE_GRID

        )


        print(
            f"      ✓ {homo_cube.name}"
        )


        print(
            f"      ✓ {lumo_cube.name}"
        )


        # ==============================================================

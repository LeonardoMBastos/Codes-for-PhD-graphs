HARTREE_TO_EV = 27.211386245988


def sanitize_name(name):
    """
    Remove caracteres problemáticos de nomes de arquivos.
    """
    return re.sub(r"[^A-Za-z0-9_.-]", "_", name)


def run_command(cmd):
    """
    Executa comando externo e retorna stdout/stderr.
    """

    result = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True
    )

    if result.returncode != 0:

        print("\nERRO AO EXECUTAR:")
        print(" ".join(cmd))

        print("\nSTDOUT:")
        print(result.stdout)

        print("\nSTDERR:")
        print(result.stderr)

        raise RuntimeError(
            "Falha ao executar comando externo."
        )

    return result


def read_xyz(xyz_file):
    """
    Lê XYZ e retorna lista compatível com PySCF.
    """

    with open(xyz_file, "r") as f:
        lines = f.readlines()

    natoms = int(lines[0].strip())

    atoms = []

    for line in lines[2:2 + natoms]:

        parts = line.split()

        if len(parts) < 4:
            continue

        symbol = parts[0]

        x = float(parts[1])
        y = float(parts[2])
        z = float(parts[3])

        atoms.append(
            (
                symbol,
                (x, y, z)
            )
        )

    return atoms


def write_xyz(mol, filename, comment="DFT optimized structure"):
    """
    Escreve estrutura PySCF como XYZ em Angstrom.
    """

    coords = mol.atom_coords(unit="Angstrom")

    with open(filename, "w") as f:

        f.write(f"{mol.natm}\n")
        f.write(comment + "\n")

        for i in range(mol.natm):

            symbol = mol.atom_symbol(i)

            x, y, z = coords[i]

            f.write(
                f"{symbol:3s} "
                f"{x:16.8f} "
                f"{y:16.8f} "
                f"{z:16.8f}\n"
            )


def build_rks(mol, chkfile=None):
    """
    Cria objeto DFT/RKS com configurações padronizadas.
    """

    mf = dft.RKS(mol)

    mf.xc = METHOD.lower()

    mf.grids.level = DFT_GRID_LEVEL

    mf.conv_tol = 1e-8

    mf.max_cycle = SCF_MAX_CYCLES

    if chkfile is not None:
        mf.chkfile = str(chkfile)

    return mf


def run_scf_robust(mol, chkfile=None):
    """
    Executa SCF.
    Se o SCF convencional não convergir,
    tenta Newton-Raphson.
    """

    mf = build_rks(
        mol,
        chkfile=chkfile
    )

    energy = mf.kernel()

    if not mf.converged:

        print(
            "SCF convencional não convergiu. "
            "Tentando Newton solver..."
        )

        mf = mf.newton()

        mf.max_cycle = SCF_MAX_CYCLES

        energy = mf.kernel()

    if not mf.converged:

        raise RuntimeError(
            "SCF não convergiu mesmo após Newton solver."
        )

    return mf, energy


def preview_orbital(
    sdf_file,
    cube_file,
    title,
    isovalue=0.03
):
    """
    Mostra HOMO/LUMO interativamente no Google Colab.

    Verde = fase positiva de psi
    Vermelho = fase negativa de psi

    IMPORTANTE:
    Essas cores NÃO representam carga positiva/negativa.
    """

    if not SHOW_PREVIEW:
        return

    try:

        with open(sdf_file, "r") as f:
            sdf_data = f.read()

        with open(cube_file, "r") as f:
            cube_data = f.read()

        display(
            HTML(
                f"""
                <h3 style="font-family:Arial">
                {title}
                </h3>
                """
            )
        )

        view = py3Dmol.view(
            width=700,
            height=500
        )

        view.addModel(
            sdf_data,
            "sdf"
        )

        view.setStyle(
            {
                "stick": {
                    "radius": 0.12
                },
                "sphere": {
                    "scale": 0.20
                }
            }
        )

        # Fase positiva
        view.addVolumetricData(
            cube_data,
            "cube",
            {
                "isoval": float(isovalue),
                "color": "green",
                "opacity": 0.70
            }
        )

        # Fase negativa
        view.addVolumetricData(
            cube_data,
            "cube",
            {
                "isoval": -float(isovalue),
                "color": "red",
                "opacity": 0.70
            }
        )

        view.setBackgroundColor("white")

        view.zoomTo()

        view.show()

    except Exception as exc:

        print(
            f"Preview não pôde ser criado: {exc}"
        )



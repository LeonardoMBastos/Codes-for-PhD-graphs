# 7. PROCESSAMENTO DAS MOLÉCULAS
# ================================================================

results = []

generated_for_preview = []


for pdbqt_file in pdbqt_files:

    original_name = pdbqt_file.stem

    compound = sanitize_name(original_name)

    compound_dir = OUTPUT_DIR / compound

    compound_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    print("\n")
    print("=" * 70)
    print(f"PROCESSANDO: {original_name}")
    print("=" * 70)


    # ------------------------------------------------------------
    # 7.1 PDBQT -> SDF + H + MMFF94
    # ------------------------------------------------------------

    mmff_sdf = compound_dir / f"{compound}_MMFF94.sdf"

    print("\n[1/7] PDBQT -> SDF + hidrogênios + MMFF94")

    cmd_mmff = [
        "obabel",
        str(pdbqt_file),

        # Caso o PDBQT contenha múltiplos MODEL,
        # usa apenas a primeira estrutura.
        "-f", "1",
        "-l", "1",

        "-O",
        str(mmff_sdf),

        "-h",

        "--minimize",
        "--ff",
        "MMFF94",

        "--steps",
        str(MMFF_STEPS)
    ]

    mmff_ok = True

    try:

        run_command(cmd_mmff)

    except Exception:

        mmff_ok = False


    # ------------------------------------------------------------
    # Fallback para UFF, caso MMFF94 não reconheça atom types
    # ------------------------------------------------------------

    if not mmff_ok:

        print(
            "MMFF94 falhou. "
            "Tentando UFF como fallback..."
        )

        cmd_uff = [
            "obabel",
            str(pdbqt_file),
            "-f", "1",
            "-l", "1",
            "-O",
            str(mmff_sdf),
            "-h",
            "--minimize",
            "--ff",
            "UFF",
            "--steps",
            str(MMFF_STEPS)
        ]

        run_command(cmd_uff)

        preoptimization_method = "UFF"

    else:

        preoptimization_method = "MMFF94"


    # ------------------------------------------------------------
    # 7.2 SDF -> XYZ
    # ------------------------------------------------------------

    mmff_xyz = compound_dir / f"{compound}_MMFF94.xyz"

    print("[2/7] Convertendo estrutura pré-otimizada para XYZ")

    run_command(
        [
            "obabel",
            str(mmff_sdf),
            "-O",
            str(mmff_xyz)
        ]
    )


    # ------------------------------------------------------------
    # 7.3 Criar molécula PySCF
    # ------------------------------------------------------------

    print("[3/7] Preparando cálculo quântico")

    atoms = read_xyz(mmff_xyz)

    mol = gto.M(
        atom=atoms,
        basis=BASIS,
        charge=CHARGE,
        spin=SPIN,
        unit="Angstrom",
        verbose=3
    )

    print(
        f"   Átomos: {mol.natm}"
    )

    print(
        f"   Elétrons: {mol.nelectron}"
    )

    print(
        f"   Carga: {CHARGE}"
    )

    print(
        f"   Multiplicidade: {SPIN + 1}"
    )


    # Verificação simples
    if mol.nelectron % 2 != 0 and SPIN == 0:

        raise ValueError(
            f"{compound}: número ímpar de elétrons "
            "para cálculo closed-shell."
        )


    # ------------------------------------------------------------
    # 7.4 Otimização geométrica DFT
    # ------------------------------------------------------------

    geometry_source = preoptimization_method

    if RUN_DFT_GEOM_OPT:

        print("\n[4/7] Otimização geométrica DFT")
        print(
            f"      {METHOD}/{BASIS}"
        )

        try:

            mf_opt = build_rks(mol)

            # geomeTRIC usa as energias e gradientes do PySCF.
            optimized_mol = optimize(
                mf_opt,
                maxsteps=GEOM_MAX_STEPS
            )

            mol_final = optimized_mol

            geometry_source = (
                f"{preoptimization_method} + "
                f"{METHOD}/{BASIS} geometry optimization"
            )

            print(
                "      Otimização geométrica concluída."
            )

        except Exception as exc:

            print("\nATENÇÃO:")
            print(
                "Otimização geométrica DFT não foi concluída."
            )

            print(
                f"Motivo: {exc}"
            )

            print(
                "O cálculo continuará utilizando "
                f"a geometria {preoptimization_method}."
            )

            mol_final = mol

    else:

        print("\n[4/7] Otimização DFT DESATIVADA")
        print(
            f"      Utilizando geometria {preoptimization_method}."
        )

        mol_final = mol


    # ------------------------------------------------------------
    # 7.5 Salvar geometria final
    # ------------------------------------------------------------

    opt_xyz = compound_dir / f"{compound}_DFTopt.xyz"

    write_xyz(
        mol_final,
        opt_xyz,
        comment=geometry_source
    )

    opt_sdf = compound_dir / f"{compound}_DFTopt.sdf"

    run_command(
        [
            "obabel",
            str(opt_xyz),
            "-O",
            str(opt_sdf)
        ]
    )


    # ------------------------------------------------------------
    # 7.6 Single-point DFT FINAL
    # ------------------------------------------------------------

    print("\n[5/7] Single-point DFT final")
    print(
        f"      {METHOD}/{BASIS}"
    )

    chkfile = compound_dir / f"{compound}.chk"

    mf_final, total_energy = run_scf_robust(
        mol_final,
        chkfile=chkfile
    )


    # ------------------------------------------------------------
    # Identificar HOMO e LUMO
    # ------------------------------------------------------------

    occupations = np.asarray(
        mf_final.mo_occ
    )

    energies = np.asarray(
        mf_final.mo_energy
    )

    occupied_indices = np.where(
        occupations > 0
    )[0]

    virtual_indices = np.where(
        occupations == 0
    )[0]


    if len(occupied_indices) == 0:
        raise RuntimeError(
            "Nenhum orbital ocupado encontrado."
        )

    if len(virtual_indices) == 0:
        raise RuntimeError(
            "Nenhum orbital virtual encontrado."
        )


    homo_idx = occupied_indices[-1]

    lumo_candidates = virtual_indices[
        virtual_indices > homo_idx
    ]

    if len(lumo_candidates) == 0:
        raise RuntimeError(
            "Não foi possível localizar LUMO."
        )

    lumo_idx = lumo_candidates[0]


    homo_hartree = float(
        energies[homo_idx]
    )

    lumo_hartree = float(
        energies[lumo_idx]
    )


    homo_ev = (
        homo_hartree *
        HARTREE_TO_EV
    )

    lumo_ev = (
        lumo_hartree *
        HARTREE_TO_EV
    )

    gap_hartree = (
        lumo_hartree -
        homo_hartree
    )

    gap_ev = (
        gap_hartree *
        HARTREE_TO_EV
    )


    print("\n" + "-" * 50)

    print(
        f"HOMO orbital #: {homo_idx + 1}"
    )

    print(
        f"LUMO orbital #: {lumo_idx + 1}"
    )

    print(
        f"HOMO = {homo_hartree:.8f} Hartree "
        f"= {homo_ev:.4f} eV"
    )

    print(
        f"LUMO = {lumo_hartree:.8f} Hartree "
        f"= {lumo_ev:.4f} eV"
    )

    print(
        f"HOMO-LUMO gap = {gap_ev:.4f} eV"
    )

    print("-" * 50)


    # ------------------------------------------------------------
    # 7.7 Criar arquivos CUBE
    # ------------------------------------------------------------

    print("\n[6/7] Gerando arquivos .cube")

    homo_cube = (
        compound_dir /
        f"{compound}_HOMO.cube"
    )

    lumo_cube = (
        compound_dir /
        f"{compound}_LUMO.cube"
    )


    cubegen.orbital(
        mol_final,
        str(homo_cube),
        mf_final.mo_coeff[:, homo_idx],
        nx=CUBE_GRID,
        ny=CUBE_GRID,
        nz=CUBE_GRID
    )


    cubegen.orbital(
        mol_final,
        str(lumo_cube),
        mf_final.mo_coeff[:, lumo_idx],
        nx=CUBE_GRID,
        ny=CUBE_GRID,
        nz=CUBE_GRID
    )


    print(
        f"      HOMO: {homo_cube.name}"
    )

    print(
        f"      LUMO: {lumo_cube.name}"
    )


    # ------------------------------------------------------------
    # Registrar resultados
    # ------------------------------------------------------------

    results.append(
        {
            "compound": original_name,

            "preoptimization": preoptimization_method,

            "geometry": geometry_source,

            "DFT_method": METHOD,

            "basis_set": BASIS,

            "charge": CHARGE,

            "multiplicity": SPIN + 1,

            "number_atoms": mol_final.natm,

            "number_electrons": mol_final.nelectron,

            "total_energy_Hartree": total_energy,

            "HOMO_orbital": homo_idx + 1,

            "LUMO_orbital": lumo_idx + 1,

            "HOMO_Hartree": homo_hartree,

            "LUMO_Hartree": lumo_hartree,

            "HOMO_eV": homo_ev,

            "LUMO_eV": lumo_ev,

            "HOMO_LUMO_gap_Hartree": gap_hartree,

            "HOMO_LUMO_gap_eV": gap_ev,

            "HOMO_cube": homo_cube.name,

            "LUMO_cube": lumo_cube.name
        }
    )


    generated_for_preview.append(
        {
            "compound": original_name,
            "sdf": opt_sdf,
            "homo": homo_cube,
            "lumo": lumo_cube
        }
    )


    print("\n[7/7] Concluído:")
    print(f"      {original_name}")



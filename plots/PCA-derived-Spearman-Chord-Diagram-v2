safe_num <- function(x) {

  suppressWarnings(
    as.numeric(
      gsub(
        ",",
        ".",
        as.character(x),
        fixed = TRUE
      )
    )
  )
}


normalize_site <- function(x) {

  y <- toupper(
    trimws(
      as.character(x)
    )
  )


  y[
    y %in% c(
      "BZD",
      "BENZODIAZEPINE",
      "BENZODIAZEPINES",
      "BENZODIAZEPINE SITE",
      "BZD SITE"
    )
  ] <- "BZD"


  y[
    y %in% c(
      "BB",
      "BARBITURATE",
      "BARBITURATES",
      "BARBITURATE SITE",
      "BARBITURATES SITE"
    )
  ] <- "BB"


  y[
    y %in% c(
      "GABA",
      "GABA SITE",
      "ORTHOSTERIC",
      "ORTHOSTERIC SITE"
    )
  ] <- "GABA"


  y
}


normalize_residue <- function(x) {

  toupper(
    gsub(
      "\\s+",
      "",
      trimws(
        as.character(x)
      )
    )
  )
}


get_pc_columns <- function(df) {

  pcs <- grep(
    "^PC[0-9]+$",
    names(df),
    value = TRUE
  )


  pcs[
    order(
      as.integer(
        sub(
          "^PC",
          "",
          pcs
        )
      )
    )
  ]
}


get_variance_percent <- function(
    variance_df,
    site_name,
    pc_name
) {

  idx <- which(
    variance_df$site == site_name &
      variance_df$PC == pc_name
  )


  if (length(idx) == 0) {

    return(
      NA_real_
    )
  }


  safe_num(
    variance_df$variance_percent[
      idx[1]
    ]
  )
}



# ==============================================================================
# 9. PARSE TOP RESIDUES
# ==============================================================================

parse_top_residues <- function(x) {

  result <- numeric(0)


  if (
    is.na(x) ||
    trimws(x) == ""
  ) {

    return(
      result
    )
  }


  pieces <- strsplit(
    as.character(x),
    ";",
    fixed = TRUE
  )[[1]]


  for (piece in pieces) {

    piece <- trimws(
      piece
    )


    matched <- regexec(
      "^([^[:space:]]+)\\s*\\(([0-9]+(?:\\.[0-9]+)?)\\)$",
      piece
    )


    captured <- regmatches(
      piece,
      matched
    )[[1]]


    if (length(captured) == 3) {

      residue_name <- normalize_residue(
        captured[2]
      )


      contact_value <- safe_num(
        captured[3]
      )


      if (
        is.finite(contact_value) &&
        contact_value > 0
      ) {

        if (residue_name %in% names(result)) {

          result[residue_name] <-
            result[residue_name] +
            contact_value

        } else {

          result[residue_name] <-
            contact_value
        }
      }
    }
  }


  result
}


# ==============================================================================
# 10. BUILD ORIGINAL POSE × RESIDUE MATRIX
# ==============================================================================

build_raw_fingerprint <- function(
    site_name
) {


  raw_site <- raw_data[
    raw_data$site == site_name,
    ,
    drop = FALSE
  ]


  if (nrow(raw_site) == 0) {

    stop(
      paste0(
        "No raw observations found for site: ",
        site_name
      ),
      call. = FALSE
    )
  }


  parsed_rows <- lapply(
    raw_site$`Top residues`,
    parse_top_residues
  )


  all_raw_residues <- sort(
    unique(
      unlist(
        lapply(
          parsed_rows,
          names
        )
      )
    )
  )


  if (length(all_raw_residues) == 0) {

    stop(
      paste0(
        "No residues could be parsed from 'Top residues' for ",
        site_name
      ),
      call. = FALSE
    )
  }


  X <- matrix(

    0,

    nrow =
      nrow(raw_site),

    ncol =
      length(all_raw_residues),

    dimnames = list(
      NULL,
      all_raw_residues
    )
  )


  for (
    i in seq_along(
      parsed_rows
    )
  ) {

    current <- parsed_rows[[i]]


    if (length(current) == 0) {

      next
    }


    X[
      i,
      names(current)
    ] <- current
  }


  pca_residues <- loadings_all$residue[
    loadings_all$site == site_name
  ]


  common_residues <- intersect(
    colnames(X),
    pca_residues
  )


  missing_from_pca <- setdiff(
    colnames(X),
    pca_residues
  )


  if (length(common_residues) == 0) {

    stop(
      paste0(
        "ERROR: no raw residues matched PCA loadings for ",
        site_name,
        "."
      ),
      call. = FALSE
    )
  }


  if (length(missing_from_pca) > 0) {

    warning(
      paste0(
        site_name,
        ": ",
        length(missing_from_pca),
        " raw residue(s) are absent from PCA loadings and will be ignored."
      )
    )
  }


  X <- X[
    ,
    common_residues,
    drop = FALSE
  ]


  if (sum(X, na.rm = TRUE) <= 0) {

    stop(
      paste0(
        "ERROR: reconstructed contact matrix for ",
        site_name,
        " contains no contacts."
      ),
      call. = FALSE
    )
  }


  X
}


# ==============================================================================
# 11. HELLINGER TRANSFORMATION
# ==============================================================================

hellinger_transform <- function(X) {

  row_totals <- rowSums(
    X,
    na.rm = TRUE
  )


  if (any(row_totals <= 0)) {

    stop(
      "At least one pose has total residue-contact count <= 0.",
      call. = FALSE
    )
  }


  relative_matrix <- X /
    row_totals


  sqrt(
    relative_matrix
  )
}


# ==============================================================================
# 12. RESIDUE FREQUENCY
# ==============================================================================

calculate_residue_frequency <- function(
    site_name,
    X_raw
) {


  frequency_n <- colSums(
    X_raw > 0
  )


  frequency_percent <-
    frequency_n /
    nrow(X_raw) *
    100


  total_contacts <- colSums(
    X_raw
  )


  result <- data.frame(

    site =
      site_name,

    residue =
      colnames(X_raw),

    n_poses =
      nrow(X_raw),

    frequency_n =
      as.numeric(
        frequency_n
      ),

    frequency_percent =
      as.numeric(
        frequency_percent
      ),

    total_contacts =
      as.numeric(
        total_contacts
      ),

    stringsAsFactors =
      FALSE
  )


  result <- result[
    order(
      -result$frequency_n,
      -result$total_contacts,
      result$residue
    ),
    ,
    drop = FALSE
  ]


  result$frequency_rank <-
    seq_len(
      nrow(result)
    )


  top <- head(
    result,
    min(
      top_n_residues,
      nrow(result)
    )
  )


  list(
    all = result,
    top = top
  )
}


# ==============================================================================
# 13. PCA NODE DATA
# ==============================================================================

calculate_nodes <- function(
    site_name,
    selected_residues,
    frequency_table
) {


  load_site <- loadings_all[
    loadings_all$site == site_name,
    ,
    drop = FALSE
  ]


  idx <- match(
    selected_residues,
    load_site$residue
  )


  if (any(is.na(idx))) {

    stop(
      paste0(
        "Selected residue missing from PCA loadings for ",
        site_name
      ),
      call. = FALSE
    )
  }


  pc1 <- safe_num(
    load_site$PC1[
      idx
    ]
  )


  pc2 <- safe_num(
    load_site$PC2[
      idx
    ]
  )


  all_pc1 <- safe_num(
    load_site$PC1
  )


  all_pc2 <- safe_num(
    load_site$PC2
  )


  den1 <- sum(
    all_pc1^2,
    na.rm = TRUE
  )


  den2 <- sum(
    all_pc2^2,
    na.rm = TRUE
  )


  nodes <- data.frame(

    site =
      site_name,

    residue =
      selected_residues,

    PC1_loading =
      pc1,

    PC2_loading =
      pc2,

    PC1_contribution_percent =
      (pc1^2 / den1) *
      100,

    PC2_contribution_percent =
      (pc2^2 / den2) *
      100,

    stringsAsFactors =
      FALSE
  )


  freq_idx <- match(
    nodes$residue,
    frequency_table$residue
  )


  nodes$frequency_rank <-
    frequency_table$frequency_rank[
      freq_idx
    ]


  nodes$frequency_n <-
    frequency_table$frequency_n[
      freq_idx
    ]


  nodes$frequency_percent <-
    frequency_table$frequency_percent[
      freq_idx
    ]


  nodes$total_contacts <-
    frequency_table$total_contacts[
      freq_idx
    ]


  nodes
}


# ==============================================================================
# 14. SPEARMAN ANALYSIS
# ==============================================================================

calculate_site_analysis <- function(
    site_name
) {


  X_raw <- build_raw_fingerprint(
    site_name
  )


  frequency_result <- calculate_residue_frequency(
    site_name,
    X_raw
  )


  top_frequency <-
    frequency_result$top


  selected_residues <-
    top_frequency$residue


  X_hellinger <- hellinger_transform(
    X_raw
  )


  X_top <- X_hellinger[
    ,
    selected_residues,
    drop = FALSE
  ]


  pair_idx <- combn(
    seq_along(
      selected_residues
    ),
    2
  )


  results <- vector(
    "list",
    ncol(
      pair_idx
    )
  )


  for (
    k in seq_len(
      ncol(
        pair_idx
      )
    )
  ) {


    i <- pair_idx[
      1,
      k
    ]


    j <- pair_idx[
      2,
      k
    ]


    residue_1 <-
      selected_residues[i]


    residue_2 <-
      selected_residues[j]


    x <- X_top[
      ,
      i
    ]


    y <- X_top[
      ,
      j
    ]


    complete <- is.finite(x) &
      is.finite(y)


    x_complete <- x[
      complete
    ]


    y_complete <- y[
      complete
    ]


    n_pair <- length(
      x_complete
    )


    valid_test <-
      n_pair >= 3 &&
      length(
        unique(
          x_complete
        )
      ) >= 2 &&
      length(
        unique(
          y_complete
        )
      ) >= 2


    if (!valid_test) {

      rho <- NA_real_

      p <- NA_real_

    } else {

      test <- tryCatch(

        suppressWarnings(

          cor.test(
            x_complete,
            y_complete,
            method = "spearman",
            exact = FALSE
          )

        ),

        error = function(e) {

          NULL
        }
      )


      if (is.null(test)) {

        rho <- NA_real_

        p <- NA_real_

      } else {

        rho <- unname(
          test$estimate
        )


        p <- test$p.value
      }
    }


    results[[k]] <- data.frame(

      site =
        site_name,

      residue_1 =
        residue_1,

      residue_2 =
        residue_2,

      n =
        n_pair,

      spearman_rho =
        rho,

      spearman_abs =
        abs(rho),

      spearman_p =
        p,

      stringsAsFactors =
        FALSE
    )
  }


  edges <- do.call(
    rbind,
    results
  )


  edges$spearman_FDR <-
    NA_real_


  valid_p <- is.finite(
    edges$spearman_p
  )


  if (any(valid_p)) {

    edges$spearman_FDR[
      valid_p
    ] <- p.adjust(

      edges$spearman_p[
        valid_p
      ],

      method =
        "BH"
    )
  }


  nodes <- calculate_nodes(

    site_name =
      site_name,

    selected_residues =
      selected_residues,

    frequency_table =
      top_frequency
  )


  list(

    raw_matrix =
      X_raw,

    hellinger_matrix =
      X_hellinger,

    frequency_all =
      frequency_result$all,

    frequency_top =
      top_frequency,

    nodes =
      nodes,

    edges =
      edges
  )
}



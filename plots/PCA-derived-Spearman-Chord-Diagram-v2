safe_output_file <- function(
    directory,
    filename
) {

  candidate <- file.path(
    directory,
    filename
  )


  if (!file.exists(candidate)) {

    return(
      candidate
    )
  }


  deleted <- tryCatch(
    {

      unlink(
        candidate,
        force = TRUE
      )


      !file.exists(candidate)

    },

    error = function(e) {

      FALSE
    }
  )


  if (deleted) {

    return(
      candidate
    )
  }


  extension <- tools::file_ext(
    filename
  )


  base_name <- tools::file_path_sans_ext(
    basename(
      filename
    )
  )


  timestamp <- format(
    Sys.time(),
    "%Y%m%d_%H%M%S"
  )


  file.path(
    directory,
    paste0(
      base_name,
      "_",
      timestamp,
      ".",
      extension
    )
  )
}



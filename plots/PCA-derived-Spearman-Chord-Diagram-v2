prepare_site_plot <- function(
    site_name
) {


  edges_site <-
    analysis_results[[site_name]]$edges


  nodes_site <-
    analysis_results[[site_name]]$nodes


  edges_plot <- edges_site[

    is.finite(
      edges_site$spearman_rho
    ) &

      is.finite(
        edges_site$spearman_FDR
      ) &

      edges_site$spearman_FDR <=
        maximum_FDR &

      edges_site$spearman_abs >=
        min_abs_correlation,

    ,

    drop = FALSE
  ]


  nodes_plot <- nodes_site[

    order(
      -nodes_site$PC1_loading,
      nodes_site$residue
    ),

    ,

    drop = FALSE
  ]


  residue_order <-
    nodes_plot$residue


  if (nrow(edges_plot) > 0) {

    edges_plot$link_colour <-
      correlation_col_fun(
        edges_plot$spearman_rho
      )

  } else {

    edges_plot$link_colour <-
      character(0)
  }


  list(

    edges =
      edges_plot,

    all_edges =
      edges_site,

    nodes =
      nodes_plot,

    order =
      residue_order,

    gap_after =
      rep(
        sector_gap_degree,
        length(
          residue_order
        )
      )
  )
}


# ==============================================================================
# 18. RIBBON ALLOCATION
# ==============================================================================

allocate_ribbon_intervals <- function(
    edges,
    residue_order
) {


  if (nrow(edges) == 0) {

    return(
      list(
        edges = edges,
        maximum_total = 1
      )
    )
  }


  totals <- setNames(

    rep(
      0,
      length(
        residue_order
      )
    ),

    residue_order
  )


  for (
    k in seq_len(
      nrow(
        edges
      )
    )
  ) {

    r1 <- edges$residue_1[k]

    r2 <- edges$residue_2[k]

    w <- edges$spearman_abs[k]


    totals[r1] <-
      totals[r1] + w


    totals[r2] <-
      totals[r2] + w
  }


  maximum_total <- max(
    totals,
    na.rm = TRUE
  )


  if (
    !is.finite(maximum_total) ||
    maximum_total <= 0
  ) {

    maximum_total <- 1
  }


  cursors <- setNames(

    rep(
      0,
      length(
        residue_order
      )
    ),

    residue_order
  )


  allocation_order <- order(
    edges$spearman_abs,
    decreasing = TRUE
  )


  E <- edges[
    allocation_order,
    ,
    drop = FALSE
  ]


  E$start_1 <- NA_real_

  E$end_1 <- NA_real_

  E$start_2 <- NA_real_

  E$end_2 <- NA_real_


  for (
    k in seq_len(
      nrow(E)
    )
  ) {


    r1 <- E$residue_1[k]

    r2 <- E$residue_2[k]

    w <- E$spearman_abs[k]


    E$start_1[k] <-
      cursors[r1]


    E$end_1[k] <-
      cursors[r1] + w


    E$start_2[k] <-
      cursors[r2]


    E$end_2[k] <-
      cursors[r2] + w


    cursors[r1] <-
      cursors[r1] + w


    cursors[r2] <-
      cursors[r2] + w
  }


  list(

    edges =
      E,

    maximum_total =
      maximum_total
  )
}


# ==============================================================================
# 19. RIGHT-SIDE VERTICAL GRADIENT
# ==============================================================================

draw_vertical_gradient_right <- function(
    x_center,
    y_bottom,
    y_top,
    bar_width,
    colour_function,
    title_text
) {


  x_left <-
    x_center -
    bar_width / 2


  x_right <-
    x_center +
    bar_width / 2


  gradient_values <- seq(
    -1,
    1,
    length.out = 400
  )


  y_breaks <- seq(
    y_bottom,
    y_top,
    length.out =
      length(
        gradient_values
      ) + 1
  )


  # ---------------------------------------------------------------------------
  # GRADIENT BAR
  #
  # bottom = -1
  # center = 0
  # top    = +1
  # ---------------------------------------------------------------------------

  for (
    i in seq_along(
      gradient_values
    )
  ) {


    rect(

      xleft =
        x_left,

      ybottom =
        y_breaks[i],

      xright =
        x_right,

      ytop =
        y_breaks[i + 1],

      col =
        colour_function(
          gradient_values[i]
        ),

      border =
        NA,

      xpd =
        NA
    )
  }


  # ---------------------------------------------------------------------------
  # TITLE
  #
  # Rotated to follow the vertical gradient
  # ---------------------------------------------------------------------------

  text(

    x =
      x_left -
      0.055,

    y =
      (
        y_bottom +
          y_top
      ) / 2,

    labels =
      title_text,

    srt =
      90,

    cex =
      text_cex,

    font =
      1,

    family =
      font_family,

    adj = c(
      0.5,
      0.5
    ),

    xpd =
      NA
  )


  # ---------------------------------------------------------------------------
  # SCALE LABELS
  # ---------------------------------------------------------------------------

  text(

    x =
      x_right +
      0.035,

    y = c(
      y_top,
      (
        y_bottom +
          y_top
      ) / 2,
      y_bottom
    ),

    labels = c(
      "+1",
      "0",
      "-1"
    ),

    cex =
      text_cex,

    font =
      1,

    family =
      font_family,

    adj = c(
      0,
      0.5
    ),

    xpd =
      NA
  )
}


# ==============================================================================
# 20. DRAW CHORD
# ==============================================================================

draw_main_chord <- function(
    site_name
) {


  plot_data <- prepare_site_plot(
    site_name
  )


  edges_plot <-
    plot_data$edges


  nodes_plot <-
    plot_data$nodes


  residue_order <-
    plot_data$order


  ribbon_data <- allocate_ribbon_intervals(
    edges_plot,
    residue_order
  )


  edges_allocated <-
    ribbon_data$edges


  maximum_total <-
    ribbon_data$maximum_total


  # ---------------------------------------------------------------------------
  # PCA EXPLAINED VARIANCE
  # ---------------------------------------------------------------------------

  PC1_variance <- get_variance_percent(
    variance_all,
    site_name,
    "PC1"
  )


  PC2_variance <- get_variance_percent(
    variance_all,
    site_name,
    "PC2"
  )


  par(

    mar = c(
      0.1,
      0.1,
      1.2,
      0.1
    ),

    xpd =
      NA,

    family =
      font_family
  )


  circos.clear()


  # ---------------------------------------------------------------------------
  # More canvas space is provided on the RIGHT for the two vertical legends.
  #
  # The chord itself remains centered at x = 0.
  # ---------------------------------------------------------------------------

  circos.par(

    start.degree =
      90,

    gap.after =
      plot_data$gap_after,

    track.margin = c(
      0.002,
      0.002
    ),

    cell.padding = c(
      0,
      0,
      0,
      0
    ),

    points.overflow.warning =
      FALSE,

    canvas.xlim = c(
      -1.03,
      1.72
    ),

    canvas.ylim = c(
      -1.03,
      1.03
    )
  )


  circos.initialize(

    factors =
      factor(
        residue_order,
        levels = residue_order
      ),

    xlim =
      cbind(

        rep(
          0,
          length(
            residue_order
          )
        ),

        rep(
          maximum_total,
          length(
            residue_order
          )
        )
      )
  )


  # ===========================================================================
  # TRACK 1 — RESIDUE LABELS
  # ===========================================================================

  circos.trackPlotRegion(

    ylim = c(
      0,
      1
    ),

    track.height =
      residue_track_height,

    bg.border =
      NA,

    bg.col =
      NA,

    panel.fun = function(
        x,
        y
    ) {


      residue_name <-
        CELL_META$sector.index


      circos.text(

        x =
          CELL_META$xcenter,

        y =
          mean(
            CELL_META$ylim
          ),

        labels =
          residue_name,

        facing =
          "bending.outside",

        niceFacing =
          TRUE,

        adj = c(
          0.5,
          0.5
        ),

        cex =
          text_cex,

        font =
          1,

        family =
          font_family
      )
    }
  )


  # ===========================================================================
  # TRACK 2 — OUTER RING = PC1
  # ===========================================================================

  circos.trackPlotRegion(

    ylim = c(
      0,
      1
    ),

    track.height =
      PC1_track_height,

    bg.border =
      NA,

    bg.col =
      NA,

    panel.fun = function(
        x,
        y
    ) {


      residue_name <-
        CELL_META$sector.index


      idx <- match(
        residue_name,
        nodes_plot$residue
      )


      loading_value <-
        nodes_plot$PC1_loading[
          idx
        ]


      circos.rect(

        CELL_META$xlim[1],

        CELL_META$ylim[1],

        CELL_META$xlim[2],

        CELL_META$ylim[2],

        col =
          loading_col_fun(
            loading_value
          ),

        border =
          "white",

        lwd =
          0.7
      )
    }
  )


  # ===========================================================================
  # TRACK 3 — INNER RING = PC2
  # ===========================================================================

  circos.trackPlotRegion(

    ylim = c(
      0,
      1
    ),

    track.height =
      PC2_track_height,

    bg.border =
      NA,

    bg.col =
      NA,

    panel.fun = function(
        x,
        y
    ) {


      residue_name <-
        CELL_META$sector.index


      idx <- match(
        residue_name,
        nodes_plot$residue
      )


      loading_value <-
        nodes_plot$PC2_loading[
          idx
        ]


      circos.rect(

        CELL_META$xlim[1],

        CELL_META$ylim[1],

        CELL_META$xlim[2],

        CELL_META$ylim[2],

        col =
          loading_col_fun(
            loading_value
          ),

        border =
          "white",

        lwd =
          0.7
      )
    }
  )


  # ===========================================================================
  # SPEARMAN RIBBONS
  # ===========================================================================

  if (nrow(edges_allocated) > 0) {


    draw_order <- order(
      edges_allocated$spearman_abs,
      decreasing = FALSE
    )


    for (
      k in draw_order
    ) {


      ribbon_colour <- grDevices::adjustcolor(

        edges_allocated$link_colour[k],

        alpha.f =
          0.80
      )


      circos.link(

        sector.index1 =
          edges_allocated$residue_1[k],

        point1 = c(
          edges_allocated$start_1[k],
          edges_allocated$end_1[k]
        ),

        sector.index2 =
          edges_allocated$residue_2[k],

        point2 = c(
          edges_allocated$start_2[k],
          edges_allocated$end_2[k]
        ),

        col =
          ribbon_colour,

        border =
          NA
      )
    }
  }


  # ===========================================================================
  # MAIN TITLE
  #
  # Placed at x = 0 so it remains centered above the chord,
  # not above the enlarged right-side canvas.
  # ===========================================================================

  text(

    x =
      0,

    y =
      1.15,

    labels =
      site_titles[[site_name]],

    cex =
      1.28,

    font =
      2,

    family =
      font_family,

    adj = c(
      0.5,
      0.5
    ),

    xpd =
      NA
  )


  # ===========================================================================
  # PC1 / PC2 EXPLAINED VARIANCE
  #
  # Bold
  # PC1 directly above PC2
  # ===========================================================================

  text(

    x =
      PC_info_x,

    y =
      PC1_info_y,

    labels =
      paste0(
        "PC1 (outer ring): ",
        round(
          PC1_variance,
          1
        ),
        " %VE"
      ),

    cex =
      text_cex,

    font =
      2,

    family =
      font_family,

    adj = c(
      0,
      0.5
    ),

    xpd =
      NA
  )


  text(

    x =
      PC_info_x,

    y =
      PC2_info_y,

    labels =
      paste0(
        "PC2 (inner ring): ",
        round(
          PC2_variance,
          1
        ),
        " %VE"
      ),

    cex =
      text_cex,

    font =
      2,

    family =
      font_family,

    adj = c(
      0,
      0.5
    ),

    xpd =
      NA
  )


  # ===========================================================================
  # RIGHT-SIDE LEGEND 1 — PRINCIPAL COMPONENT LOADING
  # ===========================================================================

  draw_vertical_gradient_right(

    x_center =
      loading_legend_center_x,

    y_bottom =
      legend_y_bottom,

    y_top =
      legend_y_top,

    bar_width =
      legend_bar_width,

    colour_function =
      loading_col_fun,

    title_text =
      "Principal component loading"
  )


  # ===========================================================================
  # RIGHT-SIDE LEGEND 2 — SPEARMAN
  # ===========================================================================

  draw_vertical_gradient_right(

    x_center =
      correlation_legend_center_x,

    y_bottom =
      legend_y_bottom,

    y_top =
      legend_y_top,

    bar_width =
      legend_bar_width,

    colour_function =
      correlation_col_fun,

    title_text =
      "Spearman correlation (ρ)"
  )


  circos.clear()
}



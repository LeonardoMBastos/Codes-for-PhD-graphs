      next
    }

    baseline <-
      site_position[[s]] +
      CLOUD_VERTICAL_POSITION +
      cloud_offset[[c]]

    result <-
      calculate_density_polygon(
        x = current_data$x_plot,
        baseline = baseline,
        site_name = s,
        compound_name = c,
        lower_bound = -10,
        upper_bound = 0,
        margin = 0.35,
        adjust = 1.20,
        height_scale = 0.25,
        tail_fraction = 0.08
      )

    if (!is.null(result)) {
      numeric_polygons[[counter]] <- result
      counter <- counter + 1
    }
  }
}


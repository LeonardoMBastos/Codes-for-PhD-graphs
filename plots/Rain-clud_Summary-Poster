# ------------------------------------------------------------
# 21. BOXPLOT FUNCTION
# ------------------------------------------------------------

calculate_box_stats <- function(data) {

  if (nrow(data) == 0) {
    return(data.frame())
  }

  base_stats <- data %>%
    group_by(site_std, compound_std) %>%
    summarise(
      q1 = quantile(x_plot, 0.25, na.rm = TRUE),
      median = median(x_plot, na.rm = TRUE),
      q3 = quantile(x_plot, 0.75, na.rm = TRUE),
      iqr = IQR(x_plot, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    mutate(
      lower_limit = q1 - 1.5 * iqr,
      upper_limit = q3 + 1.5 * iqr
    )

  whiskers <- data %>%
    inner_join(
      base_stats %>%
        select(site_std, compound_std, lower_limit, upper_limit),
      by = c("site_std", "compound_std")
    ) %>%
    group_by(site_std, compound_std) %>%
    summarise(
      whisker_low = min(
        x_plot[x_plot >= lower_limit],
        na.rm = TRUE
      ),
      whisker_high = max(
        x_plot[x_plot <= upper_limit],
        na.rm = TRUE
      ),
      .groups = "drop"
    )

  base_stats %>%
    left_join(
      whiskers,
      by = c("site_std", "compound_std")
    )
}



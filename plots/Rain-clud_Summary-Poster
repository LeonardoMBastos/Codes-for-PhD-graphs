# ------------------------------------------------------------
# 23. CLOSED DENSITY FUNCTION
# ------------------------------------------------------------

calculate_density_polygon <- function(
  x,
  baseline,
  site_name,
  compound_name,
  lower_bound,
  upper_bound,
  margin,
  adjust = 1.20,
  height_scale = 0.25,
  tail_fraction = 0.08
) {

  x <- x[is.finite(x)]

  if (length(x) < 2) {
    return(NULL)
  }

  if (length(unique(round(x, 5))) == 1) {
    x <- c(x, x + 0.000001)
  }

  x_min <- max(lower_bound, min(x) - margin)
  x_max <- min(upper_bound, max(x) + margin)

  if (x_max <= x_min) {
    return(NULL)
  }

  density_result <- density(
    x = x,
    from = x_min,
    to = x_max,
    n = 512,
    adjust = adjust
  )

  density_values <- density_result$y
  threshold <- max(density_values) * tail_fraction
  valid_index <- which(density_values > threshold)

  if (length(valid_index) < 5) {
    return(NULL)
  }

  first_index <- min(valid_index)
  last_index <- max(valid_index)

  x_trimmed <- density_result$x[first_index:last_index]
  density_trimmed <- density_values[first_index:last_index]

  y_trimmed <-
    baseline +
    (density_trimmed / max(density_trimmed)) * height_scale

  data.frame(
    x = c(x_trimmed, rev(x_trimmed)),
    y = c(y_trimmed, rep(baseline, length(x_trimmed))),
    site_std = site_name,
    compound_std = compound_name
  )
}



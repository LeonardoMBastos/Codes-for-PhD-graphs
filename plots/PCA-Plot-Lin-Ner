plot_pca_with_inset <- function(
    
  pca_result,
  
  title,
  
  n_residues = 8,
  
  inset_width = 0.34,
  
  inset_height = 0.34
  
) {
  
  
  scores <- pca_result$scores
  
  centroids <- pca_result$centroids
  
  variance <- pca_result$variance
  
  
  loadings_top <- pca_result$loadings_PC12 %>%
    
    slice_head(
      n = n_residues
    )
  
  
  ellipse_scores <- scores %>%
    
    group_by(
      compound
    ) %>%
    
    filter(
      n() >= 3
    ) %>%
    
    ungroup()
  
  
  main_plot <- ggplot(
    
    scores,
    
    aes(
      x = PC1,
      y = PC2
    )
    
  ) +
    
    
    geom_hline(
      
      yintercept = 0,
      
      colour = "grey82",
      
      linewidth = 0.45
      
    ) +
    
    
    geom_vline(
      
      xintercept = 0,
      
      colour = "grey82",
      
      linewidth = 0.45
      
    ) +
    
    
    stat_ellipse(
      
      data = ellipse_scores,
      
      aes(
        fill = compound,
        group = compound
      ),
      
      geom = "polygon",
      
      type = "norm",
      
      level = 0.95,
      
      alpha = 0.10,
      
      colour = NA,
      
      show.legend = FALSE
      
    ) +
    
    
    stat_ellipse(
      
      data = ellipse_scores,
      
      aes(
        colour = compound,
        group = compound
      ),
      
      type = "norm",
      
      level = 0.95,
      
      linewidth = 0.55,
      
      alpha = 0.95,
      
      show.legend = FALSE
      
    ) +
    
    
    geom_point(
      
      aes(
        colour = compound
      ),
      
      size = 2.1,
      
      alpha = 0.72,
      
      show.legend = FALSE
      
    ) +
    
    
    geom_point(
      
      data = centroids,
      
      aes(
        x = PC1,
        y = PC2,
        fill = compound
      ),
      
      inherit.aes = FALSE,
      
      shape = 23,
      
      size = 4.2,
      
      colour = "black",
      
      stroke = 0.85,
      
      show.legend = FALSE
      
    ) +
    
    
    scale_colour_manual(
      
      values = compound_colors,
      
      limits = observed_compounds,
      
      breaks = observed_compounds,
      
      drop = FALSE,
      
      name = "Compound"
      
    ) +
    
    
    scale_fill_manual(
      
      values = compound_colors,
      
      limits = observed_compounds,
      
      breaks = observed_compounds,
      
      drop = FALSE,
      
      guide = "none"
      
    ) +
    
    
    scale_x_continuous(
      
      expand = expansion(
        mult = c(
          0.08,
          0.08
        )
      )
      
    ) +
    
    
    scale_y_continuous(
      
      expand = expansion(
        mult = c(
          0.08,
          0.08
        )
      )
      
    ) +
    
    
    coord_cartesian(
      clip = "on"
    ) +
    
    
    labs(
      
      title = title,
      
      x = paste0(
        
        "PC1 (",
        
        round(
          
          variance$variance_percent[
            variance$PC == "PC1"
          ],
          
          1
          
        ),
        
        "%)"
        
      ),
      
      y = paste0(
        
        "PC2 (",
        
        round(
          
          variance$variance_percent[
            variance$PC == "PC2"
          ],
          
          1
          
        ),
        
        "%)"
        
      )
      
    ) +
    
    
    theme_classic(
      base_size = 13
    ) +
    
    
    theme(
      
      plot.title = element_text(
        face = "bold",
        hjust = 0.5,
        size = 14
      ),
      
      axis.title = element_text(
        face = "plain"
      ),
      
      axis.text = element_text(
        face = "plain"
      ),
      
      legend.position = "none",
      
      plot.margin = margin(
        8,
        8,
        8,
        8
      )
      
    )
  
  
  inset_plot <- make_residue_inset(
    loadings_top
  )
  
  
  inset_left <- 1.00 -
    inset_width
  
  
  inset_bottom <- 1.00 -
    inset_height
  
  
  main_plot +
    
    patchwork::inset_element(
      
      inset_plot,
      
      left = inset_left,
      
      bottom = inset_bottom,
      
      right = 1.00,
      
      top = 1.00,
      
      align_to = "panel",
      
      clip = TRUE
      
    )
  
}




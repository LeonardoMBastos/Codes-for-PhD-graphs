# ==============================================================================
# 8. FUNCTION — RESIDUE-RESIDUE CORRELATIONS
# ==============================================================================

make_chord_correlations <- function(
    X,
    site_name
) {
  
  residues <- colnames(
    X
  )
  
  
  if (length(residues) < 2) {
    
    stop(
      "At least two residues are required for correlation analysis in site: ",
      site_name
    )
    
  }
  
  
  residue_pairs <- combn(
    residues,
    2,
    simplify = FALSE
  )
  
  
  correlation_table <- lapply(
    
    residue_pairs,
    
    function(pair) {
      
      
      residue_1 <- pair[1]
      
      residue_2 <- pair[2]
      
      
      x <- X[
        ,
        residue_1
      ]
      
      
      y <- X[
        ,
        residue_2
      ]
      
      
      valid <- is.finite(x) &
        is.finite(y)
      
      
      x <- x[
        valid
      ]
      
      
      y <- y[
        valid
      ]
      
      
      n_pair <- length(
        x
      )
      
      
      # ========================================================================
      # PEARSON
      # ========================================================================
      
      pearson_test <- tryCatch(
        
        suppressWarnings(
          
          cor.test(
            x,
            y,
            method = "pearson"
          )
          
        ),
        
        error = function(e) {
          NULL
        }
        
      )
      
      
      if (is.null(pearson_test)) {
        
        pearson_r <- NA_real_
        
        pearson_p <- NA_real_
        
      } else {
        
        pearson_r <- unname(
          pearson_test$estimate
        )
        
        pearson_p <- pearson_test$p.value
        
      }
      
      
      # ========================================================================
      # SPEARMAN
      #
      # exact = FALSE because fingerprint data commonly contain tied values.
      # ========================================================================
      
      spearman_test <- tryCatch(
        
        suppressWarnings(
          
          cor.test(
            x,
            y,
            method = "spearman",
            exact = FALSE
          )
          
        ),
        
        error = function(e) {
          NULL
        }
        
      )
      
      
      if (is.null(spearman_test)) {
        
        spearman_rho <- NA_real_
        
        spearman_p <- NA_real_
        
      } else {
        
        spearman_rho <- unname(
          spearman_test$estimate
        )
        
        spearman_p <- spearman_test$p.value
        
      }
      
      
      data.frame(
        
        site = site_name,
        
        residue_1 = residue_1,
        
        residue_2 = residue_2,
        
        n = n_pair,
        
        pearson_r = pearson_r,
        
        pearson_abs = abs(
          pearson_r
        ),
        
        pearson_p = pearson_p,
        
        pearson_direction = case_when(
          
          is.na(
            pearson_r
          ) ~ NA_character_,
          
          pearson_r > 0 ~ "Positive",
          
          pearson_r < 0 ~ "Negative",
          
          TRUE ~ "Zero"
          
        ),
        
        spearman_rho = spearman_rho,
        
        spearman_abs = abs(
          spearman_rho
        ),
        
        spearman_p = spearman_p,
        
        spearman_direction = case_when(
          
          is.na(
            spearman_rho
          ) ~ NA_character_,
          
          spearman_rho > 0 ~ "Positive",
          
          spearman_rho < 0 ~ "Negative",
          
          TRUE ~ "Zero"
          
        ),
        
        stringsAsFactors = FALSE
        
      )
      
    }
    
  )
  
  
  correlation_table <- bind_rows(
    correlation_table
  )
  
  
  # ============================================================================
  # FDR CORRECTION
  #
  # Benjamini-Hochberg correction applied independently inside each binding site.
  # ============================================================================
  
  correlation_table <- correlation_table %>%
    
    mutate(
      
      pearson_FDR = p.adjust(
        pearson_p,
        method = "BH"
      ),
      
      spearman_FDR = p.adjust(
        spearman_p,
        method = "BH"
      ),
      
      pearson_significant_005 =
        !is.na(
          pearson_FDR
        ) &
        pearson_FDR < 0.05,
      
      spearman_significant_005 =
        !is.na(
          spearman_FDR
        ) &
        spearman_FDR < 0.05
      
    ) %>%
    
    arrange(
      desc(
        pearson_abs
      )
    )
  
  
  return(
    correlation_table
  )
  
}



# ==============================================================================
# 9. FUNCTION — BUILD FINGERPRINT + PCA
# ==============================================================================

run_pca_site <- function(
    data,
    site_name
) {
  
  
  data_site <- data %>%
    
    filter(
      site == site_name
    ) %>%
    
    mutate(
      .pose_row = row_number()
    )
  
  
  if (nrow(data_site) < 3) {
    
    stop(
      "Too few observations for site: ",
      site_name
    )
    
  }
  
  
  
  # ============================================================================
  # PARSE RESIDUE INTERACTIONS
  # ============================================================================
  
  fingerprint_long <- data_site %>%
    
    select(
      .pose_row,
      `Top residues`
    ) %>%
    
    separate_rows(
      `Top residues`,
      sep = ";\\s*"
    ) %>%
    
    mutate(
      
      residue = str_extract(
        `Top residues`,
        "^[^ ]+"
      ),
      
      interaction_count = as.numeric(
        
        str_match(
          `Top residues`,
          "\\((\\d+)\\)"
        )[
          ,
          2
        ]
        
      )
      
    ) %>%
    
    filter(
      !is.na(
        residue
      ),
      !is.na(
        interaction_count
      )
    )
  
  
  if (nrow(fingerprint_long) == 0) {
    
    stop(
      "No residue-interaction fingerprints could be parsed for site: ",
      site_name
    )
    
  }
  
  
  
  # ============================================================================
  # POSE x RESIDUE MATRIX
  # ============================================================================
  
  fingerprint_wide <- fingerprint_long %>%
    
    select(
      .pose_row,
      residue,
      interaction_count
    ) %>%
    
    pivot_wider(
      
      names_from = residue,
      
      values_from = interaction_count,
      
      values_fill = 0,
      
      values_fn = sum
      
    )
  
  
  fingerprint_wide <- data_site %>%
    
    select(
      .pose_row
    ) %>%
    
    left_join(
      fingerprint_wide,
      by = ".pose_row"
    )
  
  
  fingerprint_wide[
    is.na(
      fingerprint_wide
    )
  ] <- 0
  
  
  X_raw <- as.matrix(
    
    fingerprint_wide[
      ,
      -1,
      drop = FALSE
    ]
    
  )
  
  
  
  # ============================================================================
  # REMOVE EMPTY POSES
  # ============================================================================
  
  valid_rows <- rowSums(
    X_raw
  ) > 0
  
  
  if (any(!valid_rows)) {
    
    warning(
      
      sum(
        !valid_rows
      ),
      
      " pose(s) removed from site ",
      
      site_name,
      
      " because no residue interactions were parsed."
      
    )
    
  }
  
  
  X_raw <- X_raw[
    valid_rows,
    ,
    drop = FALSE
  ]
  
  
  data_site <- data_site[
    valid_rows,
    ,
    drop = FALSE
  ]
  
  
  
  # ============================================================================
  # REMOVE RESIDUES WITHOUT VARIATION
  # ============================================================================
  
  variable_residues <- apply(
    
    X_raw,
    
    2,
    
    function(x) {
      
      stats::sd(
        x
      ) > 0
      
    }
    
  )
  
  
  X_raw <- X_raw[
    ,
    variable_residues,
    drop = FALSE
  ]
  
  
  if (ncol(X_raw) < 2) {
    
    stop(
      "Fewer than two variable residues remain for site: ",
      site_name
    )
    
  }
  
  
  
  # ============================================================================
  # RELATIVE ABUNDANCE + HELLINGER TRANSFORMATION
  # ============================================================================
  
  X_relative <- X_raw /
    rowSums(
      X_raw
    )
  
  
  X_hellinger <- sqrt(
    X_relative
  )
  
  
  
  # ============================================================================
  # PCA
  # ============================================================================
  
  pca <- prcomp(
    
    X_hellinger,
    
    center = TRUE,
    
    scale. = FALSE
    
  )
  
  
  
  # ============================================================================
  # EXPLAINED VARIANCE
  # ============================================================================
  
  variance_percent <- (
    
    pca$sdev^2 /
      
      sum(
        pca$sdev^2
      )
    
  ) * 100
  
  
  cumulative_percent <- cumsum(
    variance_percent
  )
  
  
  variance_table <- data.frame(
    
    site = site_name,
    
    PC = paste0(
      "PC",
      seq_along(
        variance_percent
      )
    ),
    
    eigenvalue = pca$sdev^2,
    
    variance_percent = variance_percent,
    
    cumulative_percent = cumulative_percent,
    
    stringsAsFactors = FALSE
    
  )
  
  
  
  # ============================================================================
  # PCA SCORES
  # ============================================================================
  
  score_matrix <- as.data.frame(
    pca$x
  )
  
  
  scores_all <- bind_cols(
    
    data_site %>%
      
      select(
        site,
        compound,
        affinity,
        pose_ID
      ),
    
    score_matrix
    
  )
  
  
  
  # ============================================================================
  # PCA LOADINGS
  # ============================================================================
  
  loading_matrix <- as.data.frame(
    pca$rotation
  )
  
  
  loadings_all <- data.frame(
    
    site = site_name,
    
    residue = rownames(
      pca$rotation
    ),
    
    loading_matrix,
    
    row.names = NULL,
    
    check.names = FALSE
    
  )
  
  
  
  # ============================================================================
  # PC1-PC2 MAGNITUDE
  # ============================================================================
  
  loadings_PC12 <- loadings_all %>%
    
    mutate(
      
      abs_PC1 = abs(
        PC1
      ),
      
      abs_PC2 = abs(
        PC2
      ),
      
      contribution_PC12 = sqrt(
        PC1^2 +
          PC2^2
      )
      
    ) %>%
    
    arrange(
      desc(
        contribution_PC12
      )
    )
  
  
  
  # ============================================================================
  # PCA CONTRIBUTION OF EACH RESIDUE
  #
  # Squared loadings are normalized separately within PC1 and PC2.
  #
  # These percentages describe relative residue contribution to the orientation
  # of each principal component.
  #
  # They are NOT the percentage of total dataset variance explained by an
  # individual residue.
  # ============================================================================
  
  pc1_variance_percent <- variance_table %>%
    
    filter(
      PC == "PC1"
    ) %>%
    
    pull(
      variance_percent
    )
  
  
  pc2_variance_percent <- variance_table %>%
    
    filter(
      PC == "PC2"
    ) %>%
    
    pull(
      variance_percent
    )
  
  
  chord_nodes <- loadings_all %>%
    
    transmute(
      
      site = site,
      
      residue = residue,
      
      
      # ------------------------------------------------------------------------
      # PC1
      # ------------------------------------------------------------------------
      
      PC1_loading = PC1,
      
      PC1_abs_loading = abs(
        PC1
      ),
      
      PC1_direction = case_when(
        
        PC1 > 0 ~ "Positive",
        
        PC1 < 0 ~ "Negative",
        
        TRUE ~ "Zero"
        
      ),
      
      PC1_contribution_percent = (
        
        PC1^2 /
          
          sum(
            PC1^2,
            na.rm = TRUE
          )
        
      ) * 100,
      
      PC1_variance_percent =
        pc1_variance_percent,
      
      
      # ------------------------------------------------------------------------
      # PC2
      # ------------------------------------------------------------------------
      
      PC2_loading = PC2,
      
      PC2_abs_loading = abs(
        PC2
      ),
      
      PC2_direction = case_when(
        
        PC2 > 0 ~ "Positive",
        
        PC2 < 0 ~ "Negative",
        
        TRUE ~ "Zero"
        
      ),
      
      PC2_contribution_percent = (
        
        PC2^2 /
          
          sum(
            PC2^2,
            na.rm = TRUE
          )
        
      ) * 100,
      
      PC2_variance_percent =
        pc2_variance_percent,
      
      
      # ------------------------------------------------------------------------
      # Combined PC1-PC2 magnitude
      # ------------------------------------------------------------------------
      
      PC1_PC2_magnitude = sqrt(
        
        PC1^2 +
          
          PC2^2
        
      )
      
    ) %>%
    
    arrange(
      desc(
        PC1_PC2_magnitude
      )
    )
  
  
  
  # ============================================================================
  # RESIDUE-RESIDUE CORRELATIONS
  #
  # IMPORTANT:
  #
  # Correlations are calculated using X_hellinger,
  # i.e. the same transformed fingerprint matrix used in the PCA.
  # ============================================================================
  
  chord_correlations <- make_chord_correlations(
    
    X = X_hellinger,
    
    site_name = site_name
    
  )
  
  
  
  # ============================================================================
  # CENTROIDS
  # ============================================================================
  
  centroids <- scores_all %>%
    
    group_by(
      site,
      compound
    ) %>%
    
    summarise(
      
      n = n(),
      
      PC1 = mean(
        PC1,
        na.rm = TRUE
      ),
      
      PC2 = mean(
        PC2,
        na.rm = TRUE
      ),
      
      .groups = "drop"
      
    )
  
  
  
  # ============================================================================
  # RETURN
  # ============================================================================
  
  return(
    
    list(
      
      site = site_name,
      
      pca = pca,
      
      variance = variance_table,
      
      scores = scores_all,
      
      loadings = loadings_all,
      
      loadings_PC12 = loadings_PC12,
      
      centroids = centroids,
      
      fingerprint_raw = X_raw,
      
      fingerprint = X_hellinger,
      
      chord_correlations = chord_correlations,
      
      chord_nodes = chord_nodes
      
    )
    
  )
  
}




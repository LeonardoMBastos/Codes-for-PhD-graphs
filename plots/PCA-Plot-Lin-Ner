# ==============================================================================
# 11. MINI PCA INSET
# ==============================================================================

make_residue_inset <- function(
    loadings_df
) {
  
  
  inset_df <- loadings_df %>%
    
    mutate(
      label = residue
    )
  
  
  max_x <- max(
    abs(
      inset_df$PC1
    ),
    na.rm = TRUE
  )
  
  
  max_y <- max(
    abs(
      inset_df$PC2
    ),
    na.rm = TRUE
  )
  
  
  lim_x <- max_x * 1.40
  
  lim_y <- max_y * 1.40
  
  
  if (
    !is.finite(
      lim_x
    ) ||
    lim_x == 0
  ) {
    
    lim_x <- 1
    
  }
  
  
  if (
    !is.finite(
      lim_y
    ) ||
    lim_y == 0
  ) {
    
    lim_y <- 1
    
  }
  
  
  ggplot(
    
    inset_df,
    
    aes(
      x = PC1,
      y = PC2
    )
    
  ) +
    
    
    geom_hline(
      
      yintercept = 0,
      
      colour = "grey45",
      
      linewidth = 0.28
      
    ) +
    
    
    geom_vline(
      
      xintercept = 0,
      
      colour = "grey45",
      
      linewidth = 0.28
      
    ) +
    
    
    geom_segment(
      
      aes(
        x = 0,
        y = 0,
        xend = PC1,
        yend = PC2
      ),
      
      arrow = grid::arrow(
        
        length = grid::unit(
          0.10,
          "cm"
        ),
        
        type = "open"
        
      ),
      
      linewidth = 0.28,
      
      colour = "black"
      
    ) +
    
    
    geom_point(
      
      size = 0.55,
      
      colour = "black"
      
    ) +
    
    
    ggrepel::geom_text_repel(
      
      aes(
        label = label
      ),
      
      seed = 1234,
      
      size = 2.25,
      
      colour = "black",
      
      fontface = "italic",
      
      box.padding = 0.35,
      
      point.padding = 0.10,
      
      segment.colour = "grey55",
      
      segment.linewidth = 0.18,
      
      force = 6,
      
      force_pull = 0.15,
      
      max.overlaps = Inf,
      
      min.segment.length = 0,
      
      max.time = 5
      
    ) +
    
    
    annotate(
      
      "text",
      
      x = lim_x * 0.94,
      
      y = -lim_y * 0.055,
      
      label = "PC1",
      
      size = 2.25,
      
      hjust = 1,
      
      vjust = 1
      
    ) +
    
    
    annotate(
      
      "text",
      
      x = lim_x * 0.035,
      
      y = lim_y * 0.94,
      
      label = "PC2",
      
      size = 2.25,
      
      angle = 90,
      
      hjust = 1,
      
      vjust = 1
      
    ) +
    
    
    coord_cartesian(
      
      xlim = c(
        -lim_x,
        lim_x
      ),
      
      ylim = c(
        -lim_y,
        lim_y
      ),
      
      clip = "on",
      
      expand = FALSE
      
    ) +
    
    
    theme_classic(
      base_size = 8
    ) +
    
    
    theme(
      
      axis.title = element_blank(),
      
      axis.text = element_blank(),
      
      axis.ticks = element_blank(),
      
      panel.border = element_blank(),
      
      plot.background = element_rect(
        fill = NA,
        colour = NA
      ),
      
      panel.background = element_rect(
        
        fill = grDevices::adjustcolor(
          "white",
          alpha.f = 0.60
        ),
        
        colour = NA
        
      ),
      
      plot.margin = margin(
        0,
        0,
        0,
        0
      )
      
    )
  
}




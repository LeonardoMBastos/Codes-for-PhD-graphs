make_shared_legend <- function(
    observed_compounds
) {
  
  
  legend_df <- data.frame(
    
    compound = factor(
      observed_compounds,
      levels = observed_compounds
    ),
    
    x = seq_along(
      observed_compounds
    ),
    
    y = 1
    
  )
  
  
  legend_plot <- ggplot(
    
    legend_df,
    
    aes(
      x = x,
      y = y,
      colour = compound
    )
    

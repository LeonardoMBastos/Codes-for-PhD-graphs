# ==============================================================================
# 10. MINI-PCA INSET FUNCTION
# ==============================================================================

make_residue_inset <- function(
    loadings_df
) {

  inset_df <- loadings_df %>%
    mutate(
      label = residue
    )


  max_x <- max(
    abs(inset_df$PC1),
    na.rm = TRUE
  )


  max_y <- max(
    abs(inset_df$PC2),
    na.rm = TRUE
  )


  lim_x <- max_x * 1.40

  lim_y <- max_y * 1.40


  if (
    !is.finite(lim_x) ||
    lim_x == 0
  ) {

    lim_x <- 1
  }


  if (
    !is.finite(lim_y) ||
    lim_y == 0
  ) {

    lim_y <- 1
  }


  ggplot(
    inset_df,
    aes(
      x = PC1,
      y = PC2
    )
  ) +


    geom_hline(

      yintercept = 0,

      colour = "grey45",

      linewidth = 0.28
    ) +


    geom_vline(

      xintercept = 0,

      colour = "grey45",

      linewidth = 0.28
    ) +


    geom_segment(

      aes(

        x = 0,

        y = 0,

        xend = PC1,

        yend = PC2
      ),

      arrow = grid::arrow(

        length = grid::unit(
          0.10,
          "cm"
        ),

        type = "open"
      ),

      linewidth = 0.28,

      colour = "black"
    ) +


    geom_point(

      size = 0.55,

      colour = "black"
    ) +


    ggrepel::geom_text_repel(

      aes(
        label = label
      ),

      seed = 1234,

      size = 2.25,

      colour = "black",

      fontface = "italic",

      box.padding = 0.35,

      point.padding = 0.10,

      segment.colour = "grey55",

      segment.linewidth = 0.18,

      force = 6,

      force_pull = 0.15,

      max.overlaps = Inf,

      min.segment.length = 0,

      max.time = 5
    ) +


    annotate(

      "text",

      x = lim_x * 0.96,

      y = -lim_y * 0.055,

      label = "PC1",

      size = 2.25,

      hjust = 1,

      vjust = 1
    ) +


    annotate(

      "text",

      x = lim_x * 0.035,

      y = lim_y * 0.96,

      label = "PC2",

      size = 2.25,

      angle = 90,

      hjust = 1,

      vjust = 1
    ) +


    coord_cartesian(

      xlim = c(
        -lim_x,
        lim_x
      ),

      ylim = c(
        -lim_y,
        lim_y
      ),

      clip = "on"
    ) +


    theme_classic(
      base_size = 8
    ) +


    theme(

      axis.title = element_blank(),

      axis.text = element_blank(),

      axis.ticks = element_blank(),

      panel.border = element_blank(),

      plot.background = element_rect(
        fill = NA,
        colour = NA
      ),

      panel.background = element_rect(

        fill = grDevices::adjustcolor(
          "white",
          alpha.f = 0.60
        ),

        colour = NA
      ),

      plot.margin = margin(
        1,
        1,
        1,
        1
      )
    )
}


# ==============================================================================
# 11. SINGLE SHARED LEGEND
# ==============================================================================

make_shared_legend <- function(
    observed_compounds
) {

  legend_df <- data.frame(

    compound = factor(
      observed_compounds,
      levels = observed_compounds
    ),

    x = seq_along(
      observed_compounds
    ),

    y = 1
  )


  legend_plot <- ggplot(

    legend_df,

    aes(
      x = x,
      y = y,
      colour = compound
    )
  ) +


    geom_point(
      size = 2.7,
      alpha = 1
    ) +


    scale_colour_manual(

      values = compound_colors,

      limits = observed_compounds,

      breaks = observed_compounds,

      drop = FALSE,

      name = "Compound"
    ) +


    theme_void() +


    theme(

      legend.position = "bottom",

      legend.direction = "horizontal",

      legend.box = "horizontal",

      legend.justification = "center",

      legend.title = element_text(

        face = "plain",

        size = 12
      ),

      legend.text = element_text(

        face = "plain",

        size = 11
      ),

      legend.spacing.x = grid::unit(
        0.10,
        "cm"
      ),

      legend.margin = margin(
        0,
        0,
        0,
        0
      ),

      legend.box.margin = margin(
        0,
        0,
        0,
        0
      )
    ) +


    guides(

      colour = guide_legend(

        nrow = 1,

        byrow = TRUE,

        title.position = "left",

        override.aes = list(

          size = 3.1,

          alpha = 1
        )
      )
    )


  cowplot::get_legend(
    legend_plot
  )
}


# ==============================================================================
# 12. MAIN PCA PLOT FUNCTION
# ==============================================================================

plot_pca_with_inset <- function(

    pca_result,

    title,

    n_residues = 8,

    inset_left = 0.64,

    inset_bottom = 0.60,

    inset_right = 0.97,

    inset_top = 0.96

) {


  scores <- pca_result$scores


  centroids <- pca_result$centroids


  variance <- pca_result$variance


  loadings_top <- pca_result$loadings_PC12 %>%

    slice_head(
      n = n_residues
    )


  ellipse_scores <- scores %>%

    group_by(
      compound
    ) %>%

    filter(
      n() >= 3
    ) %>%

    ungroup()


  main_plot <- ggplot(

    scores,

    aes(
      x = PC1,
      y = PC2
    )
  ) +


    # -------------------------------------------------------------------------
    # Zero-reference axes
    # -------------------------------------------------------------------------

    geom_hline(

      yintercept = 0,

      colour = "grey82",

      linewidth = 0.45
    ) +


    geom_vline(

      xintercept = 0,

      colour = "grey82",

      linewidth = 0.45
    ) +


    # -------------------------------------------------------------------------
    # Filled 95% ellipses
    # -------------------------------------------------------------------------

    stat_ellipse(

      data = ellipse_scores,

      aes(

        fill = compound,

        group = compound
      ),

      geom = "polygon",

      type = "norm",

      level = 0.95,

      alpha = 0.10,

      colour = NA,

      show.legend = FALSE
    ) +


    # -------------------------------------------------------------------------
    # Ellipse outlines
    # -------------------------------------------------------------------------

    stat_ellipse(

      data = ellipse_scores,

      aes(

        colour = compound,

        group = compound
      ),

      type = "norm",

      level = 0.95,

      linewidth = 0.55,

      alpha = 0.95,

      show.legend = FALSE
    ) +


    # -------------------------------------------------------------------------
    # Individual poses
    # -------------------------------------------------------------------------

    geom_point(

      aes(
        colour = compound
      ),

      size = 2.1,

      alpha = 0.72,

      show.legend = FALSE
    ) +


    # -------------------------------------------------------------------------
    # Compound centroids — diamond
    # -------------------------------------------------------------------------

    geom_point(

      data = centroids,

      aes(

        x = PC1,

        y = PC2,

        fill = compound
      ),

      inherit.aes = FALSE,

      shape = 23,

      size = 4.2,

      colour = "black",

      stroke = 0.85,

      show.legend = FALSE
    ) +


    scale_colour_manual(

      values = compound_colors,

      limits = observed_compounds,

      breaks = observed_compounds,

      drop = FALSE,

      name = "Compound"
    ) +


    scale_fill_manual(

      values = compound_colors,

      limits = observed_compounds,

      breaks = observed_compounds,

      drop = FALSE,

      guide = "none"
    ) +


    # -------------------------------------------------------------------------
    # Slightly increased axis space
    # -------------------------------------------------------------------------

    scale_x_continuous(

      expand = expansion(
        mult = c(
          0.08,
          0.08
        )
      )
    ) +


    scale_y_continuous(

      expand = expansion(
        mult = c(
          0.08,
          0.08
        )
      )
    ) +


    coord_cartesian(
      clip = "on"
    ) +


    labs(

      title = title,

      x = paste0(

        "PC1 (",

        round(

          variance$variance_percent[
            variance$PC == "PC1"
          ],

          1
        ),

        "%)"
      ),

      y = paste0(

        "PC2 (",

        round(

          variance$variance_percent[
            variance$PC == "PC2"
          ],

          1
        ),

        "%)"
      )
    ) +


    theme_classic(
      base_size = 13
    ) +


    theme(

      plot.title = element_text(

        face = "bold",

        hjust = 0.5,

        size = 14
      ),

      axis.title = element_text(
        face = "plain"
      ),

      axis.text = element_text(
        face = "plain"
      ),

      legend.position = "none",

      plot.margin = margin(
        8,
        8,
        8,
        8
      )
    )


  # ---------------------------------------------------------------------------
  # Inset
  # ---------------------------------------------------------------------------

  inset_plot <- make_residue_inset(
    loadings_top
  )


  main_plot +

    patchwork::inset_element(

      inset_plot,

      left = inset_left,

      bottom = inset_bottom,

      right = inset_right,

      top = inset_top,

      align_to = "panel",

      clip = TRUE
    )
}



# ==============================================================================
# 6. RESIDUE-RESIDUE CORRELATION FUNCTION
# ==============================================================================

calculate_residue_correlations <- function(
    X,
    site_name
) {


  residues <- colnames(
    X
  )


  if (length(residues) < 2) {

    stop(
      paste0(
        "At least two residues are required for site: ",
        site_name
      ),
      call. = FALSE
    )

  }


  pair_index <- combn(
    seq_along(residues),
    2
  )


  results <- vector(
    "list",
    ncol(pair_index)
  )



  for (
    k in seq_len(
      ncol(pair_index)
    )
  ) {


    i <- pair_index[
      1,
      k
    ]


    j <- pair_index[
      2,
      k
    ]


    x <- X[
      ,
      i
    ]


    y <- X[
      ,
      j
    ]



    # ==========================================================================
    # PEARSON
    # ==========================================================================

    pearson_test <- tryCatch(

      suppressWarnings(

        cor.test(
          x,
          y,
          method = "pearson"
        )

      ),

      error = function(e) {
        NULL
      }

    )


    if (is.null(pearson_test)) {

      pearson_r <- NA_real_
      pearson_p <- NA_real_

    } else {

      pearson_r <- unname(
        pearson_test$estimate
      )

      pearson_p <- pearson_test$p.value

    }



    # ==========================================================================
    # SPEARMAN
    # ==========================================================================

    spearman_test <- tryCatch(

      suppressWarnings(

        cor.test(
          x,
          y,
          method = "spearman",
          exact = FALSE
        )

      ),

      error = function(e) {
        NULL
      }

    )


    if (is.null(spearman_test)) {

      spearman_rho <- NA_real_
      spearman_p <- NA_real_

    } else {

      spearman_rho <- unname(
        spearman_test$estimate
      )

      spearman_p <- spearman_test$p.value

    }



    results[[k]] <- data.frame(

      site =
        site_name,

      residue_1 =
        residues[i],

      residue_2 =
        residues[j],

      n =
        length(x),

      pearson_r =
        pearson_r,

      pearson_abs =
        abs(
          pearson_r
        ),

      pearson_p =
        pearson_p,

      pearson_direction =
        ifelse(
          is.na(pearson_r),
          NA_character_,
          ifelse(
            pearson_r >= 0,
            "Positive",
            "Negative"
          )
        ),

      spearman_rho =
        spearman_rho,

      spearman_abs =
        abs(
          spearman_rho
        ),

      spearman_p =
        spearman_p,

      spearman_direction =
        ifelse(
          is.na(spearman_rho),
          NA_character_,
          ifelse(
            spearman_rho >= 0,
            "Positive",
            "Negative"
          )
        ),

      stringsAsFactors =
        FALSE

    )

  }



  correlation_table <- do.call(
    rbind,
    results
  )



  # ============================================================================
  # MULTIPLE-COMPARISON CORRECTION
  # ============================================================================

  correlation_table$pearson_FDR <- p.adjust(
    correlation_table$pearson_p,
    method = "BH"
  )


  correlation_table$spearman_FDR <- p.adjust(
    correlation_table$spearman_p,
    method = "BH"
  )


  correlation_table$pearson_significant_005 <-
    !is.na(
      correlation_table$pearson_FDR
    ) &
    correlation_table$pearson_FDR <= 0.05


  correlation_table$spearman_significant_005 <-
    !is.na(
      correlation_table$spearman_FDR
    ) &
    correlation_table$spearman_FDR <= 0.05



  correlation_table <- correlation_table[
    order(
      -correlation_table$pearson_abs
    ),
    ,
    drop = FALSE
  ]


  return(
    correlation_table
  )

}



# ==============================================================================
# 7. FUNCTION — PCA FOR ONE BINDING SITE
# ==============================================================================

run_pca_site <- function(
    data,
    site_name
) {


  data_site <- data %>%

    filter(
      site == site_name
    ) %>%

    mutate(
      .pose_row = row_number()
    )


  if (nrow(data_site) < 3) {

    stop(
      paste0(
        "Too few observations for site: ",
        site_name
      ),
      call. = FALSE
    )

  }



  # ============================================================================
  # 7.1 PARSE TOP RESIDUES
  # ============================================================================

  fingerprint_long <- data_site %>%

    select(
      .pose_row,
      `Top residues`
    ) %>%

    separate_rows(
      `Top residues`,
      sep = ";\\s*"
    ) %>%

    mutate(

      residue =
        str_extract(
          `Top residues`,
          "^[^ ]+"
        ),

      interaction_count =
        as.numeric(

          str_match(
            `Top residues`,
            "\\((\\d+)\\)"
          )[
            ,
            2
          ]

        )

    ) %>%

    filter(
      !is.na(residue),
      !is.na(interaction_count)
    )



  if (nrow(fingerprint_long) == 0) {

    stop(
      paste0(
        "No residue fingerprints could be parsed for site: ",
        site_name
      ),
      call. = FALSE
    )

  }



  # ============================================================================
  # 7.2 POSE × RESIDUE MATRIX
  # ============================================================================

  fingerprint_wide <- fingerprint_long %>%

    select(
      .pose_row,
      residue,
      interaction_count
    ) %>%

    pivot_wider(

      names_from =
        residue,

      values_from =
        interaction_count,

      values_fill =
        0,

      values_fn =
        sum

    )



  fingerprint_wide <- data_site %>%

    select(
      .pose_row
    ) %>%

    left_join(
      fingerprint_wide,
      by = ".pose_row"
    )



  fingerprint_wide[
    is.na(
      fingerprint_wide
    )
  ] <- 0



  X_raw <- as.matrix(

    fingerprint_wide[
      ,
      -1,
      drop = FALSE
    ]

  )


  storage.mode(
    X_raw
  ) <- "double"



  # ============================================================================
  # 7.3 REMOVE EMPTY POSES
  # ============================================================================

  valid_rows <- rowSums(
    X_raw
  ) > 0


  if (any(!valid_rows)) {

    warning(
      paste0(
        sum(!valid_rows),
        " empty pose(s) removed from ",
        site_name,
        "."
      )
    )

  }


  X_raw <- X_raw[
    valid_rows,
    ,
    drop = FALSE
  ]


  data_site <- data_site[
    valid_rows,
    ,
    drop = FALSE
  ]



  # ============================================================================
  # 7.4 REMOVE RESIDUES WITHOUT VARIATION
  # ============================================================================

  variable_residues <- apply(

    X_raw,

    2,

    function(x) {

      sd(
        x
      ) > 0

    }

  )


  X_raw <- X_raw[
    ,
    variable_residues,
    drop = FALSE
  ]


  if (ncol(X_raw) < 2) {

    stop(
      paste0(
        "Fewer than two variable residues remain for site: ",
        site_name
      ),
      call. = FALSE
    )

  }



  # ============================================================================
  # 7.5 RELATIVE ABUNDANCE
  # ============================================================================

  X_relative <- X_raw /
    rowSums(
      X_raw
    )



  # ============================================================================
  # 7.6 HELLINGER TRANSFORMATION
  # ============================================================================

  X_hellinger <- sqrt(
    X_relative
  )



  # ============================================================================
  # 7.7 PCA
  # ============================================================================

  pca <- prcomp(

    X_hellinger,

    center =
      TRUE,

    scale. =
      FALSE

  )



  # ============================================================================
  # 7.8 EXPLAINED VARIANCE
  # ============================================================================

  eigenvalues <- pca$sdev^2


  variance_percent <- (

    eigenvalues /

      sum(
        eigenvalues
      )

  ) * 100


  cumulative_percent <- cumsum(
    variance_percent
  )


  variance_table <- data.frame(

    site =
      site_name,

    PC =
      paste0(
        "PC",
        seq_along(
          eigenvalues
        )
      ),

    eigenvalue =
      eigenvalues,

    variance_percent =
      variance_percent,

    cumulative_percent =
      cumulative_percent,

    stringsAsFactors =
      FALSE

  )



  # ============================================================================
  # 7.9 PCA SCORES
  # ============================================================================

  score_matrix <- as.data.frame(
    pca$x
  )


  scores_all <- cbind(

    data_site[
      ,
      c(
        "site",
        "compound",
        "affinity",
        "pose_ID"
      ),
      drop = FALSE
    ],

    score_matrix

  )



  # ============================================================================
  # 7.10 PCA LOADINGS
  # ============================================================================

  loading_matrix <- as.data.frame(
    pca$rotation
  )


  loadings_all <- data.frame(

    site =
      site_name,

    residue =
      rownames(
        pca$rotation
      ),

    loading_matrix,

    row.names =
      NULL,

    check.names =
      FALSE,

    stringsAsFactors =
      FALSE

  )



  # ============================================================================
  # 7.11 PC1-PC2 MAGNITUDE
  # ============================================================================

  loadings_PC12 <- loadings_all %>%

    mutate(

      abs_PC1 =
        abs(
          PC1
        ),

      abs_PC2 =
        abs(
          PC2
        ),

      contribution_PC12 =
        sqrt(
          PC1^2 +
            PC2^2
        )

    ) %>%

    arrange(
      desc(
        contribution_PC12
      )
    )



  # ============================================================================
  # 7.12 RESIDUE CONTRIBUTION TO PC1 AND PC2
  # ============================================================================

  PC1_denominator <- sum(
    loadings_all$PC1^2,
    na.rm = TRUE
  )


  PC2_denominator <- sum(
    loadings_all$PC2^2,
    na.rm = TRUE
  )


  PC1_variance <- variance_table$variance_percent[
    variance_table$PC == "PC1"
  ][1]


  PC2_variance <- variance_table$variance_percent[
    variance_table$PC == "PC2"
  ][1]



  chord_nodes <- data.frame(

    site =
      site_name,

    residue =
      loadings_all$residue,

    PC1_loading =
      loadings_all$PC1,

    PC1_abs_loading =
      abs(
        loadings_all$PC1
      ),

    PC1_direction =
      ifelse(
        loadings_all$PC1 >= 0,
        "Positive",
        "Negative"
      ),

    PC1_contribution_percent =
      (
        loadings_all$PC1^2 /
          PC1_denominator
      ) *
      100,

    PC1_variance_percent =
      PC1_variance,

    PC2_loading =
      loadings_all$PC2,

    PC2_abs_loading =
      abs(
        loadings_all$PC2
      ),

    PC2_direction =
      ifelse(
        loadings_all$PC2 >= 0,
        "Positive",
        "Negative"
      ),

    PC2_contribution_percent =
      (
        loadings_all$PC2^2 /
          PC2_denominator
      ) *
      100,

    PC2_variance_percent =
      PC2_variance,

    PC1_PC2_magnitude =
      sqrt(
        loadings_all$PC1^2 +
          loadings_all$PC2^2
      ),

    stringsAsFactors =
      FALSE

  )



  chord_nodes$total_PC12_contribution <-

    chord_nodes$PC1_contribution_percent +

    chord_nodes$PC2_contribution_percent



  # ============================================================================
  # 7.13 RESIDUE-RESIDUE CORRELATIONS
  #
  # Calculated from SAME Hellinger matrix used in PCA.
  # ============================================================================

  chord_edges <- calculate_residue_correlations(

    X =
      X_hellinger,

    site_name =
      site_name

  )



  # ============================================================================
  # 7.14 ADD PCA INFORMATION TO EACH EDGE
  # ============================================================================

  idx_1 <- match(
    chord_edges$residue_1,
    chord_nodes$residue
  )


  idx_2 <- match(
    chord_edges$residue_2,
    chord_nodes$residue
  )



  chord_edges$residue_1_PC1_loading <-
    chord_nodes$PC1_loading[
      idx_1
    ]


  chord_edges$residue_1_PC1_contribution_percent <-
    chord_nodes$PC1_contribution_percent[
      idx_1
    ]


  chord_edges$residue_1_PC2_loading <-
    chord_nodes$PC2_loading[
      idx_1
    ]


  chord_edges$residue_1_PC2_contribution_percent <-
    chord_nodes$PC2_contribution_percent[
      idx_1
    ]



  chord_edges$residue_2_PC1_loading <-
    chord_nodes$PC1_loading[
      idx_2
    ]


  chord_edges$residue_2_PC1_contribution_percent <-
    chord_nodes$PC1_contribution_percent[
      idx_2
    ]


  chord_edges$residue_2_PC2_loading <-
    chord_nodes$PC2_loading[
      idx_2
    ]


  chord_edges$residue_2_PC2_contribution_percent <-
    chord_nodes$PC2_contribution_percent[
      idx_2
    ]



  # ============================================================================
  # 7.15 COMPOUND CENTROIDS
  # ============================================================================

  centroids <- scores_all %>%

    group_by(
      site,
      compound
    ) %>%

    summarise(

      n =
        n(),

      PC1 =
        mean(
          PC1,
          na.rm = TRUE
        ),

      PC2 =
        mean(
          PC2,
          na.rm = TRUE
        ),

      .groups =
        "drop"

    )



  # ============================================================================
  # 7.16 RETURN
  # ============================================================================

  return(

    list(

      site =
        site_name,

      pca =
        pca,

      variance =
        variance_table,

      scores =
        scores_all,

      loadings =
        loadings_all,

      loadings_PC12 =
        loadings_PC12,

      centroids =
        centroids,

      fingerprint_raw =
        X_raw,

      fingerprint_hellinger =
        X_hellinger,

      chord_edges =
        chord_edges,

      chord_nodes =
        chord_nodes

    )

  )

}




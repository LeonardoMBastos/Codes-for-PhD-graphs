# ==============================================================================
# 8. FUNCTION — BUILD INTERACTION FINGERPRINT + PCA
# ==============================================================================

run_pca_site <- function(
    data,
    site_name
) {

  data_site <- data %>%
    filter(
      site == site_name
    ) %>%
    mutate(
      .pose_row = row_number()
    )

  if (nrow(data_site) < 3) {

    stop(
      "Too few observations for site: ",
      site_name
    )
  }


  # ---------------------------------------------------------------------------
  # Parse Top residues
  # ---------------------------------------------------------------------------

  fingerprint_long <- data_site %>%

    select(
      .pose_row,
      `Top residues`
    ) %>%

    separate_rows(
      `Top residues`,
      sep = ";\\s*"
    ) %>%

    mutate(

      residue = str_extract(
        `Top residues`,
        "^[^ ]+"
      ),

      interaction_count = as.numeric(
        str_match(
          `Top residues`,
          "\\((\\d+)\\)"
        )[, 2]
      )
    ) %>%

    filter(
      !is.na(residue),
      !is.na(interaction_count)
    )


  if (nrow(fingerprint_long) == 0) {

    stop(
      "No residue-interaction fingerprints could be parsed for site: ",
      site_name
    )
  }


  # ---------------------------------------------------------------------------
  # Pose × residue matrix
  # ---------------------------------------------------------------------------

  fingerprint_wide <- fingerprint_long %>%

    select(
      .pose_row,
      residue,
      interaction_count
    ) %>%

    pivot_wider(

      names_from = residue,

      values_from = interaction_count,

      values_fill = 0,

      values_fn = sum
    )


  fingerprint_wide <- data_site %>%

    select(
      .pose_row
    ) %>%

    left_join(
      fingerprint_wide,
      by = ".pose_row"
    )


  fingerprint_wide[
    is.na(fingerprint_wide)
  ] <- 0


  X <- as.matrix(
    fingerprint_wide[
      ,
      -1,
      drop = FALSE
    ]
  )


  # ---------------------------------------------------------------------------
  # Remove poses without residue information
  # ---------------------------------------------------------------------------

  valid_rows <- rowSums(X) > 0


  if (any(!valid_rows)) {

    warning(
      sum(!valid_rows),
      " pose(s) removed from site ",
      site_name,
      " because no residue interactions were parsed."
    )
  }


  X <- X[
    valid_rows,
    ,
    drop = FALSE
  ]


  data_site <- data_site[
    valid_rows,
    ,
    drop = FALSE
  ]


  # ---------------------------------------------------------------------------
  # Remove residues without variation
  # ---------------------------------------------------------------------------

  variable_residues <- apply(
    X,
    2,
    function(x) stats::sd(x) > 0
  )


  X <- X[
    ,
    variable_residues,
    drop = FALSE
  ]


  if (ncol(X) < 2) {

    stop(
      "Fewer than two variable residues remain for site: ",
      site_name
    )
  }


  # ---------------------------------------------------------------------------
  # Row-wise normalisation
  # ---------------------------------------------------------------------------

  X_relative <- X / rowSums(X)


  # ---------------------------------------------------------------------------
  # Hellinger transformation
  # ---------------------------------------------------------------------------

  X_hellinger <- sqrt(
    X_relative
  )


  # ---------------------------------------------------------------------------
  # PCA
  # ---------------------------------------------------------------------------

  pca <- prcomp(

    X_hellinger,

    center = TRUE,

    scale. = FALSE
  )


  # ---------------------------------------------------------------------------
  # Explained variance
  # ---------------------------------------------------------------------------

  variance_percent <- (

    pca$sdev^2 /

      sum(
        pca$sdev^2
      )

  ) * 100


  cumulative_percent <- cumsum(
    variance_percent
  )


  variance_table <- data.frame(

    site = site_name,

    PC = paste0(
      "PC",
      seq_along(
        variance_percent
      )
    ),

    eigenvalue = pca$sdev^2,

    variance_percent = variance_percent,

    cumulative_percent = cumulative_percent,

    stringsAsFactors = FALSE
  )


  # ---------------------------------------------------------------------------
  # Scores
  # ---------------------------------------------------------------------------

  score_matrix <- as.data.frame(
    pca$x
  )


  scores_all <- bind_cols(

    data_site %>%
      select(
        site,
        compound,
        affinity,
        pose_ID
      ),

    score_matrix
  )


  # ---------------------------------------------------------------------------
  # Loadings
  # ---------------------------------------------------------------------------

  loading_matrix <- as.data.frame(
    pca$rotation
  )


  loadings_all <- data.frame(

    site = site_name,

    residue = rownames(
      pca$rotation
    ),

    loading_matrix,

    row.names = NULL,

    check.names = FALSE
  )


  # ---------------------------------------------------------------------------
  # PC1-PC2 contribution
  # ---------------------------------------------------------------------------

  loadings_PC12 <- loadings_all %>%

    mutate(

      abs_PC1 = abs(
        PC1
      ),

      abs_PC2 = abs(
        PC2
      ),

      contribution_PC12 = sqrt(
        PC1^2 + PC2^2
      )
    ) %>%

    arrange(
      desc(
        contribution_PC12
      )
    )


  # ---------------------------------------------------------------------------
  # Compound centroids
  # ---------------------------------------------------------------------------

  centroids <- scores_all %>%

    group_by(
      site,
      compound
    ) %>%

    summarise(

      n = n(),

      PC1 = mean(
        PC1,
        na.rm = TRUE
      ),

      PC2 = mean(
        PC2,
        na.rm = TRUE
      ),

      .groups = "drop"
    )


  return(

    list(

      site = site_name,

      pca = pca,

      variance = variance_table,

      scores = scores_all,

      loadings = loadings_all,

      loadings_PC12 = loadings_PC12,

      centroids = centroids,

      fingerprint = X_hellinger
    )
  )
}



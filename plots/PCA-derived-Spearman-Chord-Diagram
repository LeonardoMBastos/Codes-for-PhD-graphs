draw_main_chord <- function(
    site_name
) {


  plot_data <- prepare_site_plot(
    site_name
  )


  edges_plot <-
    plot_data$edges


  nodes_plot <-
    plot_data$nodes


  residue_order <-
    plot_data$order


  gap_after <-
    plot_data$gap_after



  par(

    mar = c(
      0.5,
      0.5,
      3.4,
      0.5
    ),

    xpd =
      NA,

    family =
      font_family

  )


  circos.clear()



  circos.par(

    start.degree =
      90,

    gap.after =
      gap_after,

    track.margin =
      c(
        0.003,
        0.003
      ),

    cell.padding =
      c(
        0,
        0,
        0,
        0
      ),

    points.overflow.warning =
      FALSE

  )



  link_data <- data.frame(

    from =
      edges_plot$residue_1,

    to =
      edges_plot$residue_2,

    value =
      edges_plot$pearson_abs,

    stringsAsFactors =
      FALSE

  )



  link_colours <- grDevices::adjustcolor(

    edges_plot$link_colour,

    alpha.f =
      0.78

  )



  chordDiagram(

    x =
      link_data,

    order =
      residue_order,

    col =
      link_colours,

    transparency =
      0,

    directional =
      0,

    annotationTrack =
      NULL,

    preAllocateTracks =
      list(

        list(
          track.height = 0.22
        ),

        # PC1
        list(
          track.height = 0.055
        ),

        # PC2
        list(
          track.height = 0.055
        )

      ),

    link.sort =
      TRUE,

    link.decreasing =
      TRUE,

    link.border =
      NA

  )



  # ---------------------------------------------------------------------------
  # RESIDUE LABELS
  # ---------------------------------------------------------------------------

  circos.trackPlotRegion(

    track.index =
      1,

    bg.border =
      NA,

    bg.col =
      NA,

    panel.fun = function(
        x,
        y
    ) {


      residue_name <-
        CELL_META$sector.index



      circos.text(

        x =
          CELL_META$xcenter,

        y =
          mean(
            CELL_META$ylim
          ),

        labels =
          residue_name,

        facing =
          "bending.outside",

        niceFacing =
          TRUE,

        adj =
          c(
            0.5,
            0.5
          ),

        cex =
          0.78,

        font =
          2,

        family =
          font_family

      )

    }

  )



  # ---------------------------------------------------------------------------
  # OUTER RING — PC1
  # ---------------------------------------------------------------------------

  circos.trackPlotRegion(

    track.index =
      2,

    bg.border =
      NA,

    bg.col =
      NA,

    panel.fun = function(
        x,
        y
    ) {


      residue_name <-
        CELL_META$sector.index


      idx <- match(

        residue_name,

        nodes_plot$residue

      )


      loading_value <-

        nodes_plot$PC1_loading[
          idx
        ]



      circos.rect(

        CELL_META$xlim[1],

        CELL_META$ylim[1],

        CELL_META$xlim[2],

        CELL_META$ylim[2],

        col =
          PC1_loading_col_fun(
            loading_value
          ),

        border =
          "white",

        lwd =
          1.1

      )

    }

  )



  # ---------------------------------------------------------------------------
  # INNER RING — PC2
  # ---------------------------------------------------------------------------

  circos.trackPlotRegion(

    track.index =
      3,

    bg.border =
      NA,

    bg.col =
      NA,

    panel.fun = function(
        x,
        y
    ) {


      residue_name <-
        CELL_META$sector.index


      idx <- match(

        residue_name,

        nodes_plot$residue

      )


      loading_value <-

        nodes_plot$PC2_loading[
          idx
        ]



      circos.rect(

        CELL_META$xlim[1],

        CELL_META$ylim[1],

        CELL_META$xlim[2],

        CELL_META$ylim[2],

        col =
          PC2_loading_col_fun(
            loading_value
          ),

        border =
          "white",

        lwd =
          1.1

      )

    }

  )



  title(

    main =
      site_titles[[site_name]],

    cex.main =
      1.35,

    font.main =
      2,

    family =
      font_family,

    line =
      1.1

  )



  mtext(

    "Outer ring = PC1 loading    |    Inner ring = PC2 loading",

    side =
      3,

    line =
      0.05,

    cex =
      0.72,

    family =
      font_family,

    col =
      "#555555"

  )



  circos.clear()

}



# ==============================================================================
# 18. GRADIENT LEGEND
# ==============================================================================

draw_gradient_bar <- function(
    x_left,
    x_right,
    y_bottom,
    y_top,
    colour_function,
    title_text
) {


  gradient_values <- seq(
    -1,
    1,
    length.out =
      300
  )


  x_breaks <- seq(

    x_left,

    x_right,

    length.out =
      length(
        gradient_values
      ) + 1

  )



  for (
    i in seq_along(
      gradient_values
    )
  ) {


    rect(

      x_breaks[i],

      y_bottom,

      x_breaks[i + 1],

      y_top,

      col =
        colour_function(
          gradient_values[i]
        ),

      border =
        NA

    )

  }



  rect(

    x_left,

    y_bottom,

    x_right,

    y_top,

    border =
      "#777777",

    lwd =
      0.8

  )



  text(

    (
      x_left +
        x_right
    ) /
      2,

    y_top +
      0.10,

    labels =
      title_text,

    cex =
      0.98,

    font =
      2,

    family =
      font_family

  )



  text(

    c(
      x_left,
      (
        x_left +
          x_right
      ) /
        2,
      x_right
    ),

    y_bottom -
      0.055,

    labels =
      c(
        "-1",
        "0",
        "1"
      ),

    cex =
      0.82,

    family =
      font_family

  )

}



# ==============================================================================
# 19. BOTTOM LEGENDS
# ==============================================================================

draw_bottom_legends <- function(
    site_name
) {


  plot.new()


  plot.window(

    xlim =
      c(
        0,
        1
      ),

    ylim =
      c(
        0,
        1
      ),

    xaxs =
      "i",

    yaxs =
      "i"

  )



  PC1_variance <- get_variance_percent(

    variance_all,

    site_name,

    "PC1"

  )



  PC2_variance <- get_variance_percent(

    variance_all,

    site_name,

    "PC2"

  )



  PC1_title <- paste0(

    "PC1 (",

    round(
      PC1_variance,
      1
    ),

    "% explained variance)\nOuter loading ring"

  )



  PC2_title <- paste0(

    "PC2 (",

    round(
      PC2_variance,
      1
    ),

    "% explained variance)\nInner loading ring"

  )



  # PC1
  draw_gradient_bar(

    x_left =
      0.10,

    x_right =
      0.43,

    y_bottom =
      0.62,

    y_top =
      0.75,

    colour_function =
      PC1_loading_col_fun,

    title_text =
      PC1_title

  )



  # PC2
  draw_gradient_bar(

    x_left =
      0.57,

    x_right =
      0.90,

    y_bottom =
      0.62,

    y_top =
      0.75,

    colour_function =
      PC2_loading_col_fun,

    title_text =
      PC2_title

  )



  # Pearson
  draw_gradient_bar(

    x_left =
      0.30,

    x_right =
      0.70,

    y_bottom =
      0.20,

    y_top =
      0.31,

    colour_function =
      correlation_col_fun,

    title_text =
      "Pearson correlation (r) — ribbon colour"

  )



  text(

    0.50,

    0.04,

    labels =
      paste0(

        "Only significant correlations are shown (BH-FDR ≤ ",

        maximum_FDR,

        "). Ribbon width = |r|."

      ),

    cex =
      0.76,

    family =
      font_family,

    col =
      "#444444"

  )

}




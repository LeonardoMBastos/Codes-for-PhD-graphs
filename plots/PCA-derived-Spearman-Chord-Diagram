create_safe_output_directory <- function(
    input_file
) {

  source_directory <- dirname(
    input_file
  )


  desired_directory <- file.path(
    source_directory,
    "Chord_Diagram_Output"
  )


  # ---------------------------------------------------------------------------
  # Try creating standard output directory
  # ---------------------------------------------------------------------------

  dir.create(
    desired_directory,
    recursive = TRUE,
    showWarnings = FALSE
  )


  # ---------------------------------------------------------------------------
  # Test writing
  # ---------------------------------------------------------------------------

  test_file <- file.path(
    desired_directory,
    paste0(
      "write_test_",
      Sys.getpid(),
      ".tmp"
    )
  )


  can_write <- tryCatch(

    {

      created <- file.create(
        test_file
      )


      if (isTRUE(created)) {

        unlink(
          test_file
        )

        TRUE

      } else {

        FALSE

      }

    },

    error = function(e) {
      FALSE
    }

  )


  if (can_write) {

    return(
      normalizePath(
        desired_directory,
        winslash = "/",
        mustWork = TRUE
      )
    )

  }



  # ---------------------------------------------------------------------------
  # Windows fallback — ask user for another directory
  # ---------------------------------------------------------------------------

  if (.Platform$OS.type == "windows") {

    warning(
      paste0(
        "The folder next to the Excel file is not writable.\n",
        "Please choose another output folder."
      )
    )


    selected_directory <- utils::choose.dir(

      default =
        source_directory,

      caption =
        "Choose folder for Chord Diagram outputs"

    )


    if (
      is.na(
        selected_directory
      ) ||
        selected_directory == ""
    ) {

      stop(
        "No writable output directory was selected.",
        call. = FALSE
      )

    }


    desired_directory <- file.path(
      selected_directory,
      "Chord_Diagram_Output"
    )


    dir.create(
      desired_directory,
      recursive = TRUE,
      showWarnings = FALSE
    )


    test_file <- file.path(
      desired_directory,
      "write_test.tmp"
    )


    if (
      !isTRUE(
        file.create(
          test_file
        )
      )
    ) {

      stop(
        paste0(
          "R still cannot write to:\n",
          desired_directory
        ),
        call. = FALSE
      )

    }


    unlink(
      test_file
    )


    return(
      normalizePath(
        desired_directory,
        winslash = "/",
        mustWork = TRUE
      )
    )

  }



  stop(
    paste0(
      "Unable to create a writable output directory near:\n",
      source_directory
    ),
    call. = FALSE
  )

}



# ==============================================================================
# 4. SAFE OUTPUT FILE NAME
#
# If an old file is locked, a timestamped version is used instead.
# ==============================================================================

safe_output_file <- function(
    directory,
    filename
) {

  candidate <- file.path(
    directory,
    filename
  )


  # If it does not exist, use directly
  if (!file.exists(candidate)) {

    return(candidate)

  }


  # Try deleting old output
  deleted <- tryCatch(

    {

      unlink(
        candidate,
        force = TRUE
      )

      !file.exists(
        candidate
      )

    },

    error = function(e) {
      FALSE
    }

  )


  if (deleted) {

    return(candidate)

  }


  # Existing file may be locked.
  # Generate alternative name.

  extension <- tools::file_ext(
    filename
  )


  base_name <- tools::file_path_sans_ext(
    basename(
      filename
    )
  )


  timestamp <- format(
    Sys.time(),
    "%Y%m%d_%H%M%S"
  )


  file.path(

    directory,

    paste0(
      base_name,
      "_",
      timestamp,
      ".",
      extension
    )

  )

}




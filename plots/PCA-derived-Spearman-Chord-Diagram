# ==============================================================================
# 16. PREPARE SITE PLOT
# ==============================================================================

prepare_site_plot <- function(
    site_name
) {


  edges_site <-
    analysis_results[[site_name]]$edges


  nodes_site <-
    analysis_results[[site_name]]$nodes



  edges_sig <- edges_site[

    is.finite(
      edges_site$pearson_r
    ) &

      is.finite(
        edges_site$pearson_FDR
      ) &

      edges_site$pearson_FDR <=
        maximum_FDR &

      edges_site$pearson_abs >=
        min_abs_correlation,

    ,

    drop = FALSE

  ]



  if (
    nrow(edges_sig) == 0
  ) {

    stop(
      paste0(
        site_name,
        ": no significant Pearson correlations survived."
      ),
      call. = FALSE
    )

  }



  significant_residues <- unique(

    c(

      edges_sig$residue_1,

      edges_sig$residue_2

    )

  )



  nodes_sig <- nodes_site[

    nodes_site$residue %in%
      significant_residues,

    ,

    drop = FALSE

  ]



  nodes_sig <- nodes_sig[

    order(
      -nodes_sig$total_PC12_contribution
    ),

    ,

    drop = FALSE

  ]



  nodes_selected <- head(

    nodes_sig,

    top_n_residues

  )



  selected_residues <-
    nodes_selected$residue



  edges_plot <- edges_sig[

    edges_sig$residue_1 %in%
      selected_residues &

      edges_sig$residue_2 %in%
      selected_residues,

    ,

    drop = FALSE

  ]



  if (
    nrow(edges_plot) == 0
  ) {

    stop(
      paste0(
        site_name,
        ": no significant correlation remained among selected residues."
      ),
      call. = FALSE
    )

  }



  residues_used <- unique(

    c(

      edges_plot$residue_1,

      edges_plot$residue_2

    )

  )



  nodes_plot <- nodes_selected[

    nodes_selected$residue %in%
      residues_used,

    ,

    drop = FALSE

  ]



  component_order <- ifelse(

    nodes_plot$dominant_component ==
      "PC2",

    1,

    2

  )



  nodes_plot <- nodes_plot[

    order(

      component_order,

      nodes_plot$loading_angle

    ),

    ,

    drop = FALSE

  ]



  residue_order <-
    nodes_plot$residue



  gap_after <- make_gap_after(

    nodes_plot$dominant_component,

    small_gap =
      2.5,

    large_gap =
      12,

    final_gap =
      12

  )



  edges_plot$link_colour <-

    correlation_col_fun(

      edges_plot$pearson_r

    )



  list(

    edges =
      edges_plot,

    nodes =
      nodes_plot,

    order =
      residue_order,

    gap_after =
      gap_after

  )

}



# ==============================================================================

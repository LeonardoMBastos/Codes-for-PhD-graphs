# ==============================================================================
# 2. HELPER FUNCTIONS
# ==============================================================================

safe_num <- function(x) {

  as.numeric(
    gsub(
      ",",
      ".",
      as.character(x),
      fixed = TRUE
    )
  )

}



get_pc_columns <- function(df) {

  pcs <- grep(
    "^PC[0-9]+$",
    names(df),
    value = TRUE
  )


  pcs[
    order(
      as.integer(
        sub(
          "^PC",
          "",
          pcs
        )
      )
    )
  ]

}



get_variance_percent <- function(
    variance_df,
    site_name,
    pc_name
) {

  idx <- which(
    variance_df$site == site_name &
      variance_df$PC == pc_name
  )


  if (length(idx) == 0) {
    return(NA_real_)
  }


  safe_num(
    variance_df$variance_percent[idx[1]]
  )

}



make_gap_after <- function(
    group_vector,
    small_gap = 2.5,
    large_gap = 11,
    final_gap = 11
) {

  n <- length(group_vector)


  if (n == 0) {
    return(numeric(0))
  }


  gaps <- rep(
    small_gap,
    n
  )


  if (n > 1) {

    changes <- which(
      group_vector[-n] !=
        group_vector[-1]
    )


    if (length(changes) > 0) {
      gaps[changes] <- large_gap
    }

  }


  gaps[n] <- final_gap


  gaps

}




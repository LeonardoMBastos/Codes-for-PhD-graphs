# ==============================================================================
# 12. CALCULATE PCA NODE INFORMATION
# ==============================================================================

calculate_nodes <- function(
    site_name
) {


  load_site <- loadings_all[
    loadings_all$site == site_name,
    ,
    drop = FALSE
  ]


  if (nrow(load_site) < 2) {

    stop(
      paste0(
        "Too few residues for site: ",
        site_name
      ),
      call. = FALSE
    )

  }


  pc1 <- safe_num(
    load_site$PC1
  )


  pc2 <- safe_num(
    load_site$PC2
  )


  if (
    any(!is.finite(pc1)) ||
      any(!is.finite(pc2))
  ) {

    stop(
      paste0(
        "Non-finite PC1/PC2 loadings for site: ",
        site_name
      ),
      call. = FALSE
    )

  }


  den1 <- sum(
    pc1^2
  )


  den2 <- sum(
    pc2^2
  )


  node_table <- data.frame(

    site =
      site_name,

    residue =
      load_site$residue,

    PC1_loading =
      pc1,

    PC2_loading =
      pc2,

    PC1_contribution_percent =
      (
        pc1^2 /
          den1
      ) *
      100,

    PC2_contribution_percent =
      (
        pc2^2 /
          den2
      ) *
      100,

    stringsAsFactors =
      FALSE

  )


  node_table$total_PC12_contribution <-

    node_table$PC1_contribution_percent +

    node_table$PC2_contribution_percent



  node_table$dominant_component <- ifelse(

    node_table$PC2_contribution_percent >
      node_table$PC1_contribution_percent,

    "PC2",

    "PC1"

  )



  node_table$loading_angle <- atan2(

    node_table$PC2_loading,

    node_table$PC1_loading

  )


  node_table

}



# ==============================================================================
# 13. RECONSTRUCT PCA INPUT MATRIX
# ==============================================================================

reconstruct_fingerprint <- function(
    site_name
) {


  scores_site <- scores_all[
    scores_all$site == site_name,
    ,
    drop = FALSE
  ]


  load_site <- loadings_all[
    loadings_all$site == site_name,
    ,
    drop = FALSE
  ]


  common_pcs <- intersect(

    get_pc_columns(
      scores_site
    ),

    get_pc_columns(
      load_site
    )

  )


  valid_pcs <- common_pcs[

    vapply(

      common_pcs,

      function(pc) {

        s <- safe_num(
          scores_site[[pc]]
        )


        l <- safe_num(
          load_site[[pc]]
        )


        all(
          is.finite(s)
        ) &&
          all(
            is.finite(l)
          )

      },

      logical(1)

    )

  ]


  if (length(valid_pcs) < 2) {

    stop(
      paste0(
        "Fewer than two valid PCs for site: ",
        site_name
      ),
      call. = FALSE
    )

  }



  score_matrix <- as.matrix(

    scores_site[
      ,
      valid_pcs,
      drop = FALSE
    ]

  )


  loading_matrix <- as.matrix(

    load_site[
      ,
      valid_pcs,
      drop = FALSE
    ]

  )


  storage.mode(
    score_matrix
  ) <- "double"


  storage.mode(
    loading_matrix
  ) <- "double"



  X_centered <-

    score_matrix %*%

    t(
      loading_matrix
    )



  X_centered <- round(

    X_centered,

    digits =
      reconstruction_digits

  )


  colnames(
    X_centered
  ) <- load_site$residue


  X_centered

}



# ==============================================================================
# 14. CALCULATE PEARSON CORRELATIONS
# ==============================================================================

calculate_site_correlations <- function(
    site_name
) {


  X <- reconstruct_fingerprint(
    site_name
  )


  nodes <- calculate_nodes(
    site_name
  )


  residues <- colnames(
    X
  )


  pair_idx <- combn(
    seq_along(residues),
    2
  )


  results <- vector(
    "list",
    ncol(pair_idx)
  )



  for (
    k in seq_len(
      ncol(pair_idx)
    )
  ) {


    i <- pair_idx[
      1,
      k
    ]


    j <- pair_idx[
      2,
      k
    ]


    x <- X[
      ,
      i
    ]


    y <- X[
      ,
      j
    ]



    pearson_test <- tryCatch(

      suppressWarnings(

        cor.test(
          x,
          y,
          method = "pearson"
        )

      ),

      error = function(e) {
        NULL
      }

    )



    if (
      is.null(
        pearson_test
      )
    ) {

      r <- NA_real_

      p <- NA_real_

    } else {

      r <- unname(
        pearson_test$estimate
      )

      p <- pearson_test$p.value

    }



    results[[k]] <- data.frame(

      site =
        site_name,

      residue_1 =
        residues[i],

      residue_2 =
        residues[j],

      n =
        length(x),

      pearson_r =
        r,

      pearson_abs =
        abs(r),

      pearson_p =
        p,

      stringsAsFactors =
        FALSE

    )

  }



  edges <- do.call(
    rbind,
    results
  )



  edges$pearson_FDR <- p.adjust(

    edges$pearson_p,

    method =
      "BH"

  )



  list(

    edges =
      edges,

    nodes =
      nodes

  )

}




# ============================================================
# CORRELATION HEATMAP — DOCKANALYZER
# Google Colab version
#
# Variables:
#   Affinity
#   RMSD
#   Score
#   Contacts
#   Hydrophobic
#   H-bonds
#   Clashes
#
# Correlation method = Spearman (rho)
#
# Color scale:
#   -1 = Blue
#    0 = Turquoise / blue-green
#   +1 = Green
#
# Palette inspired by Viridis
# ============================================================

import os
import glob
import re

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from matplotlib.colors import LinearSegmentedColormap


# ============================================================
# 1. CONFIGURATION
# ============================================================

INPUT_FOLDER = "/content"

PNG_FILE = "/content/correlation_heatmap.png"
SVG_FILE = "/content/correlation_heatmap.svg"
CSV_OUTPUT = "/content/spearman_correlation_matrix.csv"

# Figure size
FIG_WIDTH = 18
FIG_HEIGHT = 15

# Font sizes
TITLE_SIZE = 26
TICK_LABEL_SIZE = 22
CELL_TEXT_SIZE = 20
COLORBAR_LABEL_SIZE = 22
COLORBAR_TICK_SIZE = 20

# Spacing
TITLE_PAD = 28
COLORBAR_PAD = 0.045
COLORBAR_LABEL_PAD = 22

# Correlation method
CORRELATION_METHOD = "spearman"

# Correlation limits
CORRELATION_MIN = -1
CORRELATION_MAX = 1


# ============================================================
# 2. CUSTOM BLUE → TURQUOISE → GREEN COLOR SCALE
# ============================================================

# Palette inspired by the blue/green portion of Viridis:
#
# -1.0 = blue
#  0.0 = turquoise / blue-green
# +1.0 = green

COLORMAP = LinearSegmentedColormap.from_list(
    "blue_turquoise_green",
    [
        "#31688E",  # Blue      = -1
        "#21918C",  # Turquoise =  0
        "#35B779",  # Green     = +1
    ],
    N=256
)


# ============================================================
# 3. GLOBAL FONT SETTINGS
# ============================================================

plt.rcParams.update({
    "font.size": 16,
    "axes.titlesize": TITLE_SIZE,
    "xtick.labelsize": TICK_LABEL_SIZE,
    "ytick.labelsize": TICK_LABEL_SIZE,
})


# ============================================================
# 4. NORMALIZE COLUMN NAMES
# ============================================================

def normalize_column_name(name):

    return re.sub(
        r"[^a-z0-9]",
        "",
        str(name).strip().lower()
    )


# ============================================================
# 5. COLUMN ALIASES
# ============================================================

COLUMN_ALIASES = {

    "Affinity": [
        "affinity",
        "afinidade"
    ],

    "RMSD": [
        "rmsd",
        "rsmd"
    ],

    "Score": [
        "score"
    ],

    "Contacts": [
        "contacts"
    ],

    "Hydrophobic": [
        "hydrophobic",
        "hydrophobicinteractions",
        "hydrophobicinteraction"
    ],

    "H-bonds": [
        "hbonds",
        "hbond",
        "hydrogenbonds",
        "hydrogenbond"
    ],

    "Clashes": [
        "clashes",
        "clash"
    ],
}


normalized_aliases = {

    variable: {
        normalize_column_name(alias)
        for alias in aliases
    }

    for variable, aliases
    in COLUMN_ALIASES.items()
}


# ============================================================
# 6. IDENTIFY REQUIRED COLUMNS
# ============================================================

def identify_columns(columns):

    normalized_columns = {

        normalize_column_name(column): column
        for column in columns
    }

    detected = {}

    for variable, aliases in normalized_aliases.items():

        for alias in aliases:

            if alias in normalized_columns:

                detected[variable] = normalized_columns[alias]
                break

    return detected


# ============================================================
# 7. CHOOSE TEXT COLOR BASED ON BACKGROUND
# ============================================================

def get_text_color_from_background(rgba_color):
    """
    Select black or white text depending on the luminance
    of the heatmap cell.
    """

    r, g, b = rgba_color[:3]

    luminance = (
        0.299 * r
        + 0.587 * g
        + 0.114 * b
    )

    if luminance < 0.52:
        return "white"

    return "black"


# ============================================================
# 8. FIND CSV FILES
# ============================================================

csv_files = glob.glob(
    os.path.join(
        INPUT_FOLDER,
        "*.csv"
    )
)


if not csv_files:

    raise FileNotFoundError(
        "No CSV file was found in /content.\n"
        "Upload the DockAnalyzer CSV using the Files panel "
        "in Google Colab."
    )


# ============================================================
# 9. FIND VALID DOCKANALYZER CSV FILES
# ============================================================

valid_csv_files = []


for file in csv_files:

    try:

        # Read only the header
        header = pd.read_csv(
            file,
            nrows=0
        )

        header.columns = [
            str(column).strip()
            for column in header.columns
        ]

        detected_columns = identify_columns(
            header.columns
        )

        # Valid only if all seven variables are present
        if len(detected_columns) == len(COLUMN_ALIASES):

            valid_csv_files.append(
                (
                    file,
                    detected_columns
                )
            )

    except Exception:

        continue


# ============================================================
# 10. CHECK VALID FILES
# ============================================================

if not valid_csv_files:

    print(
        "\nCSV files found in /content:"
    )

    for file in csv_files:

        print(
            " -",
            os.path.basename(file)
        )

    raise ValueError(
        "\nNo CSV containing all required variables was found.\n\n"
        "Required variables:\n"
        "Affinity\n"
        "RMSD or RSMD\n"
        "Score\n"
        "Contacts\n"
        "Hydrophobic\n"
        "H-bonds\n"
        "Clashes"
    )


# ============================================================
# 11. SELECT MOST RECENT VALID CSV
# ============================================================

valid_csv_files.sort(
    key=lambda x: os.path.getmtime(x[0]),
    reverse=True
)


CSV_FILE = valid_csv_files[0][0]


print(
    "\nDockAnalyzer CSV selected:"
)

print(
    os.path.basename(CSV_FILE)
)


# ============================================================
# 12. LOAD DATA
# ============================================================

df = pd.read_csv(
    CSV_FILE
)


df.columns = [
    str(column).strip()
    for column in df.columns
]


print(
    "\nNumber of poses:",
    len(df)
)

print(
    "Number of columns:",
    len(df.columns)
)


# ============================================================
# 13. IDENTIFY COLUMNS
# ============================================================

detected_columns = identify_columns(
    df.columns
)


print(
    "\nVariables detected:"
)


for variable, source_column in detected_columns.items():

    print(
        f" - {variable}: {source_column}"
    )


# ============================================================
# 14. CREATE ANALYSIS DATAFRAME
# ============================================================

analysis_df = pd.DataFrame()


for variable in COLUMN_ALIASES.keys():

    source_column = detected_columns[variable]

    analysis_df[variable] = pd.to_numeric(
        df[source_column],
        errors="coerce"
    )


# ============================================================
# 15. REMOVE MISSING VALUES
# ============================================================

initial_rows = len(
    analysis_df
)


analysis_df = analysis_df.dropna(
    subset=list(
        COLUMN_ALIASES.keys()
    )
).reset_index(
    drop=True
)


removed_rows = (
    initial_rows
    -
    len(analysis_df)
)


print(
    "\nRows used for correlation:",
    len(analysis_df)
)


if removed_rows > 0:

    print(
        "Rows removed because of missing/non-numeric values:",
        removed_rows
    )


if analysis_df.empty:

    raise ValueError(
        "No complete numeric observations are available "
        "for the correlation analysis."
    )


# ============================================================
# 16. CHECK VARIABLE VARIANCE
# ============================================================

constant_variables = [

    column

    for column in analysis_df.columns

    if analysis_df[column].nunique() <= 1
]


if constant_variables:

    print(
        "\nWARNING:"
    )

    print(
        "The following variables have no variance:"
    )

    for variable in constant_variables:

        print(
            f" - {variable}"
        )

    print(
        "\nCorrelations involving these variables "
        "will be undefined."
    )


# ============================================================
# 17. CALCULATE SPEARMAN CORRELATION MATRIX
# ============================================================

correlation_matrix = analysis_df.corr(
    method=CORRELATION_METHOD
)


print(
    "\nSpearman correlation matrix:"
)


print(
    correlation_matrix.round(3)
)


# ============================================================
# 18. SAVE CORRELATION MATRIX
# ============================================================

correlation_matrix.to_csv(
    CSV_OUTPUT
)


# ============================================================
# 19. CREATE FIGURE
# ============================================================

fig, ax = plt.subplots(
    figsize=(
        FIG_WIDTH,
        FIG_HEIGHT
    ),
    facecolor="white"
)


ax.set_facecolor(
    "white"
)


# ============================================================
# 20. PREPARE MATRIX
# ============================================================

matrix_values = np.ma.masked_invalid(
    correlation_matrix.values
)


cmap = COLORMAP.copy()


# Undefined values
cmap.set_bad(
    color="#F2F2F2"
)


# ============================================================
# 21. CREATE HEATMAP
# ============================================================

heatmap = ax.imshow(
    matrix_values,
    cmap=cmap,
    vmin=CORRELATION_MIN,
    vmax=CORRELATION_MAX,
    interpolation="nearest",
    aspect="equal"
)


# ============================================================
# 22. AXIS LABELS
# ============================================================

variables = list(
    correlation_matrix.columns
)


ax.set_xticks(
    np.arange(
        len(variables)
    )
)


ax.set_yticks(
    np.arange(
        len(variables)
    )
)


ax.set_xticklabels(
    variables,
    fontsize=TICK_LABEL_SIZE,
    rotation=35,
    ha="right",
    rotation_mode="anchor"
)


ax.set_yticklabels(
    variables,
    fontsize=TICK_LABEL_SIZE
)


# ============================================================
# 23. TITLE
# ============================================================

ax.set_title(
    "Correlation between docking metrics",
    fontsize=TITLE_SIZE,
    pad=TITLE_PAD
)


# ============================================================
# 24. ADD CORRELATION VALUES
# ============================================================

for i in range(
    len(variables)
):

    for j in range(
        len(variables)
    ):

        value = correlation_matrix.iloc[
            i,
            j
        ]


        if pd.isna(value):

            text = "NA"
            text_color = "black"

        else:

            text = f"{value:.2f}"

            scaled_value = (
                value - CORRELATION_MIN
            ) / (
                CORRELATION_MAX
                - CORRELATION_MIN
            )

            bg_color = cmap(
                scaled_value
            )

            text_color = (
                get_text_color_from_background(
                    bg_color
                )
            )


        ax.text(
            j,
            i,
            text,
            ha="center",
            va="center",
            fontsize=CELL_TEXT_SIZE,
            fontweight="bold",
            color=text_color
        )


# ============================================================
# 25. REMOVE GRID
# ============================================================

ax.grid(
    False
)


# ============================================================
# 26. REMOVE TICK MARKS
# ============================================================

ax.tick_params(
    axis="both",
    which="both",
    length=0,
    pad=12
)


# ============================================================
# 27. REMOVE OUTER BORDERS
# ============================================================

for spine in ax.spines.values():

    spine.set_visible(
        False
    )


# ============================================================
# 28. COLORBAR
# ============================================================

cbar = fig.colorbar(
    heatmap,
    ax=ax,
    pad=COLORBAR_PAD,
    fraction=0.046
)


cbar.set_label(
    "Spearman correlation (ρ)",
    fontsize=COLORBAR_LABEL_SIZE,
    labelpad=COLORBAR_LABEL_PAD
)


cbar.ax.tick_params(
    labelsize=COLORBAR_TICK_SIZE,
    length=6
)


cbar.set_ticks(
    [
        -1.0,
        -0.5,
        0.0,
        0.5,
        1.0
    ]
)


# ============================================================
# 29. COLORBAR BORDER
# ============================================================

cbar.outline.set_linewidth(
    0.8
)


# ============================================================
# 30. LAYOUT ADJUSTMENTS
# ============================================================

plt.tight_layout(
    pad=2.5
)


# ============================================================
# 31. SAVE FIGURES
# ============================================================

plt.savefig(
    PNG_FILE,
    dpi=600,
    bbox_inches="tight",
    facecolor="white"
)


plt.savefig(
    SVG_FILE,
    bbox_inches="tight",
    facecolor="white"
)


# ============================================================
# 32. SHOW FIGURE
# ============================================================

plt.show()


# ============================================================
# 33. OUTPUT
# ============================================================

print(
    "\nFiles generated:"
)

print(
    PNG_FILE
)

print(
    SVG_FILE
)

print(
    CSV_OUTPUT
)

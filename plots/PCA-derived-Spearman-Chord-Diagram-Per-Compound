prepare_group_plot <- function(
    site_name,
    compound_name
) {

  group_key <- make_group_key(
    site_name,
    compound_name
  )

  group_result <-
    analysis_results[[group_key]]

  edges_group <-
    group_result$edges

  nodes_group <-
    group_result$nodes

  edges_plot <- edges_group[
    is.finite(
      edges_group$spearman_rho
    ) &
      is.finite(
        edges_group$spearman_FDR
      ) &
      edges_group$spearman_FDR <=
        maximum_FDR &
      edges_group$spearman_abs >=
        min_abs_correlation,
    ,
    drop = FALSE
  ]

  nodes_plot <- nodes_group[
    order(
      -nodes_group$PC1_loading,
      nodes_group$residue
    ),
    ,
    drop = FALSE
  ]

  residue_order <-
    nodes_plot$residue

  if (nrow(edges_plot) > 0) {

    edges_plot$link_colour <-
      correlation_col_fun(
        edges_plot$spearman_rho
      )

  } else {

    edges_plot$link_colour <-
      character(0)
  }

  list(
    edges = edges_plot,
    all_edges = edges_group,
    nodes = nodes_plot,
    order = residue_order,
    gap_after = rep(
      sector_gap_degree,
      length(residue_order)
    ),
    n_poses = group_result$n_poses,
    PC1_variance = group_result$PC1_variance,
    PC2_variance = group_result$PC2_variance
  )
}


# ==============================================================================
# 17. RIBBON ALLOCATION
# ==============================================================================

allocate_ribbon_intervals <- function(
    edges,
    residue_order
) {

  if (nrow(edges) == 0) {

    return(
      list(
        edges = edges,
        maximum_total = 1
      )
    )
  }

  totals <- setNames(
    rep(
      0,
      length(residue_order)
    ),
    residue_order
  )

  for (k in seq_len(nrow(edges))) {

    r1 <- edges$residue_1[k]
    r2 <- edges$residue_2[k]
    w <- edges$spearman_abs[k]

    totals[r1] <-
      totals[r1] + w

    totals[r2] <-
      totals[r2] + w
  }

  maximum_total <- max(
    totals,
    na.rm = TRUE
  )

  if (
    !is.finite(maximum_total) ||
    maximum_total <= 0
  ) {
    maximum_total <- 1
  }

  cursors <- setNames(
    rep(
      0,
      length(residue_order)
    ),
    residue_order
  )

  allocation_order <- order(
    edges$spearman_abs,
    decreasing = TRUE
  )

  E <- edges[
    allocation_order,
    ,
    drop = FALSE
  ]

  E$start_1 <- NA_real_
  E$end_1 <- NA_real_
  E$start_2 <- NA_real_
  E$end_2 <- NA_real_

  for (k in seq_len(nrow(E))) {

    r1 <- E$residue_1[k]
    r2 <- E$residue_2[k]
    w <- E$spearman_abs[k]

    E$start_1[k] <-
      cursors[r1]

    E$end_1[k] <-
      cursors[r1] + w

    E$start_2[k] <-
      cursors[r2]

    E$end_2[k] <-
      cursors[r2] + w

    cursors[r1] <-
      cursors[r1] + w

    cursors[r2] <-
      cursors[r2] + w
  }

  list(
    edges = E,
    maximum_total = maximum_total
  )
}



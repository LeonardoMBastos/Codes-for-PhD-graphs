# ==============================================================================
# 7. PARSE TOP RESIDUES
# ==============================================================================

parse_top_residues <- function(x) {

  result <- numeric(0)

  if (
    is.na(x) ||
    trimws(as.character(x)) == ""
  ) {
    return(result)
  }

  pieces <- strsplit(
    as.character(x),
    ";",
    fixed = TRUE
  )[[1]]

  for (piece in pieces) {

    piece <- trimws(
      piece
    )

    # Residue label + contact value in parentheses.
    # Examples:
    # TYR210 (3)
    # TYR210:A (3.5)
    # TYR210A (2,5)
    matched <- regexec(
      "^(.+?)\\s*\\(([0-9]+(?:[\\.,][0-9]+)?)\\)$",
      piece
    )

    captured <- regmatches(
      piece,
      matched
    )[[1]]

    if (length(captured) == 3) {

      residue_name <- normalize_residue(
        captured[2]
      )

      contact_value <- safe_num(
        captured[3]
      )

      if (
        is.finite(contact_value) &&
        contact_value > 0
      ) {

        if (residue_name %in% names(result)) {

          result[residue_name] <-
            result[residue_name] +
            contact_value

        } else {

          result[residue_name] <-
            contact_value
        }
      }
    }
  }

  result
}


# ==============================================================================
# 8. BUILD POSE × RESIDUE MATRIX FOR ONE SITE × COMPOUND GROUP
# ==============================================================================

build_group_fingerprint <- function(
    site_name,
    compound_name
) {

  raw_group <- raw_data[
    raw_data$site == site_name &
      raw_data$compound == compound_name,
    ,
    drop = FALSE
  ]

  if (nrow(raw_group) == 0) {

    stop(
      paste0(
        "No observations found for ",
        site_name,
        " × ",
        compound_name,
        "."
      ),
      call. = FALSE
    )
  }

  parsed_rows <- lapply(
    raw_group$top_residues_text,
    parse_top_residues
  )

  all_residues <- sort(
    unique(
      unlist(
        lapply(
          parsed_rows,
          names
        )
      )
    )
  )

  if (length(all_residues) == 0) {

    stop(
      paste0(
        "No residues could be parsed for ",
        site_name,
        " × ",
        compound_name,
        "."
      ),
      call. = FALSE
    )
  }

  X <- matrix(
    0,
    nrow = nrow(raw_group),
    ncol = length(all_residues),
    dimnames = list(
      NULL,
      all_residues
    )
  )

  for (i in seq_along(parsed_rows)) {

    current <- parsed_rows[[i]]

    if (length(current) == 0) {
      next
    }

    X[
      i,
      names(current)
    ] <- current
  }

  row_totals <- rowSums(
    X,
    na.rm = TRUE
  )

  valid_rows <- is.finite(row_totals) &
    row_totals > 0

  if (any(!valid_rows)) {

    warning(
      paste0(
        site_name,
        " × ",
        compound_name,
        ": ",
        sum(!valid_rows),
        " pose(s) had no parsable residue contacts and were excluded."
      )
    )

    X <- X[
      valid_rows,
      ,
      drop = FALSE
    ]

    raw_group <- raw_group[
      valid_rows,
      ,
      drop = FALSE
    ]
  }

  if (nrow(X) == 0) {

    stop(
      paste0(
        "No valid poses remain for ",
        site_name,
        " × ",
        compound_name,
        "."
      ),
      call. = FALSE
    )
  }

  nonzero_columns <- colSums(
    X,
    na.rm = TRUE
  ) > 0

  X <- X[
    ,
    nonzero_columns,
    drop = FALSE
  ]

  if (ncol(X) == 0) {

    stop(
      paste0(
        "No non-zero residue columns remain for ",
        site_name,
        " × ",
        compound_name,
        "."
      ),
      call. = FALSE
    )
  }

  list(
    X = X,
    raw_group = raw_group
  )
}


# ==============================================================================
# 9. HELLINGER TRANSFORMATION
# ==============================================================================

hellinger_transform <- function(X) {

  row_totals <- rowSums(
    X,
    na.rm = TRUE
  )

  if (any(row_totals <= 0)) {

    stop(
      "At least one pose has total residue-contact count <= 0.",
      call. = FALSE
    )
  }

  relative_matrix <- X /
    row_totals

  sqrt(
    relative_matrix
  )
}


# ==============================================================================
# 10. RESIDUE FREQUENCY WITHIN ONE SITE × COMPOUND GROUP
# ==============================================================================

calculate_residue_frequency <- function(
    site_name,
    compound_name,
    X_raw
) {

  frequency_n <- colSums(
    X_raw > 0
  )

  frequency_percent <-
    frequency_n /
    nrow(X_raw) *
    100

  total_contacts <- colSums(
    X_raw
  )

  result <- data.frame(
    site = site_name,
    compound = compound_name,
    residue = colnames(X_raw),
    n_poses = nrow(X_raw),
    frequency_n = as.numeric(frequency_n),
    frequency_percent = as.numeric(frequency_percent),
    total_contacts = as.numeric(total_contacts),
    stringsAsFactors = FALSE
  )

  result <- result[
    order(
      -result$frequency_n,
      -result$total_contacts,
      result$residue
    ),
    ,
    drop = FALSE
  ]

  result$frequency_rank <-
    seq_len(
      nrow(result)
    )

  top <- head(
    result,
    min(
      top_n_residues,
      nrow(result)
    )
  )

  list(
    all = result,
    top = top
  )
}


# ==============================================================================
# 11. GROUP-SPECIFIC PCA
# ==============================================================================

calculate_group_pca <- function(
    site_name,
    compound_name,
    X_hellinger
) {

  residue_names <- colnames(
    X_hellinger
  )

  # Default values used if PCA cannot estimate two components.
  pc1_loading <- setNames(
    rep(
      0,
      length(residue_names)
    ),
    residue_names
  )

  pc2_loading <- pc1_loading

  PC1_variance <- 0
  PC2_variance <- 0

  if (
    nrow(X_hellinger) >= 2 &&
    ncol(X_hellinger) >= 1
  ) {

    pca_fit <- tryCatch(
      prcomp(
        X_hellinger,
        center = TRUE,
        scale. = FALSE
      ),
      error = function(e) {
        NULL
      }
    )

    if (!is.null(pca_fit)) {

      rotation <- pca_fit$rotation

      if (
        !is.null(rotation) &&
        ncol(rotation) >= 1
      ) {

        pc1_loading[
          rownames(rotation)
        ] <- rotation[, 1]
      }

      if (
        !is.null(rotation) &&
        ncol(rotation) >= 2
      ) {

        pc2_loading[
          rownames(rotation)
        ] <- rotation[, 2]
      }

      eigenvalues <- pca_fit$sdev^2

      total_variance <- sum(
        eigenvalues,
        na.rm = TRUE
      )

      if (
        is.finite(total_variance) &&
        total_variance > 0
      ) {

        variance_percent <-
          eigenvalues /
          total_variance *
          100

        if (length(variance_percent) >= 1) {
          PC1_variance <- variance_percent[1]
        }

        if (length(variance_percent) >= 2) {
          PC2_variance <- variance_percent[2]
        }
      }
    }
  }

  loadings <- data.frame(
    site = site_name,
    compound = compound_name,
    residue = residue_names,
    PC1_loading = as.numeric(
      pc1_loading[residue_names]
    ),
    PC2_loading = as.numeric(
      pc2_loading[residue_names]
    ),
    stringsAsFactors = FALSE
  )

  list(
    loadings = loadings,
    PC1_variance = PC1_variance,
    PC2_variance = PC2_variance
  )
}


# ==============================================================================
# 12. NODE DATA
# ==============================================================================

calculate_nodes <- function(
    site_name,
    compound_name,
    selected_residues,
    frequency_table,
    pca_result
) {

  loadings <- pca_result$loadings

  idx <- match(
    selected_residues,
    loadings$residue
  )

  if (any(is.na(idx))) {

    stop(
      paste0(
        "Selected residue missing from group PCA for ",
        site_name,
        " × ",
        compound_name,
        "."
      ),
      call. = FALSE
    )
  }

  pc1 <- safe_num(
    loadings$PC1_loading[
      idx
    ]
  )

  pc2 <- safe_num(
    loadings$PC2_loading[
      idx
    ]
  )

  all_pc1 <- safe_num(
    loadings$PC1_loading
  )

  all_pc2 <- safe_num(
    loadings$PC2_loading
  )

  den1 <- sum(
    all_pc1^2,
    na.rm = TRUE
  )

  den2 <- sum(
    all_pc2^2,
    na.rm = TRUE
  )

  pc1_contribution <- if (
    is.finite(den1) &&
    den1 > 0
  ) {
    pc1^2 / den1 * 100
  } else {
    rep(
      0,
      length(pc1)
    )
  }

  pc2_contribution <- if (
    is.finite(den2) &&
    den2 > 0
  ) {
    pc2^2 / den2 * 100
  } else {
    rep(
      0,
      length(pc2)
    )
  }

  nodes <- data.frame(
    site = site_name,
    compound = compound_name,
    residue = selected_residues,
    PC1_loading = pc1,
    PC2_loading = pc2,
    PC1_contribution_percent = pc1_contribution,
    PC2_contribution_percent = pc2_contribution,
    stringsAsFactors = FALSE
  )

  freq_idx <- match(
    nodes$residue,
    frequency_table$residue
  )

  nodes$frequency_rank <-
    frequency_table$frequency_rank[
      freq_idx
    ]

  nodes$frequency_n <-
    frequency_table$frequency_n[
      freq_idx
    ]

  nodes$frequency_percent <-
    frequency_table$frequency_percent[
      freq_idx
    ]

  nodes$total_contacts <-
    frequency_table$total_contacts[
      freq_idx
    ]

  nodes
}


# ==============================================================================
# 13. SPEARMAN ANALYSIS WITHIN ONE SITE × COMPOUND GROUP
# ==============================================================================

calculate_group_analysis <- function(
    site_name,
    compound_name
) {

  fingerprint_result <-
    build_group_fingerprint(
      site_name,
      compound_name
    )

  X_raw <-
    fingerprint_result$X

  frequency_result <-
    calculate_residue_frequency(
      site_name,
      compound_name,
      X_raw
    )

  top_frequency <-
    frequency_result$top

  selected_residues <-
    top_frequency$residue

  X_hellinger <-
    hellinger_transform(
      X_raw
    )

  pca_result <-
    calculate_group_pca(
      site_name,
      compound_name,
      X_hellinger
    )

  X_top <- X_hellinger[
    ,
    selected_residues,
    drop = FALSE
  ]

  if (length(selected_residues) < 2) {

    edges <- empty_edges_table()

  } else {

    pair_idx <- combn(
      seq_along(
        selected_residues
      ),
      2
    )

    results <- vector(
      "list",
      ncol(pair_idx)
    )

    for (k in seq_len(ncol(pair_idx))) {

      i <- pair_idx[
        1,
        k
      ]

      j <- pair_idx[
        2,
        k
      ]

      residue_1 <-
        selected_residues[i]

      residue_2 <-
        selected_residues[j]

      x <- X_top[
        ,
        i
      ]

      y <- X_top[
        ,
        j
      ]

      complete <-
        is.finite(x) &
        is.finite(y)

      x_complete <- x[
        complete
      ]

      y_complete <- y[
        complete
      ]

      n_pair <- length(
        x_complete
      )

      valid_test <-
        n_pair >= 3 &&
        length(
          unique(
            x_complete
          )
        ) >= 2 &&
        length(
          unique(
            y_complete
          )
        ) >= 2

      if (!valid_test) {

        rho <- NA_real_
        p <- NA_real_

      } else {

        test <- tryCatch(
          suppressWarnings(
            cor.test(
              x_complete,
              y_complete,
              method = "spearman",
              exact = FALSE
            )
          ),
          error = function(e) {
            NULL
          }
        )

        if (is.null(test)) {

          rho <- NA_real_
          p <- NA_real_

        } else {

          rho <- unname(
            test$estimate
          )

          p <- test$p.value
        }
      }

      results[[k]] <- data.frame(
        site = site_name,
        compound = compound_name,
        residue_1 = residue_1,
        residue_2 = residue_2,
        n = n_pair,
        spearman_rho = rho,
        spearman_abs = abs(rho),
        spearman_p = p,
        spearman_FDR = NA_real_,
        stringsAsFactors = FALSE
      )
    }

    edges <- do.call(
      rbind,
      results
    )

    valid_p <- is.finite(
      edges$spearman_p
    )

    if (any(valid_p)) {

      # IMPORTANT:
      # FDR is corrected independently within each site × compound group.
      edges$spearman_FDR[
        valid_p
      ] <- p.adjust(
        edges$spearman_p[
          valid_p
        ],
        method = "BH"
      )
    }
  }

  nodes <- calculate_nodes(
    site_name = site_name,
    compound_name = compound_name,
    selected_residues = selected_residues,
    frequency_table = top_frequency,
    pca_result = pca_result
  )

  list(
    site = site_name,
    compound = compound_name,
    n_poses = nrow(X_raw),
    raw_matrix = X_raw,
    hellinger_matrix = X_hellinger,
    frequency_all = frequency_result$all,
    frequency_top = top_frequency,
    pca_loadings = pca_result$loadings,
    PC1_variance = pca_result$PC1_variance,
    PC2_variance = pca_result$PC2_variance,
    nodes = nodes,
    edges = edges
  )
}



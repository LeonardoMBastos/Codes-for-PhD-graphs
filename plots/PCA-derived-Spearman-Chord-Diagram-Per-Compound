draw_horizontal_gradient_bottom <- function(
    x_center,
    y_bottom,
    bar_length,
    bar_height,
    colour_function,
    title_text
) {

  x_left <-
    x_center -
    bar_length / 2

  x_right <-
    x_center +
    bar_length / 2

  y_top <-
    y_bottom +
    bar_height

  gradient_values <- seq(
    -1,
    1,
    length.out = 400
  )

  x_breaks <- seq(
    x_left,
    x_right,
    length.out =
      length(
        gradient_values
      ) + 1
  )

  for (i in seq_along(gradient_values)) {

    rect(
      xleft = x_breaks[i],
      ybottom = y_bottom,
      xright = x_breaks[i + 1],
      ytop = y_top,
      col = colour_function(
        gradient_values[i]
      ),
      border = NA,
      xpd = NA
    )
  }


  text(
    x = x_center,
    y = y_top + legend_title_offset,
    labels = title_text,
    cex = legend_text_cex,
    font = 1,
    family = font_family,
    adj = c(
      0.5,
      0.5
    ),
    xpd = NA
  )

  text(
    x = c(
      x_left,
      x_center,
      x_right
    ),
    y = y_bottom - legend_tick_offset,
    labels = c(
      "-1",
      "0",
      "+1"
    ),
    cex = legend_text_cex,
    font = 1,
    family = font_family,
    adj = c(
      0.5,
      1
    ),
    xpd = NA
  )
}



draw_main_chord <- function(
    site_name,
    compound_name
) {

  plot_data <- prepare_group_plot(
    site_name,
    compound_name
  )

  edges_plot <-
    plot_data$edges

  nodes_plot <-
    plot_data$nodes

  residue_order <-
    plot_data$order

  if (length(residue_order) == 0) {

    plot.new()

    text(
      0.5,
      0.5,
      paste0(
        "No residues available for ",
        site_name,
        " × ",
        compound_name
      )
    )

    return(
      invisible(NULL)
    )
  }

  ribbon_data <- allocate_ribbon_intervals(
    edges_plot,
    residue_order
  )

  edges_allocated <-
    ribbon_data$edges

  maximum_total <-
    ribbon_data$maximum_total

  PC1_variance <-
    plot_data$PC1_variance

  PC2_variance <-
    plot_data$PC2_variance

  par(
    mar = c(
      0.4,
      0.2,
      1.2,
      0.2
    ),
    xpd = NA,
    family = font_family
  )

  circos.clear()

  circos.par(
    start.degree = 90,
    gap.after = plot_data$gap_after,
    track.margin = c(
      0.002,
      0.002
    ),
    cell.padding = c(
      0,
      0,
      0,
      0
    ),
    points.overflow.warning = FALSE,
    canvas.xlim = c(
      -1.30,
      1.30
    ),
    canvas.ylim = c(
      -1.34,
      1.08
    )
  )

  circos.initialize(
    factors = factor(
      residue_order,
      levels = residue_order
    ),
    xlim = cbind(
      rep(
        0,
        length(residue_order)
      ),
      rep(
        maximum_total,
        length(residue_order)
      )
    )
  )

  # ---------------------------------------------------------------------------
  # TRACK 1 — RESIDUE LABELS
  # ---------------------------------------------------------------------------

  circos.trackPlotRegion(
    ylim = c(
      0,
      1
    ),
    track.height =
      residue_track_height,
    bg.border = NA,
    bg.col = NA,
    panel.fun = function(
        x,
        y
    ) {

      residue_name <-
        CELL_META$sector.index

      circos.text(
        x = CELL_META$xcenter,
        y = mean(
          CELL_META$ylim
        ),
        labels = residue_name,
        facing = "bending.outside",
        niceFacing = TRUE,
        adj = c(
          0.5,
          0.5
        ),
        cex = residue_label_cex,
        font = 1,
        family = font_family
      )
    }
  )

  # ---------------------------------------------------------------------------
  # TRACK 2 — OUTER RING = GROUP-SPECIFIC PC1
  # ---------------------------------------------------------------------------

  circos.trackPlotRegion(
    ylim = c(
      0,
      1
    ),
    track.height =
      PC1_track_height,
    bg.border = NA,
    bg.col = NA,
    panel.fun = function(
        x,
        y
    ) {

      residue_name <-
        CELL_META$sector.index

      idx <- match(
        residue_name,
        nodes_plot$residue
      )

      loading_value <-
        nodes_plot$PC1_loading[
          idx
        ]

      circos.rect(
        CELL_META$xlim[1],
        CELL_META$ylim[1],
        CELL_META$xlim[2],
        CELL_META$ylim[2],
        col = loading_colour(
          loading_value
        ),
        border = "white",
        lwd = 0.7
      )
    }
  )

  # ---------------------------------------------------------------------------
  # TRACK 3 — INNER RING = GROUP-SPECIFIC PC2
  # ---------------------------------------------------------------------------

  circos.trackPlotRegion(
    ylim = c(
      0,
      1
    ),
    track.height =
      PC2_track_height,
    bg.border = NA,
    bg.col = NA,
    panel.fun = function(
        x,
        y
    ) {

      residue_name <-
        CELL_META$sector.index

      idx <- match(
        residue_name,
        nodes_plot$residue
      )

      loading_value <-
        nodes_plot$PC2_loading[
          idx
        ]

      circos.rect(
        CELL_META$xlim[1],
        CELL_META$ylim[1],
        CELL_META$xlim[2],
        CELL_META$ylim[2],
        col = loading_colour(
          loading_value
        ),
        border = "white",
        lwd = 0.7
      )
    }
  )

  # ---------------------------------------------------------------------------
  # SPEARMAN RIBBONS
  # ---------------------------------------------------------------------------

  if (nrow(edges_allocated) > 0) {

    draw_order <- order(
      edges_allocated$spearman_abs,
      decreasing = FALSE
    )

    for (k in draw_order) {

      ribbon_colour <- grDevices::adjustcolor(
        edges_allocated$link_colour[k],
        alpha.f = 0.80
      )

      circos.link(
        sector.index1 =
          edges_allocated$residue_1[k],
        point1 = c(
          edges_allocated$start_1[k],
          edges_allocated$end_1[k]
        ),
        sector.index2 =
          edges_allocated$residue_2[k],
        point2 = c(
          edges_allocated$start_2[k],
          edges_allocated$end_2[k]
        ),
        col = ribbon_colour,
        border = NA
      )
    }
  }

  # ---------------------------------------------------------------------------
  # MAIN TITLE
  # ---------------------------------------------------------------------------

  text(
    x = 0,
    y = 1.15,
    labels = paste0(
      compound_name,
      " | ",
      get_site_title(
        site_name
      )
    ),
    cex = 1.28,
    font = 2,
    family = font_family,
    adj = c(
      0.5,
      0.5
    ),
    xpd = NA
  )

  # ---------------------------------------------------------------------------
  # GROUP-SPECIFIC PCA EXPLAINED VARIANCE
  # ---------------------------------------------------------------------------

  text(
    x = PC_info_x,
    y = PC1_info_y,
    labels = paste0(
      "PC1 (outer ring): ",
      round(
        PC1_variance,
        1
      ),
      " %VE"
    ),
    cex = annotation_text_cex,
    font = 2,
    family = font_family,
    adj = c(
      0,
      0.5
    ),
    xpd = NA
  )

  text(
    x = PC_info_x,
    y = PC2_info_y,
    labels = paste0(
      "PC2 (inner ring): ",
      round(
        PC2_variance,
        1
      ),
      " %VE"
    ),
    cex = annotation_text_cex,
    font = 2,
    family = font_family,
    adj = c(
      0,
      0.5
    ),
    xpd = NA
  )

  # ---------------------------------------------------------------------------
  # BOTTOM HORIZONTAL LEGENDS
  # ---------------------------------------------------------------------------

  draw_horizontal_gradient_bottom(
    x_center =
      loading_legend_center_x,
    y_bottom =
      legend_y_bottom,
    bar_length =
      legend_bar_length,
    bar_height =
      legend_bar_height,
    colour_function =
      loading_col_fun,
    title_text =
      "Principal component loading"
  )

  draw_horizontal_gradient_bottom(
    x_center =
      correlation_legend_center_x,
    y_bottom =
      legend_y_bottom,
    bar_length =
      legend_bar_length,
    bar_height =
      legend_bar_height,
    colour_function =
      correlation_col_fun,
    # Plotmath ensures Greek rho renders correctly in PDF, PNG and TIFF.
    title_text =
      expression("Spearman correlation (" * rho * ")")
  )

  circos.clear()
}



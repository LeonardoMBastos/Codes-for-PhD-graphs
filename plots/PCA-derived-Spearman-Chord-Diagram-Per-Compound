safe_num <- function(x) {
  suppressWarnings(
    as.numeric(
      gsub(
        ",",
        ".",
        as.character(x),
        fixed = TRUE
      )
    )
  )
}


normalize_site <- function(x) {

  y <- toupper(
    trimws(
      as.character(x)
    )
  )

  y[
    y %in% c(
      "BZD",
      "BENZODIAZEPINE",
      "BENZODIAZEPINES",
      "BENZODIAZEPINE SITE",
      "BZD SITE"
    )
  ] <- "BZD"

  y[
    y %in% c(
      "BB",
      "BARBITURATE",
      "BARBITURATES",
      "BARBITURATE SITE",
      "BARBITURATES SITE"
    )
  ] <- "BB"

  y[
    y %in% c(
      "GABA",
      "GABA SITE",
      "ORTHOSTERIC",
      "ORTHOSTERIC SITE"
    )
  ] <- "GABA"

  y
}


normalize_compound <- function(x) {

  y <- toupper(
    trimws(
      as.character(x)
    )
  )

  # Standardize only well-known spelling variants.
  # Any other compound name is retained as supplied, in upper case.
  y[y %in% c("GERANIOL", "GER")] <- "GER"

  y[
    y %in% c(
      "GERANYL ACETATE",
      "GERANYL_ACETATE",
      "GERANYL-ACETATE",
      "GER AC",
      "GERAC"
    )
  ] <- "GERAC"

  y[y %in% c("DIAZEPAM", "DZP")] <- "DZP"

  y[
    y %in% c(
      "PHENOBARBITAL",
      "PHENOBARBITONE",
      "PHB"
    )
  ] <- "PHB"

  y[
    y %in% c(
      "GAMMA-AMINOBUTYRIC ACID",
      "GAMMA AMINOBUTYRIC ACID",
      "GABA"
    )
  ] <- "GABA"

  y
}


normalize_residue <- function(x) {

  toupper(
    gsub(
      "\\s+",
      "",
      trimws(
        as.character(x)
      )
    )
  )
}


normalize_column_name <- function(x) {

  tolower(
    gsub(
      "[^a-z0-9]",
      "",
      x
    )
  )
}


find_column <- function(
    df,
    candidates
) {

  normalized_names <- normalize_column_name(
    names(df)
  )

  normalized_candidates <- normalize_column_name(
    candidates
  )

  for (candidate in normalized_candidates) {

    hit <- which(
      normalized_names == candidate
    )

    if (length(hit) > 0) {
      return(
        names(df)[hit[1]]
      )
    }
  }

  NULL
}


safe_filename_component <- function(x) {

  y <- gsub(
    "[^A-Za-z0-9_-]+",
    "_",
    as.character(x)
  )

  y <- gsub(
    "_+",
    "_",
    y
  )

  y <- gsub(
    "^_|_$",
    "",
    y
  )

  ifelse(
    nchar(y) == 0,
    "NA",
    y
  )
}



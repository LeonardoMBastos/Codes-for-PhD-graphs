read_original_data <- function(path) {

  extension <- tolower(
    tools::file_ext(path)
  )

  if (extension %in% c("xlsx", "xls")) {

    return(
      openxlsx::read.xlsx(
        path,
        check.names = FALSE
      )
    )
  }

  if (extension == "csv") {

    first_try <- tryCatch(
      read.csv(
        path,
        check.names = FALSE,
        stringsAsFactors = FALSE
      ),
      error = function(e) {
        NULL
      }
    )

    if (
      !is.null(first_try) &&
      ncol(first_try) > 1
    ) {
      return(first_try)
    }

    second_try <- tryCatch(
      read.csv2(
        path,
        check.names = FALSE,
        stringsAsFactors = FALSE
      ),
      error = function(e) {
        NULL
      }
    )

    if (!is.null(second_try)) {
      return(second_try)
    }
  }

  stop(
    paste0(
      "Could not read the selected file: ",
      basename(path),
      ". Please use CSV, XLSX or XLS."
    ),
    call. = FALSE
  )
}



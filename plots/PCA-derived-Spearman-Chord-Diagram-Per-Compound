loading_colour <- function(x) {

  if (
    length(x) == 0 ||
    !is.finite(x)
  ) {
    return("#FFFFFF")
  }

  loading_col_fun(
    max(
      -1,
      min(
        1,
        x
      )
    )
  )
}



# ==============================================================================
# 15. POOLED WITHIN-GROUP COVARIANCE
# ==============================================================================

calculate_pooled_covariance <- function(
    X,
    grouping
) {


  grouping <- droplevels(
    factor(
      grouping
    )
  )


  groups <- levels(
    grouping
  )


  p <- ncol(X)


  pooled_sum <- matrix(
    0,
    nrow = p,
    ncol = p
  )


  total_df <- 0


  for (g in groups) {


    Xg <- X[
      grouping == g,
      ,
      drop = FALSE
    ]


    ng <- nrow(
      Xg
    )


    if (ng <= 1) {

      next
    }


    Sg <- cov(
      Xg
    )


    pooled_sum <-
      pooled_sum +
      (ng - 1) *
      Sg


    total_df <-
      total_df +
      (ng - 1)
  }


  if (total_df <= 0) {

    stop(
      "Unable to estimate pooled covariance matrix.",
      call. = FALSE
    )
  }


  pooled_covariance <-
    pooled_sum /
    total_df


  rownames(
    pooled_covariance
  ) <- colnames(X)


  colnames(
    pooled_covariance
  ) <- colnames(X)


  pooled_covariance
}



# ==============================================================================
# 16. SAFE COVARIANCE MATRIX INVERSE
# ==============================================================================

safe_inverse <- function(
    covariance_matrix,
    tolerance = SINGULARITY_TOLERANCE
) {


  eigenvalues <- tryCatch(

    eigen(
      covariance_matrix,
      symmetric = TRUE,
      only.values = TRUE
    )$values,

    error = function(e) {

      c(
        NA_real_
      )
    }
  )


  use_generalized_inverse <- any(
    !is.finite(
      eigenvalues
    )
  )


  if (!use_generalized_inverse) {


    if (
      min(
        abs(
          eigenvalues
        )
      ) < tolerance
    ) {

      use_generalized_inverse <- TRUE
    }
  }


  if (!use_generalized_inverse) {


    standard_inverse <- tryCatch(

      solve(
        covariance_matrix
      ),

      error = function(e) {

        NULL
      }
    )


    if (!is.null(standard_inverse)) {


      return(
        list(

          inverse =
            standard_inverse,

          method =
            "Standard matrix inverse"
        )
      )
    }
  }


  list(

    inverse =
      MASS::ginv(
        covariance_matrix
      ),

    method =
      "Generalized inverse (MASS::ginv)"
  )
}



# ==============================================================================
# 17. MAHALANOBIS DISTANCE BETWEEN PC1-PC2 CENTROIDS
# ==============================================================================

Mahalanobis_results_list <- list()

Mahalanobis_matrices <- list()

centroid_results <- list()

pooled_covariance_matrices <- list()


mahalanobis_counter <- 1



for (site_name in sites) {


  cat(
    "\n============================================================\n",
    "MAHALANOBIS — ",
    site_name,
    "\n",
    "PC1 × PC2 CENTROIDS\n",
    "============================================================\n",
    sep = ""
  )


  site_data <- scores[
    scores$site == site_name,
    c(
      "compound",
      "PC1",
      "PC2"
    ),
    drop = FALSE
  ]


  site_data$compound <- droplevels(
    factor(
      site_data$compound
    )
  )


  compounds <- levels(
    site_data$compound
  )


  if (length(compounds) < 2) {

    next
  }


  X <- as.matrix(
    site_data[
      ,
      c(
        "PC1",
        "PC2"
      ),
      drop = FALSE
    ]
  )


  grouping <- site_data$compound



  # ===========================================================================
  # POOLED WITHIN-GROUP COVARIANCE
  # ===========================================================================

  pooled_covariance <- calculate_pooled_covariance(
    X,
    grouping
  )


  pooled_covariance_matrices[[site_name]] <-
    pooled_covariance


  inverse_result <- safe_inverse(
    pooled_covariance
  )


  S_inverse <-
    inverse_result$inverse


  inverse_method <-
    inverse_result$method



  # ===========================================================================
  # CENTROIDS
  #
  # These are the coordinates corresponding to the centroid diamonds
  # displayed in the PC1 × PC2 figure.
  # ===========================================================================

  centroid_matrix <- do.call(

    rbind,

    lapply(
      compounds,
      function(compound_name) {


        colMeans(
          X[
            grouping ==
              compound_name,
            ,
            drop = FALSE
          ],
          na.rm = TRUE
        )
      }
    )
  )


  rownames(
    centroid_matrix
  ) <- compounds


  colnames(
    centroid_matrix
  ) <- c(
    "PC1",
    "PC2"
  )



  centroid_results[[site_name]] <- data.frame(

    site =
      site_name,

    compound =
      rownames(
        centroid_matrix
      ),

    PC1_centroid =
      centroid_matrix[
        ,
        "PC1"
      ],

    PC2_centroid =
      centroid_matrix[
        ,
        "PC2"
      ],

    stringsAsFactors =
      FALSE,

    row.names =
      NULL
  )



  # ===========================================================================
  # DISTANCE MATRIX
  # ===========================================================================

  distance_matrix <- matrix(

    0,

    nrow =
      length(compounds),

    ncol =
      length(compounds),

    dimnames = list(
      compounds,
      compounds
    )
  )



  compound_pairs <- combn(
    compounds,
    2,
    simplify = FALSE
  )



  # ===========================================================================
  # PAIRWISE MAHALANOBIS DISTANCES
  # ===========================================================================

  for (pair in compound_pairs) {


    centroid_1 <- as.numeric(
      centroid_matrix[
        pair[1],
        c(
          "PC1",
          "PC2"
        )
      ]
    )


    centroid_2 <- as.numeric(
      centroid_matrix[
        pair[2],
        c(
          "PC1",
          "PC2"
        )
      ]
    )


    delta <- centroid_1 -
      centroid_2



    # -------------------------------------------------------------------------
    # EUCLIDEAN DISTANCE
    #
    # Included only as a complementary reference because this is the direct
    # geometric distance visible in the PC1-PC2 plot.
    # -------------------------------------------------------------------------

    Euclidean_D <- sqrt(
      sum(
        delta^2
      )
    )



    # -------------------------------------------------------------------------
    # MAHALANOBIS D²
    # -------------------------------------------------------------------------

    Mahalanobis_D2 <- as.numeric(

      t(delta) %*%
        S_inverse %*%
        delta
    )



    # Protect against tiny numerical negative values

    if (
      is.finite(
        Mahalanobis_D2
      ) &&
      Mahalanobis_D2 < 0 &&
      abs(
        Mahalanobis_D2
      ) < 1e-12
    ) {

      Mahalanobis_D2 <- 0
    }



    if (
      !is.finite(
        Mahalanobis_D2
      ) ||
      Mahalanobis_D2 < 0
    ) {


      Mahalanobis_D <- NA_real_


    } else {


      Mahalanobis_D <- sqrt(
        Mahalanobis_D2
      )
    }



    # -------------------------------------------------------------------------
    # FILL SYMMETRIC MATRIX
    # -------------------------------------------------------------------------

    distance_matrix[
      pair[1],
      pair[2]
    ] <- Mahalanobis_D


    distance_matrix[
      pair[2],
      pair[1]
    ] <- Mahalanobis_D



    # -------------------------------------------------------------------------
    # STORE RESULTS
    # -------------------------------------------------------------------------

    Mahalanobis_results_list[[mahalanobis_counter]] <- data.frame(

      site =
        site_name,

      compound_1 =
        pair[1],

      compound_2 =
        pair[2],

      PC1_centroid_compound_1 =
        centroid_1[1],

      PC2_centroid_compound_1 =
        centroid_1[2],

      PC1_centroid_compound_2 =
        centroid_2[1],

      PC2_centroid_compound_2 =
        centroid_2[2],

      delta_PC1 =
        delta[1],

      delta_PC2 =
        delta[2],

      Euclidean_D_PC1_PC2 =
        Euclidean_D,

      Mahalanobis_D =
        Mahalanobis_D,

      Mahalanobis_D2 =
        Mahalanobis_D2,

      covariance_inverse_method =
        inverse_method,

      stringsAsFactors =
        FALSE
    )


    mahalanobis_counter <-
      mahalanobis_counter + 1
  }



  Mahalanobis_matrices[[site_name]] <-
    distance_matrix
}




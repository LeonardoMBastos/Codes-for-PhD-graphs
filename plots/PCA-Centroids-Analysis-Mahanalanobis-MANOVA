      )
    )


    if (nlevels(site_data$compound) < 2) {

      next
    }


    X <- as.matrix(
      site_data[
        ,
        c(
          "PC1",
          "PC2"
        ),
        drop = FALSE
      ]
    )


    box_result <- tryCatch(

      suppressWarnings(

        biotools::boxM(
          X,
          site_data$compound
        )

      ),

      error = function(e) {

        NULL
      }
    )


    if (!is.null(box_result)) {


      BoxM_results[[site_name]] <- data.frame(

        site =
          site_name,

        variables =
          "PC1 + PC2",

        chi_square =
          as.numeric(
            box_result$statistic
          ),

        df =
          as.numeric(
            box_result$parameter
          ),

        p_value =
          as.numeric(
            box_result$p.value
          ),

        stringsAsFactors =
          FALSE
      )
    }
  }
}



if (length(BoxM_results) > 0) {


  BoxM_table <- do.call(
    rbind,
    BoxM_results
  )


  rownames(
    BoxM_table
  ) <- NULL


} else {


  BoxM_table <- data.frame()

get_variance <- function(
    site_name,
    PC_name
) {


  idx <- which(
    variance_table$site == site_name &
      variance_table$PC == PC_name
  )


  if (length(idx) == 0) {

    return(
      NA_real_
    )
  }


  variance_table$variance_percent[
    idx[1]
  ]
}




add_table_sheet <- function(
    workbook,
    sheet_name,
    data
) {


  addWorksheet(
    workbook,
    sheet_name
  )


  if (
    !is.null(data) &&
    nrow(data) > 0 &&
    ncol(data) > 0
  ) {


    writeData(
      workbook,
      sheet_name,
      data
    )


    addStyle(

      workbook,
      sheet_name,

      style =
        header_style,

      rows =
        1,

      cols =
        seq_len(
          ncol(data)
        ),

      gridExpand =
        TRUE,

      stack =
        TRUE
    )


    freezePane(
      workbook,
      sheet_name,
      firstRow = TRUE
    )


    setColWidths(
      workbook,
      sheet_name,
      cols =
        seq_len(
          ncol(data)
        ),
      widths =
        "auto"
    )
  }
}




# ============================================================
# 18. BOXPLOT FUNCTION
# ============================================================

calculate_box_stats <- function(data) {

  if (nrow(data) == 0) {
    return(data.frame())
  }


  base_stats <- data %>%

    group_by(
      compound_std
    ) %>%

    summarise(

      q1 =
        quantile(
          x_plot,
          0.25,
          na.rm = TRUE
        ),

      median =
        median(
          x_plot,
          na.rm = TRUE
        ),

      q3 =
        quantile(
          x_plot,
          0.75,
          na.rm = TRUE
        ),

      iqr =
        IQR(
          x_plot,
          na.rm = TRUE
        ),

      .groups = "drop"

    ) %>%

    mutate(

      lower_limit =
        q1 - 1.5 * iqr,

      upper_limit =
        q3 + 1.5 * iqr

    )


  whiskers <- data %>%

    inner_join(

      base_stats %>%
        select(
          compound_std,
          lower_limit,
          upper_limit
        ),

      by =
        "compound_std"

    ) %>%

    group_by(
      compound_std
    ) %>%

    summarise(

      whisker_low = {

        values <-
          x_plot[
            x_plot >= lower_limit
          ]

        if (length(values) > 0) {
          min(values, na.rm = TRUE)
        } else {
          NA_real_
        }

      },


      whisker_high = {

        values <-
          x_plot[
            x_plot <= upper_limit
          ]

        if (length(values) > 0) {
          max(values, na.rm = TRUE)
        } else {
          NA_real_
        }

      },

      .groups = "drop"

    )


  base_stats %>%

    left_join(
      whiskers,
      by = "compound_std"
    )

}


# ============================================================
# 19. CLOSED DENSITY FUNCTION
# ============================================================

calculate_density_polygon <- function(

  x,

  baseline,

  compound_name,

  lower_bound,

  upper_bound,

  margin,

  adjust = 1.20,

  height_scale = 0.25,

  tail_fraction = 0.08,

  close_at_zero = FALSE

) {


  x <- x[
    is.finite(x)
  ]


  if (length(x) < 2) {
    return(NULL)
  }


  if (
    length(
      unique(
        round(x, 5)
      )
    ) == 1
  ) {

    x <- c(
      x,
      x + 0.000001
    )

  }


  x_min <-
    max(
      lower_bound,
      min(x) - margin
    )


  x_max <-
    min(
      upper_bound,
      max(x) + margin
    )


  if (x_max <= x_min) {
    return(NULL)
  }


  density_result <- density(

    x = x,

    from = x_min,

    to = x_max,

    n = 512,

    adjust = adjust

  )


  density_values <-
    density_result$y


  threshold <-
    max(
      density_values
    ) *
    tail_fraction


  valid_index <-
    which(
      density_values > threshold
    )


  if (length(valid_index) < 5) {
    return(NULL)
  }


  first_index <-
    min(valid_index)


  last_index <-
    max(valid_index)


  x_trimmed <-
    density_result$x[
      first_index:last_index
    ]


  density_trimmed <-
    density_values[
      first_index:last_index
    ]


  y_trimmed <-

    baseline +

    (
      density_trimmed /
        max(density_trimmed)
    ) *

    height_scale


  # ----------------------------------------------------------
  # Correct orientation near zero
  # ----------------------------------------------------------

  if (close_at_zero) {

    polygon_x <-
      c(
        rev(x_trimmed),
        x_trimmed
      )

    polygon_y <-
      c(
        rev(y_trimmed),
        rep(
          baseline,
          length(x_trimmed)
        )
      )

  } else {

    polygon_x <-
      c(
        x_trimmed,
        rev(x_trimmed)
      )

    polygon_y <-
      c(
        y_trimmed,
        rep(
          baseline,
          length(x_trimmed)
        )
      )

  }


  data.frame(

    x =
      polygon_x,

    y =
      polygon_y,

    compound_std =
      compound_name

  )

}



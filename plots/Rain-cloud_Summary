# ============================================================
# 14. LEGEND FILL COLORS
#
# IMPORTANT:
#
# The previous version used alpha transparency directly in the
# legend key. Depending on the graphics device / guide rendering,
# the interior could appear white.
#
# Here we generate an OPAQUE pastel color equivalent to the
# appearance of each cloud over a white background.
#
# Therefore:
#
# Border   = original compound color
# Interior = same visual color as cloud fill over white
#
# ============================================================

blend_with_white <- function(hex_color, alpha = 0.24) {

  rgb_original <-
    grDevices::col2rgb(
      hex_color
    )


  rgb_blended <-

    round(

      alpha *
        rgb_original +

      (1 - alpha) *
        255

    )


  grDevices::rgb(

    red =
      rgb_blended[1, ],

    green =
      rgb_blended[2, ],

    blue =
      rgb_blended[3, ],

    maxColorValue =
      255

  )

}


legend_fill_colors <-


normalize_text <- function(x) {

  x <- as.character(x)
  x <- trimws(x)

  x <- iconv(
    x,
    from = "",
    to = "ASCII//TRANSLIT"
  )

  toupper(x)

}


# ============================================================
# 8. STANDARDIZE COMPOUNDS
# ============================================================

map_compound <- function(x) {

  x2 <- normalize_text(x)

  dplyr::case_when(

    x2 %in% c(
      "DZP",
      "DIAZEPAM"
    ) ~ "DZP",

    x2 %in% c(
      "PHB",
      "PHENOBARBITAL",
      "FENOBARBITAL"
    ) ~ "PHB",

    x2 == "GABA" ~
      "GABA",

    x2 %in% c(
      "LIN",
      "LINALOOL",
      "LINALOL"
    ) ~ "LIN",

    x2 %in% c(
      "NER",
      "NEROLIDOL",
      "TRANS-NEROLIDOL",
      "TRANS NEROLIDOL",
      "TRANS_NEROLIDOL",
      "TRANSNEROLIDOL"
    ) ~ "NER",

    TRUE ~ NA_character_

  )

}



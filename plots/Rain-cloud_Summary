# ============================================================
# 20. CREATE ONE PLOT PER SITE
# ============================================================

create_site_raincloud <- function(site_name) {


  # ----------------------------------------------------------
  # FILTER SITE
  # ----------------------------------------------------------

  site_data <- df_plot %>%

    filter(
      as.character(site_std) ==
        site_name
    )


  if (nrow(site_data) == 0) {

    cat(
      paste0(
        "\nNo observations found for: ",
        site_name,
        "\n"
      )
    )

    return(NULL)

  }


  # ==========================================================
  # DYNAMIC X AXIS
  # ==========================================================

  negative_values <-

    site_data$affinity[
      site_data$affinity <= 0
    ]


  positive_values <-

    site_data$affinity[
      site_data$affinity > 0
    ]


  HAS_POSITIVE <-
    length(positive_values) > 0


  if (length(negative_values) > 0) {

    MOST_NEGATIVE <-
      min(
        negative_values,
        na.rm = TRUE
      )


    X_NEGATIVE_LIMIT <-
      MOST_NEGATIVE - 0.5

  } else {

    MOST_NEGATIVE <- 0

    X_NEGATIVE_LIMIT <- -0.5

  }


  if (HAS_POSITIVE) {

    MOST_POSITIVE <-
      max(
        positive_values,
        na.rm = TRUE
      )


    X_POSITIVE_LIMIT <-
      MOST_POSITIVE + POSITIVE_MARGIN

  } else {

    MOST_POSITIVE <- 0

    X_POSITIVE_LIMIT <- 0

  }


  # ==========================================================
  # X TICKS
  # ==========================================================

  candidate_negative_breaks <-

    seq(
      from = 0,
      to = -100,
      by = -2
    )


  negative_breaks <-

    candidate_negative_breaks[
      candidate_negative_breaks >=
        X_NEGATIVE_LIMIT
    ]


  if (HAS_POSITIVE) {

    positive_breaks <-
      pretty(
        c(0, X_POSITIVE_LIMIT),
        n = 4
      )


    positive_breaks <-
      positive_breaks[
        positive_breaks > 0 &
        positive_breaks <= X_POSITIVE_LIMIT
      ]

  } else {

    positive_breaks <- numeric(0)

  }


  x_breaks <-

    sort(
      unique(
        c(
          positive_breaks,
          negative_breaks
        )
      ),
      decreasing = TRUE
    )


  x_labels <-
    as.character(
      x_breaks
    )


  # ==========================================================
  # COMPOUNDS PRESENT
  # ==========================================================

  compounds_present <-

    compound_order[
      compound_order %in%
        unique(
          as.character(
            site_data$compound_std
          )
        )
    ]


  # ==========================================================
  # NUMERIC / POSITIVE DATA
  # ==========================================================

  df_numeric <- site_data %>%

    filter(
      affinity <= 0
    ) %>%

    mutate(
      x_plot = affinity
    )


  df_positive <- site_data %>%

    filter(
      affinity > 0
    ) %>%

    mutate(
      x_plot = affinity
    )


  df_all <-

    bind_rows(
      df_numeric,
      df_positive
    ) %>%

    mutate(

      y_dot =
        SITE_BASE +
        DOT_VERTICAL_POSITION

    )


  # ==========================================================
  # BOXPLOTS
  # ==========================================================

  box_numeric <-
    calculate_box_stats(
      df_numeric
    )


  box_positive <-
    calculate_box_stats(
      df_positive
    )


  box_stats <-

    bind_rows(
      box_numeric,
      box_positive
    )


  if (nrow(box_stats) > 0) {

    box_stats <- box_stats %>%

      mutate(

        y_box =

          SITE_BASE +

          BOX_VERTICAL_POSITION +

          unname(
            box_offset[
              as.character(
                compound_std
              )
            ]
          ),

        ymin =
          y_box -
          BOX_HALF_HEIGHT,

        ymax =
          y_box +
          BOX_HALF_HEIGHT,

        cap_ymin =
          y_box -
          BOX_HALF_HEIGHT * 0.60,

        cap_ymax =
          y_box +
          BOX_HALF_HEIGHT * 0.60

      )

  }


  # ==========================================================
  # NEGATIVE DENSITY CLOUDS
  # ==========================================================

  numeric_polygons <- list()

  counter <- 1


  for (c in compounds_present) {


    current_data <-

      df_numeric %>%

      filter(
        as.character(
          compound_std
        ) == c
      )


    if (nrow(current_data) < 2) {
      next
    }


    baseline <-

      SITE_BASE +

      CLOUD_VERTICAL_POSITION +

      cloud_offset[[c]]


    result <-

      calculate_density_polygon(

        x =
          current_data$x_plot,

        baseline =
          baseline,

        compound_name =
          c,

        lower_bound =
          X_NEGATIVE_LIMIT,

        upper_bound =
          0,

        margin =
          0.35,

        adjust =
          1.20,

        height_scale =
          0.25,

        tail_fraction =
          0.08,

        close_at_zero =
          TRUE

      )


    if (!is.null(result)) {

      numeric_polygons[[counter]] <-
        result

      counter <-
        counter + 1

    }

  }


  if (length(numeric_polygons) > 0) {

    density_numeric <-

      bind_rows(
        numeric_polygons
      )

  } else {

    density_numeric <-
      empty_density_df

  }


  # ==========================================================
  # POSITIVE DENSITY CLOUDS
  # ==========================================================

  positive_polygons <- list()

  counter <- 1


  for (c in compounds_present) {


    current_data <-

      df_positive %>%

      filter(
        as.character(
          compound_std
        ) == c
      )


    if (nrow(current_data) < 2) {
      next
    }


    baseline <-

      SITE_BASE +

      CLOUD_VERTICAL_POSITION +

      cloud_offset[[c]]


    result <-

      calculate_density_polygon(

        x =
          current_data$x_plot,

        baseline =
          baseline,

        compound_name =
          c,

        lower_bound =
          0,

        upper_bound =
          X_POSITIVE_LIMIT,

        margin =
          0.35,

        adjust =
          1.10,

        height_scale =
          0.25,

        tail_fraction =
          0.05,

        close_at_zero =
          FALSE

      )


    if (!is.null(result)) {

      positive_polygons[[counter]] <-
        result

      counter <-
        counter + 1

    }

  }


  if (length(positive_polygons) > 0) {

    density_positive <-

      bind_rows(
        positive_polygons
      )

  } else {

    density_positive <-
      empty_density_df

  }


  density_polygon <-

    bind_rows(
      density_numeric,
      density_positive
    )


  # ==========================================================
  # LEGEND DATA
  # ==========================================================

  legend_df <- data.frame(

    compound_std =
      factor(
        compounds_present,
        levels = compound_order
      ),

    x =
      rep(
        X_NEGATIVE_LIMIT + 0.1,
        length(compounds_present)
      ),

    y =
      rep(
        0.45,
        length(compounds_present)
      )

  )


  # ==========================================================
  # CREATE PLOT
  # ==========================================================

  positive_background_layer <-

    if (HAS_POSITIVE) {

      annotate(

        "rect",

        xmin =
          0,

        xmax =
          X_POSITIVE_LIMIT,

        ymin =
          -Inf,

        ymax =
          Inf,

        fill =
          "#D9D9D9",

        alpha =
          0.25

      )

    } else {

      NULL

    }


  positive_zero_line_layer <-

    if (HAS_POSITIVE) {

      geom_vline(

        xintercept =
          0,

        linetype =
          "dashed",

        linewidth =
          0.35,

        color =
          "grey55"

      )

    } else {

      NULL

    }


  p <- ggplot() +

    positive_background_layer +

    positive_zero_line_layer +


    # --------------------------------------------------------
    # CLOUDS
    # --------------------------------------------------------

    geom_polygon(

      data =
        density_polygon,

      aes(

        x = x,

        y = y,

        group =
          compound_std,

        fill =
          compound_std,

        color =
          compound_std

      ),

      alpha =
        CLOUD_ALPHA,

      linewidth =
        0.62,

      show.legend =
        FALSE

    ) +


    # --------------------------------------------------------
    # WHISKERS
    # --------------------------------------------------------

    geom_segment(

      data =
        box_stats,

      aes(

        x =
          whisker_low,

        xend =
          q1,

        y =
          y_box,

        yend =
          y_box,

        color =
          compound_std

      ),

      linewidth =
        0.34,

      show.legend =
        FALSE

    ) +


    geom_segment(

      data =
        box_stats,

      aes(

        x =
          q3,

        xend =
          whisker_high,

        y =
          y_box,

        yend =
          y_box,

        color =
          compound_std

      ),

      linewidth =
        0.34,

      show.legend =
        FALSE

    ) +


    # --------------------------------------------------------
    # CAPS
    # --------------------------------------------------------

    geom_segment(

      data =
        box_stats,

      aes(

        x =
          whisker_low,

        xend =
          whisker_low,

        y =
          cap_ymin,

        yend =
          cap_ymax,

        color =
          compound_std

      ),

      linewidth =
        0.34,

      show.legend =
        FALSE

    ) +


    geom_segment(

      data =
        box_stats,

      aes(

        x =
          whisker_high,

        xend =
          whisker_high,

        y =
          cap_ymin,

        yend =
          cap_ymax,

        color =
          compound_std

      ),

      linewidth =
        0.34,

      show.legend =
        FALSE

    ) +


    # --------------------------------------------------------
    # BOXES
    # --------------------------------------------------------

    geom_rect(

      data =
        box_stats,

      aes(

        xmin =
          q1,

        xmax =
          q3,

        ymin =
          ymin,

        ymax =
          ymax,

        fill =
          compound_std,

        color =
          compound_std

      ),

      alpha =
        CLOUD_ALPHA,

      linewidth =
        0.34,

      show.legend =
        FALSE

    ) +


    # --------------------------------------------------------
    # MEDIAN
    # --------------------------------------------------------

    geom_segment(

      data =
        box_stats,

      aes(

        x =
          median,

        xend =
          median,

        y =
          ymin,

        yend =
          ymax,

        color =
          compound_std

      ),

      linewidth =
        0.42,

      show.legend =
        FALSE

    ) +


    # --------------------------------------------------------
    # RAW DATA
    # --------------------------------------------------------

    geom_jitter(

      data =
        df_all,

      aes(

        x =
          x_plot,

        y =
          y_dot,

        color =
          compound_std

      ),

      height =
        DOT_JITTER_HEIGHT,

      width =
        0,

      size =
        1.70,

      alpha =
        0.50,

      show.legend =
        FALSE

    ) +


    # ========================================================
    # LEGEND GENERATOR
    # ========================================================

    geom_point(

      data =
        legend_df,

      aes(

        x = x,

        y = y,

        fill =
          compound_std,

        color =
          compound_std

      ),

      shape =
        22,

      size =
        0.01,

      stroke =
        0.9,

      alpha =
        0,

      inherit.aes =
        FALSE,

      show.legend =
        TRUE

    ) +


    # ========================================================
    # COLOR SCALES
    # ========================================================

    scale_color_manual(

      values =
        colors,

      breaks =
        compounds_present,

      drop =
        TRUE,

      name =
        "Compounds"

    ) +


    scale_fill_manual(

      values =
        colors,

      breaks =
        compounds_present,

      drop =
        TRUE,

      name =
        "Compounds"

    ) +


    # ========================================================
    # LEGEND
    #
    # IMPORTANT FIX:
    #
    # color = saturated border
    # fill  = opaque pastel color equivalent to cloud fill
    # ========================================================

    guides(

      color =
        "none",

      fill =
        guide_legend(

          title =
            "Compounds",

          ncol =
            1,

          byrow =
            TRUE,

          title.position =
            "top",

          override.aes =
            list(

              shape =
                22,

              size =
                5.4,

              stroke =
                1.05,

              # Keep the key fully visible
              alpha =
                1,

              # Saturated borders
              color =
                unname(
                  colors[
                    compounds_present
                  ]
                ),

              # Pastel cloud-equivalent fills
              fill =
                unname(
                  legend_fill_colors[
                    compounds_present
                  ]
                )

            )

        )

    ) +


    # ========================================================
    # X AXIS
    # ========================================================

    scale_x_reverse(

      limits =
        c(
          X_POSITIVE_LIMIT,
          X_NEGATIVE_LIMIT
        ),

      breaks =
        x_breaks,

      labels =
        x_labels,

      expand =
        c(
          0,
          0
        )

    ) +


    # ========================================================
    # Y AXIS
    # ========================================================

    scale_y_continuous(

      limits =
        c(
          0.40,
          1.70
        ),

      breaks =
        NULL,

      expand =
        c(
          0.01,
          0.01
        )

    ) +


    # ========================================================
    # LABELS
    # ========================================================

    labs(

      x =
        "Binding affinity (kcal/mol)",

      y =
        NULL,

      title =
        site_titles[[site_name]]

    ) +


    coord_cartesian(
      clip = "off"
    ) +


    # ========================================================
    # THEME
    # ========================================================

    theme_minimal(
      base_size = 11
    ) +


    theme(


      # ------------------------------------------------------
      # TRANSPARENT BACKGROUND
      # ------------------------------------------------------

      panel.background =
        element_rect(
          fill = "transparent",
          color = NA
        ),


      plot.background =
        element_rect(
          fill = "transparent",
          color = NA
        ),


      legend.background =
        element_rect(
          fill = "transparent",
          color = NA
        ),


      legend.box.background =
        element_rect(
          fill = "transparent",
          color = NA
        ),


      legend.key =
        element_rect(
          fill = "transparent",
          color = NA
        ),


      # ------------------------------------------------------
      # GRID
      # ------------------------------------------------------

      panel.grid.major.y =
        element_blank(),


      panel.grid.minor =
        element_blank(),


      panel.grid.major.x =
        element_line(
          color = "grey78",
          linewidth = 0.42
        ),


      # ------------------------------------------------------
      # X AXIS
      # ------------------------------------------------------

      axis.line.x =
        element_line(
          color = "black",
          linewidth = 0.65
        ),


      axis.ticks.x =
        element_line(
          color = "black",
          linewidth = 0.55
        ),


      axis.ticks.length.x =
        grid::unit(
          0.14,
          "cm"
        ),


      axis.ticks.y =
        element_blank(),


      axis.text.y =
        element_blank(),


      # ======================================================
      # LEGEND — RIGHT SIDE
      # ======================================================

      legend.position =
        "right",


      # ------------------------------------------------------
      # RAISE LEGEND SLIGHTLY
      #
      # Previous version:
      # c(0, 0)
      #
      # Current version:
      # c(0, 0.16)
      #
      # Increase second value to move further upward.
      # Example:
      # c(0, 0.22)
      # ------------------------------------------------------

      legend.justification =
        c(
          0,
          0.16
        ),


      legend.box.just =
        "left",


      legend.direction =
        "vertical",


      # ------------------------------------------------------
      # LEGEND TITLE — REGULAR
      # ------------------------------------------------------

      legend.title =
        element_text(

          size =
            11.5,

          face =
            "plain",

          color =
            "black",

          hjust =
            0,

          margin =
            margin(
              b = 7
            )

        ),


      # ------------------------------------------------------
      # LEGEND TEXT — REGULAR
      # ------------------------------------------------------

      legend.text =
        element_text(

          size =
            10.8,

          face =
            "plain",

          color =
            "black"

        ),


      legend.spacing.y =
        grid::unit(
          0.10,
          "cm"
        ),


      legend.key.width =
        grid::unit(
          0.48,
          "cm"
        ),


      legend.key.height =
        grid::unit(
          0.48,
          "cm"
        ),


      legend.margin =
        margin(
          t = 0,
          r = 0,
          b = 0,
          l = 7
        ),


      # ------------------------------------------------------
      # MAIN TITLE
      # ------------------------------------------------------

      plot.title.position =
        "plot",


      plot.title =
        element_text(

          size =
            17,

          face =
            "bold",

          hjust =
            0,

          color =
            "black",

          margin =
            margin(
              b = 8
            )

        ),


      # ------------------------------------------------------
      # X AXIS TITLE — REGULAR
      # ------------------------------------------------------

      axis.title.x =
        element_text(

          size =
            17.5,

          face =
            "plain",

          color =
            "black",

          margin =
            margin(
              t = 11
            )

        ),


      # ------------------------------------------------------
      # X AXIS LABELS — REGULAR
      # ------------------------------------------------------

      axis.text.x =
        element_text(

          size =
            13.5,

          face =
            "plain",

          color =
            "black",

          margin =
            margin(
              t = 4
            )

        ),


      # ------------------------------------------------------
      # MARGINS
      # ------------------------------------------------------

      plot.margin =
        margin(

          t = 8,

          r = 5,

          b = 8,

          l = 8

        )

    )


  # ==========================================================
  # DISPLAY
  # ==========================================================

  print(p)


  # ==========================================================
  # EXPORT
  # ==========================================================

  file_tag <-
    site_file_names[[site_name]]


  png_name <-
    paste0(
      "raincloud_",
      file_tag,
      "_binding_site.png"
    )


  tiff_name <-
    paste0(
      "raincloud_",
      file_tag,
      "_binding_site.tiff"
    )


  ggsave(

    filename =
      png_name,

    plot =
      p,

    width =
      11.2,

    height =
      4.8,

    units =
      "in",

    dpi =
      600,

    bg =
      "transparent"

  )


  ggsave(

    filename =
      tiff_name,

    plot =
      p,

    width =
      11.2,

    height =
      4.8,

    units =
      "in",

    dpi =
      600,

    compression =
      "lzw",

    bg =
      "transparent"

  )


  cat(
    "\nGenerated:\n"
  )

  cat(
    paste0(
      "- ",
      png_name,
      "\n"
    )
  )

  cat(
    paste0(
      "- ",
      tiff_name,
      "\n"
    )
  )


  return(p)

}



# ==============================================================================
# PCA OF RESIDUE-INTERACTION FINGERPRINTS — PLOTTING FROM RESULTS WORKBOOK
#
# INPUT:
#   PCA_complete_results.xlsx
#
# This script DOES NOT recalculate the PCA. It reads the PCA results that were
# already generated by the residue-fingerprint analysis and creates the PCA
# figure(s) from the workbook.
#
# It automatically:
#   - reads .xlsx/.xls files correctly (no read.csv() on Excel files);
#   - uses only binding sites that are actually available in Scores_all_PCs;
#   - skips absent BB/GABA panels without stopping;
#   - includes GER and GERAC;
#   - uses the same compound colours as the raincloud plots;
#   - generates one combined PCA figure with a shared legend;
#   - adds a loading inset to each available binding-site panel.
#
# Compound colours:
#   DZP   = #410257
#   PHB   = #8C7D37
#   GABA  = #C06000
#   GER   = #84A85E
#   GERAC = #D13232
# ==============================================================================


# ==============================================================================
# 0. PACKAGES
# ==============================================================================

required_packages <- c(
  "dplyr",
  "ggplot2",
  "ggrepel",
  "patchwork",
  "readxl"
)

missing_packages <- required_packages[
  !vapply(
    required_packages,
    requireNamespace,
    logical(1),
    quietly = TRUE
  )
]

if (length(missing_packages) > 0) {
  message(
    "Installing missing packages: ",
    paste(missing_packages, collapse = ", ")
  )

  install.packages(missing_packages)
}

library(dplyr)
library(ggplot2)
library(ggrepel)
library(patchwork)
library(readxl)

set.seed(123)


# ==============================================================================
# 1. SELECT PCA RESULTS WORKBOOK
# ==============================================================================

message("\n============================================================")
message("SELECT PCA_complete_results.xlsx")
message("============================================================\n")

input_file <- file.choose()

file_ext <- tolower(tools::file_ext(input_file))

if (!file_ext %in% c("xlsx", "xls")) {
  stop(
    paste0(
      "The selected file is not an Excel workbook (.xlsx/.xls).\n",
      "This plotting script expects PCA_complete_results.xlsx.\n",
      "Selected file: ", input_file
    ),
    call. = FALSE
  )
}

output_dir <- dirname(input_file)

message("Input workbook: ", input_file)


# ==============================================================================
# 2. CHECK REQUIRED SHEETS
# ==============================================================================

available_sheets <- readxl::excel_sheets(input_file)

required_sheets <- c(
  "Variance_all_PCs",
  "Scores_all_PCs",
  "Loadings_PC1_PC2",
  "Centroids_PC1_PC2"
)

missing_sheets <- setdiff(required_sheets, available_sheets)

if (length(missing_sheets) > 0) {
  stop(
    paste0(
      "The workbook is missing the following required sheet(s): ",
      paste(missing_sheets, collapse = ", "),
      "\n\nAvailable sheets: ",
      paste(available_sheets, collapse = ", ")
    ),
    call. = FALSE
  )
}


# ==============================================================================
# 3. READ PCA RESULTS
# ==============================================================================

variance_all <- readxl::read_excel(
  input_file,
  sheet = "Variance_all_PCs"
) %>%
  as.data.frame()

scores_all <- readxl::read_excel(
  input_file,
  sheet = "Scores_all_PCs"
) %>%
  as.data.frame()

loadings_PC12_all <- readxl::read_excel(
  input_file,
  sheet = "Loadings_PC1_PC2"
) %>%
  as.data.frame()

centroids_all <- readxl::read_excel(
  input_file,
  sheet = "Centroids_PC1_PC2"
) %>%
  as.data.frame()

# Optional status sheet, if present.
if ("Analysis_status" %in% available_sheets) {
  analysis_status <- readxl::read_excel(
    input_file,
    sheet = "Analysis_status"
  ) %>%
    as.data.frame()
} else {
  analysis_status <- NULL
}


# ==============================================================================
# 4. CHECK REQUIRED COLUMNS
# ==============================================================================

check_required_columns <- function(data, required, object_name) {
  missing <- setdiff(required, names(data))

  if (length(missing) > 0) {
    stop(
      paste0(
        "Sheet/object '", object_name,
        "' is missing required column(s): ",
        paste(missing, collapse = ", ")
      ),
      call. = FALSE
    )
  }
}

check_required_columns(
  variance_all,
  c("site", "PC", "variance_percent"),
  "Variance_all_PCs"
)

check_required_columns(
  scores_all,
  c("site", "compound", "PC1", "PC2"),
  "Scores_all_PCs"
)

check_required_columns(
  loadings_PC12_all,
  c("site", "residue", "PC1", "PC2"),
  "Loadings_PC1_PC2"
)

check_required_columns(
  centroids_all,
  c("site", "compound", "PC1", "PC2"),
  "Centroids_PC1_PC2"
)


# ==============================================================================
# 5. CLEAN TYPES
# ==============================================================================

scores_all <- scores_all %>%
  mutate(
    site = trimws(as.character(site)),
    compound = toupper(trimws(as.character(compound))),
    PC1 = as.numeric(PC1),
    PC2 = as.numeric(PC2)
  ) %>%
  filter(
    !is.na(site),
    nzchar(site),
    !is.na(compound),
    nzchar(compound),
    is.finite(PC1),
    is.finite(PC2)
  )

variance_all <- variance_all %>%
  mutate(
    site = trimws(as.character(site)),
    PC = trimws(as.character(PC)),
    variance_percent = as.numeric(variance_percent)
  )

loadings_PC12_all <- loadings_PC12_all %>%
  mutate(
    site = trimws(as.character(site)),
    residue = trimws(as.character(residue)),
    PC1 = as.numeric(PC1),
    PC2 = as.numeric(PC2)
  ) %>%
  filter(
    !is.na(site),
    nzchar(site),
    !is.na(residue),
    nzchar(residue),
    is.finite(PC1),
    is.finite(PC2)
  )

centroids_all <- centroids_all %>%
  mutate(
    site = trimws(as.character(site)),
    compound = toupper(trimws(as.character(compound))),
    PC1 = as.numeric(PC1),
    PC2 = as.numeric(PC2)
  ) %>%
  filter(
    !is.na(site),
    nzchar(site),
    !is.na(compound),
    nzchar(compound),
    is.finite(PC1),
    is.finite(PC2)
  )


# ==============================================================================
# 6. COMPOUND ORDER AND COLOURS
# ==============================================================================

compound_levels <- c(
  "DZP",
  "PHB",
  "GABA",
  "GER",
  "GERAC"
)

compound_colors <- c(
  "DZP"   = "#410257",
  "PHB"   = "#8C7D37",
  "GABA"  = "#C06000",
  "GER"   = "#84A85E",
  "GERAC" = "#D13232"
)

observed_compounds <- compound_levels[
  compound_levels %in% unique(scores_all$compound)
]

unknown_compounds <- setdiff(
  unique(scores_all$compound),
  compound_levels
)

if (length(unknown_compounds) > 0) {
  warning(
    paste0(
      "The following compound(s) are present but are not part of the predefined ",
      "palette and will be excluded from the figure: ",
      paste(unknown_compounds, collapse = ", ")
    ),
    call. = FALSE
  )
}

scores_all <- scores_all %>%
  filter(compound %in% observed_compounds) %>%
  mutate(
    compound = factor(
      compound,
      levels = compound_levels
    )
  )

centroids_all <- centroids_all %>%
  filter(compound %in% observed_compounds) %>%
  mutate(
    compound = factor(
      compound,
      levels = compound_levels
    )
  )

if (length(observed_compounds) == 0) {
  stop(
    "No recognized compounds were found in Scores_all_PCs.",
    call. = FALSE
  )
}

message(
  "Compounds available for plotting: ",
  paste(observed_compounds, collapse = ", ")
)


# ==============================================================================
# 7. BINDING-SITE ORDER — ONLY SITES ACTUALLY PRESENT ARE USED
# ==============================================================================

site_order <- c(
  "BZD",
  "BB",
  "GABA"
)

available_sites <- site_order[
  site_order %in% unique(scores_all$site)
]

# Preserve any unexpected site names after the standard three.
extra_sites <- setdiff(
  unique(scores_all$site),
  site_order
)

available_sites <- c(
  available_sites,
  extra_sites
)

if (length(available_sites) == 0) {
  stop(
    "No binding site with PCA scores was found in Scores_all_PCs.",
    call. = FALSE
  )
}

message(
  "Binding site(s) available for plotting: ",
  paste(available_sites, collapse = ", ")
)

if (!is.null(analysis_status)) {
  message("\nAnalysis status stored in workbook:")
  print(analysis_status)
}


# ==============================================================================
# 8. SITE TITLES
# ==============================================================================

site_titles <- c(
  "BZD"  = "BZD - α1/γ2 interface",
  "BB"   = "BB - α1/β2 interface",
  "GABA" = "GABA - β2/α1 interface"
)

get_site_title <- function(site_name) {
  if (site_name %in% names(site_titles)) {
    site_titles[[site_name]]
  } else {
    site_name
  }
}


# ==============================================================================
# 9. MINI LOADING INSET
# ==============================================================================

make_residue_inset <- function(loadings_df, n_residues = 8) {

  if (nrow(loadings_df) == 0) {
    return(
      ggplot() +
        theme_void()
    )
  }

  if ("contribution_PC12" %in% names(loadings_df)) {
    inset_df <- loadings_df %>%
      mutate(
        contribution_PC12 = as.numeric(contribution_PC12)
      ) %>%
      arrange(desc(contribution_PC12)) %>%
      slice_head(n = n_residues)
  } else {
    inset_df <- loadings_df %>%
      mutate(
        contribution_PC12 = sqrt(PC1^2 + PC2^2)
      ) %>%
      arrange(desc(contribution_PC12)) %>%
      slice_head(n = n_residues)
  }

  max_x <- max(abs(inset_df$PC1), na.rm = TRUE)
  max_y <- max(abs(inset_df$PC2), na.rm = TRUE)

  lim_x <- max_x * 1.40
  lim_y <- max_y * 1.40

  if (!is.finite(lim_x) || lim_x == 0) {
    lim_x <- 1
  }

  if (!is.finite(lim_y) || lim_y == 0) {
    lim_y <- 1
  }

  ggplot(
    inset_df,
    aes(
      x = PC1,
      y = PC2
    )
  ) +
    geom_hline(
      yintercept = 0,
      colour = "grey45",
      linewidth = 0.28
    ) +
    geom_vline(
      xintercept = 0,
      colour = "grey45",
      linewidth = 0.28
    ) +
    geom_segment(
      aes(
        x = 0,
        y = 0,
        xend = PC1,
        yend = PC2
      ),
      arrow = grid::arrow(
        length = grid::unit(0.10, "cm"),
        type = "open"
      ),
      linewidth = 0.28,
      colour = "black"
    ) +
    geom_point(
      size = 0.55,
      colour = "black"
    ) +
    ggrepel::geom_text_repel(
      aes(label = residue),
      seed = 1234,
      size = 2.25,
      colour = "black",
      fontface = "italic",
      box.padding = 0.35,
      point.padding = 0.10,
      segment.colour = "grey55",
      segment.linewidth = 0.18,
      force = 6,
      force_pull = 0.15,
      max.overlaps = Inf,
      min.segment.length = 0,
      max.time = 5
    ) +
    annotate(
      "text",
      x = lim_x * 0.94,
      y = -lim_y * 0.055,
      label = "PC1",
      size = 2.25,
      hjust = 1,
      vjust = 1
    ) +
    annotate(
      "text",
      x = lim_x * 0.035,
      y = lim_y * 0.94,
      label = "PC2",
      size = 2.25,
      angle = 90,
      hjust = 1,
      vjust = 1
    ) +
    coord_cartesian(
      xlim = c(-lim_x, lim_x),
      ylim = c(-lim_y, lim_y),
      clip = "on",
      expand = FALSE
    ) +
    theme_classic(
      base_size = 8,
      base_family = "Arial"
    ) +
    theme(
      axis.title = element_blank(),
      axis.text = element_blank(),
      axis.ticks = element_blank(),
      panel.border = element_blank(),
      plot.background = element_rect(
        fill = NA,
        colour = NA
      ),
      panel.background = element_rect(
        fill = grDevices::adjustcolor(
          "white",
          alpha.f = 0.60
        ),
        colour = NA
      ),
      plot.margin = margin(0, 0, 0, 0)
    )
}


# ==============================================================================
# 10. PCA PANEL FUNCTION
# ==============================================================================

plot_pca_site <- function(
    site_name,
    n_residues = 8,
    inset_width = 0.34,
    inset_height = 0.34
) {

  scores <- scores_all %>%
    filter(site == site_name)

  centroids <- centroids_all %>%
    filter(site == site_name)

  variance <- variance_all %>%
    filter(site == site_name)

  loadings <- loadings_PC12_all %>%
    filter(site == site_name)

  if (nrow(scores) == 0) {
    stop(
      paste0("No PCA scores found for site: ", site_name),
      call. = FALSE
    )
  }

  pc1_variance <- variance %>%
    filter(PC == "PC1") %>%
    pull(variance_percent)

  pc2_variance <- variance %>%
    filter(PC == "PC2") %>%
    pull(variance_percent)

  if (length(pc1_variance) == 0 || length(pc2_variance) == 0) {
    stop(
      paste0(
        "PC1/PC2 explained variance is missing for site: ",
        site_name
      ),
      call. = FALSE
    )
  }

  pc1_variance <- pc1_variance[1]
  pc2_variance <- pc2_variance[1]

  # Ellipses require at least three usable observations and non-zero
  # variability on both PC axes within a compound.
  ellipse_scores <- scores %>%
    group_by(compound) %>%
    filter(
      n() >= 3,
      n_distinct(PC1) >= 2,
      n_distinct(PC2) >= 2
    ) %>%
    ungroup()

  main_plot <- ggplot(
    scores,
    aes(
      x = PC1,
      y = PC2
    )
  ) +
    geom_hline(
      yintercept = 0,
      colour = "grey82",
      linewidth = 0.45
    ) +
    geom_vline(
      xintercept = 0,
      colour = "grey82",
      linewidth = 0.45
    )

  if (nrow(ellipse_scores) > 0) {
    main_plot <- main_plot +
      stat_ellipse(
        data = ellipse_scores,
        aes(
          fill = compound,
          group = compound
        ),
        geom = "polygon",
        type = "norm",
        level = 0.95,
        alpha = 0.10,
        colour = NA,
        show.legend = FALSE
      ) +
      stat_ellipse(
        data = ellipse_scores,
        aes(
          colour = compound,
          group = compound
        ),
        type = "norm",
        level = 0.95,
        linewidth = 0.55,
        alpha = 0.95,
        show.legend = FALSE
      )
  }

  main_plot <- main_plot +
    geom_point(
      aes(colour = compound),
      size = 2.1,
      alpha = 0.72,
      show.legend = TRUE
    ) +
    geom_point(
      data = centroids,
      aes(
        x = PC1,
        y = PC2,
        fill = compound
      ),
      inherit.aes = FALSE,
      shape = 23,
      size = 4.2,
      colour = "black",
      stroke = 0.85,
      show.legend = FALSE
    ) +
    scale_colour_manual(
      values = compound_colors,
      limits = observed_compounds,
      breaks = observed_compounds,
      drop = FALSE,
      name = "Compound"
    ) +
    scale_fill_manual(
      values = compound_colors,
      limits = observed_compounds,
      breaks = observed_compounds,
      drop = FALSE,
      guide = "none"
    ) +
    scale_x_continuous(
      expand = expansion(mult = c(0.08, 0.08))
    ) +
    scale_y_continuous(
      expand = expansion(mult = c(0.08, 0.08))
    ) +
    coord_cartesian(clip = "on") +
    labs(
      title = get_site_title(site_name),
      x = paste0(
        "PC1 (",
        round(pc1_variance, 1),
        "%)"
      ),
      y = paste0(
        "PC2 (",
        round(pc2_variance, 1),
        "%)"
      )
    ) +
    theme_classic(
      base_size = 13,
      base_family = "Arial"
    ) +
    theme(
      plot.title = element_text(
        face = "plain",
        hjust = 0.5,
        size = 14
      ),
      axis.title = element_text(face = "plain"),
      axis.text = element_text(face = "plain"),
      legend.position = "bottom",
      legend.direction = "horizontal",
      legend.title = element_text(
        face = "plain",
        size = 12
      ),
      legend.text = element_text(
        face = "plain",
        size = 11
      ),
      plot.margin = margin(8, 8, 8, 8)
    ) +
    guides(
      colour = guide_legend(
        nrow = 1,
        byrow = TRUE,
        title.position = "left",
        override.aes = list(
          size = 3.1,
          alpha = 1
        )
      )
    )

  inset_plot <- make_residue_inset(
    loadings_df = loadings,
    n_residues = n_residues
  )

  inset_left <- 1 - inset_width
  inset_bottom <- 1 - inset_height

  main_plot +
    patchwork::inset_element(
      inset_plot,
      left = inset_left,
      bottom = inset_bottom,
      right = 1,
      top = 1,
      align_to = "panel",
      clip = TRUE
    )
}


# ==============================================================================
# 11. BUILD ONLY THE PANELS THAT ARE AVAILABLE
# ==============================================================================

plot_list <- lapply(
  available_sites,
  function(site_name) {
    plot_pca_site(
      site_name = site_name,
      n_residues = 8,
      inset_width = 0.34,
      inset_height = 0.34
    )
  }
)

names(plot_list) <- available_sites


# ==============================================================================
# 12. COMBINE PANELS + SHARED LEGEND
# ==============================================================================

pca_figure <- patchwork::wrap_plots(
  plot_list,
  nrow = 1,
  guides = "collect"
) &
  theme(
    legend.position = "bottom",
    legend.title = element_text(face = "plain"),
    legend.text = element_text(face = "plain")
  )

print(pca_figure)


# ==============================================================================
# 13. SAVE FIGURE
# ==============================================================================

n_sites <- length(available_sites)

figure_width <- max(
  5.4,
  5.1 * n_sites
)

figure_height <- 6.2

site_suffix <- paste(
  available_sites,
  collapse = "_"
)

png_file <- file.path(
  output_dir,
  paste0(
    "PCA_interaction_fingerprints_",
    site_suffix,
    ".png"
  )
)

tiff_file <- file.path(
  output_dir,
  paste0(
    "PCA_interaction_fingerprints_",
    site_suffix,
    ".tiff"
  )
)

ggsave(
  filename = png_file,
  plot = pca_figure,
  width = figure_width,
  height = figure_height,
  units = "in",
  dpi = 400,
  bg = "white"
)

ggsave(
  filename = tiff_file,
  plot = pca_figure,
  width = figure_width,
  height = figure_height,
  units = "in",
  dpi = 600,
  compression = "lzw",
  bg = "white"
)


# ==============================================================================
# 14. REPORT
# ==============================================================================

cat("\n============================================================\n")
cat("PCA FIGURE GENERATION COMPLETED\n")
cat("============================================================\n")

cat("\nWorkbook:\n")
cat(input_file, "\n")

cat("\nBinding site(s) plotted:\n")
cat(paste(available_sites, collapse = ", "), "\n")

cat("\nCompound(s) plotted:\n")
cat(paste(observed_compounds, collapse = ", "), "\n")

cat("\nPNG:\n")
cat(png_file, "\n")

cat("\nTIFF:\n")
cat(tiff_file, "\n")

cat("\nColour palette:\n")
for (compound_name in observed_compounds) {
  cat(
    compound_name,
    " = ",
    compound_colors[[compound_name]],
    "\n",
    sep = ""
  )
}

cat("\n============================================================\n")
